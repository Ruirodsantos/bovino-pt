---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
const ph = (s: string) => `${base}lab/cortes-fotos/${s}.jpg`;
// Fotografias reais (Wikimedia Commons), só redimensionadas. Autores e licenças: docs/CORTES_FOTOS_FONTES.md
const rows = [
  { regiao: "Região costal", pecas: [{ nome: "Lombo alto", nota: "costeleta" }], cortes: [
    { nome: "Costeletão", img: "costeletao", pos: "50% 50%", credito: "Xemenendura · CC BY-SA 3.0", validar: true },
    { nome: "Tomahawk", img: "tomahawk", pos: "55% 50%", credito: "Kolforn · CC BY-SA 4.0" },
    { nome: "Entrecôte", img: "entrecote", pos: "50% 45%", credito: "Kolforn · CC BY-SA 4.0" } ] },
  { regiao: "Região lombar", pecas: [{ nome: "Lombo baixo" }, { nome: "Vazia", validar: true }], cortes: [
    { nome: "T-bone", img: "t-bone", pos: "50% 40%", credito: "MCB · CC BY-SA 2.5" },
    { nome: "Lombo", img: "lombo", pos: "50% 50%", credito: "Kintaro · CC BY-SA 3.0" },
    { nome: "Bife da vazia", img: "vazia", pos: "50% 50%", credito: "Bortz60 · CC BY-SA 3.0", validar: true } ] },
  { regiao: "Região da alcatra", pecas: [{ nome: "Alcatra" }], cortes: [
    { nome: "Picanha", img: "picanha", pos: "50% 50%", credito: "Domínio público" } ] },
];
---
<Base title="Demonstração · Do animal ao corte" description="Demonstração interna: região anatómica, desmancha portuguesa e corte comercial." noindex>
  <main class="cf" id="cf">
    <header><span class="eyebrow">Demonstração · primeira versão</span><h1>Do animal ao corte</h1></header>
    <div class="hd" aria-hidden="true"><span>Região anatómica</span><i></i><span>Desmancha portuguesa</span><i></i><span>Corte comercial</span></div>
    {rows.map((r) => (
      <section class="row">
        <div class="c1"><h2>{r.regiao}</h2></div>
        <div class="arrow" aria-hidden="true"></div>
        <div class="c2">{r.pecas.map((p) => <p>{p.nome}{p.nota && <small> · {p.nota}</small>}{p.validar && <em>a validar</em>}</p>)}</div>
        <div class="arrow" aria-hidden="true"></div>
        <ul class="c3">{r.cortes.map((c) => (
          <li><figure><img src={ph(c.img)} alt={`Fotografia real de ${c.nome}`} style={`object-position:${c.pos}`} loading="lazy" decoding="async" /><figcaption><strong>{c.nome}</strong>{c.validar && <em>a validar</em>}<small>{c.credito}</small></figcaption></figure></li>
        ))}</ul>
      </section>
    ))}
    <p class="foot">Fotografias reais, sem edição (apenas redimensionadas), da Wikimedia Commons. Os nomes e as correspondências assinaladas «a validar» dependem de confirmação com um talhante.</p>
  </main>
</Base>
<style is:global>
  .cf { width: min(1180px, 100% - 40px); margin: 0 auto; padding: 56px 0 72px; }
  .cf h1 { margin: .2em 0 1.2em; font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .cf .hd, .cf .row { display: grid; grid-template-columns: 150px 36px minmax(150px, 190px) 36px 1fr; align-items: center; gap: 0 12px; }
  .cf .hd { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--green); padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .cf .hd i, .cf .arrow { height: 1px; background: var(--ink, #242824); opacity: .35; position: relative; }
  .cf .hd i::after, .cf .arrow::after { content: ""; position: absolute; right: 0; top: -3px; width: 7px; height: 7px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); opacity: .8; }
  .cf .row { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .cf h2 { font-size: 1.25rem; margin: 0; }
  .cf .c2 p { margin: 0 0 10px; font-size: 1.02rem; } .cf .c2 small { color: var(--muted); }
  .cf em { display: inline-block; margin-left: 8px; font-style: normal; font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; color: #6b5517; background: #f3ead2; border-radius: 99px; padding: 2px 8px; vertical-align: middle; }
  .cf .c3 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cf figure { margin: 0; }
  .cf img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; background: var(--ivory-2); }
  .cf figcaption { padding-top: 8px; display: grid; gap: 3px; font-size: .95rem; justify-items: start; }
  .cf figcaption em { margin-left: 0; }
  .cf figcaption small { font-size: .68rem; color: var(--muted); }
  .cf .foot { margin: 22px 0 0; font-size: .8rem; color: var(--muted); max-width: 46rem; }
  @media (max-width: 860px) {
    .cf .hd { display: none; }
    .cf .row { grid-template-columns: 1fr; gap: 10px; }
    .cf .arrow { width: 1px; height: 18px; margin-left: 4px; } .cf .arrow::after { right: -3px; top: auto; bottom: 0; transform: rotate(135deg); }
    .cf .c3 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
</style>
