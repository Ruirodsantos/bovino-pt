---
import Base from "../../layouts/Base.astro";
import StatCard from "../../components/StatCard.astro";
import { summary } from "../../lib/data";
const s = summary();
const pick = ["pt_es_live_eur", "pt_es_live_heads", "pt_beef_imports_es"].map((id) => s.stats.find((x) => x.id === id)).filter(Boolean);
const base = import.meta.env.BASE_URL;
const questions = [
  ["Quantos bovinos vivos Portugal exporta para Espanha?", "parcial", "Em valor: sim, oficial e completo. Em cabeças: apenas um mínimo, porque nem todas as categorias trazem contagem."],
  ["Como evoluiu nos últimos 20 anos?", "sim", "Série mensal desde 2005 (valor) e desde 2012 por categoria."],
  ["Que categorias de animais são exportadas?", "sim", "Categorias da Nomenclatura Combinada: para abate, recria/engorda, vitelos e reprodutores de raça pura."],
  ["Quanta carne de bovino Portugal compra e vende a Espanha?", "sim", "Comércio mensal de carne fresca, refrigerada e congelada."],
  ["Como se comparam os preços ao produtor nos dois países?", "em curso", "A aguardar a verificação das condições de reutilização das cotações (SIMA/GPP, MAPA, Comissão Europeia)."],
  ["Quanto valor fica em Portugal?", "em curso", "Requer dados de abate, transformação e preços. A metodologia será revista antes de publicar."],
  ["Que raças estão envolvidas?", "em aberto", "As estatísticas de comércio não identificam a raça. Será preciso investigar outras fontes."],
];
---
<Base title="Portugal ↔ Espanha" description="Observatório do comércio de bovinos entre Portugal e Espanha: animais vivos, carne, preços e quem ganha com isso.">
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">Investigação nº 1 · Observatório do Bovino Português</span>
    <h1>Portugal cria, Espanha compra: quem ganha?</h1>
    <p class="lede">Uma investigação independente, com dados oficiais. Não partimos do princípio de que a compra espanhola é boa ou má para Portugal: medimos o que se pode medir e mostramos o que ainda não se sabe.</p>
    <div class="grid cols-3" style="margin-top:32px">{pick.map((st) => <StatCard stat={st!} />)}</div>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>Animais vivos: o que atravessa a fronteira</h2>
    <div class="card">
      <div class="toggle" role="group" aria-label="Medida"><button data-mode="eur" aria-pressed="true">Valor (€)</button><button data-mode="heads" aria-pressed="false">Cabeças</button></div>
      <div class="chart tall" data-chart="live-trade" data-dataset="trade_live_bovine_pt_es" data-mode="eur" role="img" aria-label="Exportações anuais de bovinos vivos de Portugal para Espanha por categoria"></div>
    </div>
    <p class="note">Exportações declaradas por Portugal (Eurostat Comext). Animais vivos (NC 0102) e carne (NC 0201/0202) são produtos diferentes e nunca são somados.</p>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>Carne: o caminho inverso</h2>
    <div class="card"><div class="chart" data-chart="beef-balance" data-dataset="trade_beef_pt_es" role="img" aria-label="Comércio de carne de bovino entre Portugal e Espanha"></div></div>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>As perguntas da investigação</h2>
    <p>Em que ponto estamos em cada pergunta:</p>
    <div class="qs">
      {questions.map(([q, st, note]) => (
        <div class="q card"><span class:list={["chip", st === "sim" ? "ok" : "wait"]}>{st === "sim" ? "Respondida com dados" : st === "parcial" ? "Resposta parcial" : st === "em curso" ? "Em curso" : "Em aberto"}</span><h3>{q}</h3><p>{note}</p></div>
      ))}
    </div>
    <p><a href={`${base}metodologia/`}>Como trabalhamos →</a></p>
  </div></section>
</Base>
<script>import "../../scripts/charts.ts";</script>
<style>
  .note { font-size: .85rem; color: var(--muted); margin-top: 10px; }
  .qs { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .q h3 { margin: 12px 0 6px; } .q p { color: var(--muted); font-size: .95rem; margin: 0; }
</style>
