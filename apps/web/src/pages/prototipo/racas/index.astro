---
import Proto from "../../../layouts/Proto.astro";
import Img from "../../../components/proto/Img.astro";
import { breeds, cardPhoto, REGIONS, REGION_LABELS } from "../../../lib/data";
import { ORDEM, TERRA, FRASE } from "../../../lib/proto";
const b = import.meta.env.BASE_URL;
const all = breeds();
const labels = REGION_LABELS("pt");
const tiles = ORDEM.map(([slug, size]) => {
  const br = all.find((x) => x.slug === slug)!;
  return { slug, size, name: br.official_name, photo: cardPhoto(slug), regions: REGIONS[slug] ?? [] };
});
const gaps = tiles.filter((t) => !t.photo || t.photo.kind !== "raça");
---
<Proto title="As raças">
  <section class="ghead"><div class="wrap">
    <span class="eyebrow">15 raças autóctones</span>
    <h1 style="font-size:clamp(3rem,8vw,6.5rem);margin:.15em 0 .3em">As raças</h1>
    <p class="lead">Escolha uma paisagem e siga a raça que a habita.</p>
    <div class="filters" role="group" aria-label="Filtrar por região">
      <button aria-pressed="true" data-r="">Todas</button>
      {Object.entries(labels).map(([k, v]) => <button aria-pressed="false" data-r={k}>{v}</button>)}
    </div>
  </div></section>
  <section class="wrap" style="padding-bottom:var(--s5)">
    <div class="mosaic">
      {tiles.map((t) => (
        <a class:list={["tile", t.size, !t.photo && "nophoto"]} id={t.slug} data-regions={t.regions.join(" ")} href={t.slug === "ramo-grande" ? `${b}prototipo/racas/ramo-grande/` : `${b}racas/${t.slug}/`}>
          {t.photo && <Img id={t.photo.id} sizes="(max-width:820px) 100vw, 60vw" />}
          {t.photo && t.photo.kind !== "raça" && <span class="gap">Paisagem · foto da raça por obter</span>}
          {!t.photo && <span class="gap">Foto da raça por obter</span>}
          <div class="t"><span class="r">{TERRA[t.slug]}</span><h3>{t.name}</h3><p class="s">{FRASE[t.slug]}</p></div>
        </a>
      ))}
    </div>
    <p class="srcs" style="margin-top:var(--s4);color:var(--muted);font-size:.88rem;max-width:60ch">
      {gaps.length} das 15 raças ainda não têm fotografia própria autorizada: {gaps.map((g) => g.name).join(", ")}. Nesses casos mostra-se uma paisagem do território, claramente assinalada, nunca uma fotografia de outra raça. As páginas das raças que não são o Ramo Grande abrem ainda no site atual.
    </p>
  </section>
  <script>
    const btns = [...document.querySelectorAll<HTMLButtonElement>(".filters button")];
    btns.forEach((bt) => bt.addEventListener("click", () => {
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === bt)));
      const r = bt.dataset.r;
      document.querySelectorAll<HTMLElement>(".tile").forEach((t) => { t.hidden = !!r && !(t.dataset.regions ?? "").split(" ").includes(r); });
    }));
  </script>
</Proto>
