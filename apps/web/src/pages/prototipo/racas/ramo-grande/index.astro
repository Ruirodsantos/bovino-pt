---
import fs from "node:fs";
import path from "node:path";
import Proto from "../../../../layouts/Proto.astro";
import Img from "../../../../components/proto/Img.astro";
import credits from "../../../../data/images.json";
import { getEntry } from "astro:content";
const b = import.meta.env.BASE_URL;
const ficha = (await getEntry("fichas", "ramo-grande"))!.data;
const sec = Object.fromEntries(ficha.sections.map((s) => [s.id, s]));
const heroC = (credits as any)["terceira"], bovC = (credits as any)["ramo-grande-feira"];
// Mapa esquemático dos Açores a partir da geometria NUTS já no repositório.
const geo = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/geo/nuts3_pt.json"), "utf-8"));
const polys: number[][][][] = geo.features.find((f: any) => f.properties.name === "PT200").geometry.coordinates;
const NAMES: [string, number, number][] = [["Santa Maria", 36.97, -25.08], ["São Miguel", 37.78, -25.5], ["Terceira", 38.72, -27.22], ["Graciosa", 39.05, -28.0], ["São Jorge", 38.65, -28.05], ["Pico", 38.47, -28.33], ["Faial", 38.58, -28.71], ["Flores", 39.45, -31.18], ["Corvo", 39.7, -31.11]];
const k = Math.cos(38.4 * Math.PI / 180);
const pts = polys.flatMap((p) => p[0]);
const minX = Math.min(...pts.map((p) => p[0])), maxX = Math.max(...pts.map((p) => p[0])), minY = Math.min(...pts.map((p) => p[1])), maxY = Math.max(...pts.map((p) => p[1]));
const sc = 880 / ((maxX - minX) * k), H = (maxY - minY) * sc + 40;
const X = (x: number) => 20 + (x - minX) * k * sc, Y = (y: number) => 20 + (maxY - y) * sc;
const islands = polys.map((p) => {
  const c = p[0]; const cx = c.reduce((a, q) => a + q[0], 0) / c.length, cy = c.reduce((a, q) => a + q[1], 0) / c.length;
  const n = NAMES.reduce((best, m) => (Math.hypot(m[2] - cx, m[1] - cy) < Math.hypot(best[2] - cx, best[1] - cy) ? m : best))[0];
  return { name: n, d: "M" + c.map((q) => `${X(q[0]).toFixed(1)},${Y(q[1]).toFixed(1)}`).join("L") + "Z", x: X(cx), y: Y(cy) };
});
const nav = [["historia", "História"], ["territorio", "Território"], ["caracteristicas", "Características"], ["criacao", "Criação"], ["carne", "Carne"], ["certificacao", "Certificação"], ["onde", "Onde encontrar"]];
const Blocks = (id: string) => sec[id].blocks;
---
<Proto title="Ramo Grande" description={ficha.intro} hero>
  <section class="hero rg">
    <img class="bg" src={`${b}img/terceira-lg.webp`} srcset={`${b}img/terceira-md.webp 900w, ${b}img/terceira-lg.webp 1800w`} sizes="100vw" alt="" width={heroC.width} height={heroC.height} fetchpriority="high" />
    <div class="wrap in rgrid">
      <div>
        <span class="tag"><a href={`${b}prototipo/racas/`} style="color:#fff;text-decoration:none">← As raças</a> · Raça autóctone</span>
        <h1 style="text-transform:uppercase;letter-spacing:.02em">Ramo Grande</h1>
        <p class="sub">A raça autóctone dos Açores</p>
        <p class="lead" style="color:#fff;max-width:34em">{ficha.intro}</p>
        <dl class="facts4">{ficha.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
      </div>
      <figure class="rgfig">
        <div class="frame" style="aspect-ratio:4/3"><Img id="ramo-grande-feira" sizes="(max-width:900px) 100vw, 520px" eager credit /></div>
        <figcaption><span class="gap">Fotografia provisória da raça</span> Única fotografia livre confirmada como Ramo Grande; procura-se uma melhor, em pastoreio. Fundo: paisagem da Terceira ({heroC.author}, {heroC.license}).</figcaption>
      </figure>
    </div>
  </section>

  <div class="subnav" id="subnav"><div class="wrap" role="navigation" aria-label="Neste tema">{nav.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}</div></div>

  <section class="sec" id="historia"><div class="wrap split">
    <div class="rv"><span class="eyebrow">História</span><h2 style="margin:.2em 0 .5em">Uma raça nascida da ilha.</h2>
      <p class="lead">{sec.historia.summary}</p>
      <ol class="timeline" aria-label="Datas-chave">
        <li><b>Séc. XV</b> Povoamento: chegam bovinos de várias regiões do continente.</li>
        <li><b>1943</b> Estudo citado no caderno de especificações sobre as raças de origem.</li>
        <li><b>1996</b> Criação do livro genealógico.</li>
      </ol>
    </div>
    <div class="rv">{Blocks("historia").slice(0, 1).map((bl) => <details class="dive" open><summary>{bl.title}</summary><div class="body">{bl.paras?.map((p) => <p>{p}</p>)}</div></details>)}
      <details class="dive"><summary>Descobrir a história completa</summary><div class="body">
        {Blocks("historia").slice(1).map((bl) => <><h3 style="font-size:1.35rem;margin:1em 0 .3em">{bl.title}{bl.status && <span class="status-pill">em investigação</span>}</h3>{bl.paras?.map((p) => <p>{p}</p>)}{bl.sources && <p class="srcs">Fontes: {bl.sources.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < bl.sources!.length - 1 ? " · " : ""}</>)}</p>}</>)}
      </div></details>
    </div>
  </div></section>

  <section class="sec soft" id="territorio"><div class="wrap split">
    <div class="rv"><span class="eyebrow">Território</span><h2 style="margin:.2em 0 .5em">Nove ilhas. Uma só área de produção.</h2>
      <p class="lead">{sec.territorio.summary}</p>
      <ul class="legend"><li><i class="k solar"></i> Solar da raça: Terceira</li><li><i class="k area"></i> Área geográfica da DOP: as nove ilhas do arquipélago, segundo o caderno de especificações</li></ul>
      {Blocks("territorio").map((bl) => <details class="dive"><summary>{bl.title}</summary><div class="body">{bl.paras?.map((p) => <p>{p}</p>)}{bl.sources && <p class="srcs">Fontes: {bl.sources.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < bl.sources!.length - 1 ? " · " : ""}</>)}</p>}</div></details>)}
    </div>
    <div class="mapbox rv">
      <svg viewBox={`0 0 920 ${H.toFixed(0)}`} role="img" aria-label="Mapa esquemático dos Açores com a ilha Terceira destacada">
        {islands.map((i) => <g><path class:list={["isl", i.name === "Terceira" && "solar"]} d={i.d} fill={i.name === "Terceira" ? "#183C32" : "#7FA07F"} stroke="#fff" stroke-width="1.2" stroke-linejoin="round"><title>{i.name}</title></path><text class="lbl" x={i.x} y={i.y + (i.name === "Terceira" ? 26 : 22)} text-anchor="middle" style="font-size:14px">{i.name}</text></g>)}
      </svg>
      <p class="srcs" style="margin:.6em 0 0">Mapa esquemático, geometria generalizada (Eurostat/GISCO, © EuroGeographics). Posição das ilhas fora de escala real entre grupos.</p>
    </div>
  </div></section>

  <section class="sec" id="caracteristicas"><div class="wrap split">
    <div class="frame rv" style="aspect-ratio:4/3"><Img id="ramo-grande-feira" sizes="(max-width:820px) 100vw, 600px" credit /></div>
    <div class="rv"><span class="eyebrow">Características</span><h2 style="margin:.2em 0 .5em">Vermelha, forte, de grande porte.</h2>
      <p class="lead">{sec.caracteristicas.summary}</p>
      {Blocks("caracteristicas").map((bl) => <details class="dive"><summary>{bl.title}{bl.status && <span class="status-pill">em investigação</span>}</summary><div class="body">{bl.paras?.map((p) => <p>{p}</p>)}{bl.sources && bl.sources.length > 0 && <p class="srcs">Fontes: {bl.sources.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < bl.sources!.length - 1 ? " · " : ""}</>)}</p>}</div></details>)}
      <p class="srcs">A fotografia mostra animais numa feira, com marcações de concurso; procura-se uma fotografia melhor da raça em pastoreio.</p>
    </div>
  </div></section>

  <section class="sec green" id="criacao"><div class="wrap">
    <span class="eyebrow">Criação</span><h2 style="margin:.2em 0 .5em;max-width:14em">Pastoreio quase todo o ano.</h2>
    <p class="lead">{sec.criacao.summary}</p>
    <div style="max-width:760px;margin-top:var(--s4)">{Blocks("criacao").map((bl) => <details class="dive"><summary>{bl.title}</summary><div class="body">{bl.paras?.map((p) => <p>{p}</p>)}{bl.sources && <p class="srcs">Fontes: {bl.sources.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < bl.sources!.length - 1 ? " · " : ""}</>)}</p>}</div></details>)}</div>
  </div></section>

  <section class="sec" id="carne"><div class="wrap split">
    <div class="rv"><span class="eyebrow">Carne</span><h2 style="margin:.2em 0 .5em">Vermelho-vivo e firme.</h2>
      <p class="lead">{sec.carne.summary}</p>
      {Blocks("carne").map((bl) => <details class="dive"><summary>{bl.title}{bl.status && <span class="status-pill">em investigação</span>}</summary><div class="body">{bl.paras?.map((p) => <p>{p}</p>)}
        {bl.table && <div class="tbl"><table><thead><tr>{bl.table.head.map((h) => <th>{h}</th>)}</tr></thead><tbody>{bl.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody></table></div>}
        {bl.sources && bl.sources.length > 0 && <p class="srcs">Fontes: {bl.sources.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < bl.sources!.length - 1 ? " · " : ""}</>)}</p>}</div></details>)}
    </div>
    <div class="frame rv" style="aspect-ratio:4/5"><Img id="carne-madeira" sizes="(max-width:820px) 100vw, 560px" credit /></div>
    <p class="srcs" style="grid-column:1/-1;margin:0">A fotografia de carne é ilustrativa (carne bovina em geral); não é carne Ramo Grande.</p>
  </div></section>

  <section class="sec soft" id="certificacao"><div class="wrap narrow" style="width:min(820px,100% - 40px)">
    <span class="eyebrow">Certificação</span><h2 style="margin:.2em 0 .5em">Carne Ramo Grande DOP.</h2>
    <p class="lead">{sec.certificacao.summary}</p>
    <div style="margin-top:var(--s4)">{Blocks("certificacao").map((bl) => <details class="dive"><summary>{bl.title}</summary><div class="body">{bl.paras?.map((p) => <p>{p}</p>)}{bl.list && <ul>{bl.list.map((l) => <li>{l}</li>)}</ul>}{bl.sources && <p class="srcs">Fontes: {bl.sources.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < bl.sources!.length - 1 ? " · " : ""}</>)}</p>}</div></details>)}</div>
  </div></section>

  <section class="sec" id="onde"><div class="wrap narrow">
    <span class="eyebrow">Onde encontrar</span><h2 style="margin:.2em 0 .5em">Em investigação.</h2>
    {Blocks("onde").map((bl) => <>{bl.paras?.map((p) => <p class="lead">{p}</p>)}</>)}
    <p>Para já, as fontes oficiais são o ponto de partida:</p>
    <p><a class="btn" href="https://tradicional.dgadr.gov.pt/pt/cat/carne/carne-de-bovino/1080-carne-ramo-grande-dop" rel="noopener">DGADR — Carne Ramo Grande DOP ↗</a></p>
    <p class="srcs">Não indicamos pontos de venda nem preços que não tenhamos verificado.</p>
  </div></section>

  <style>
    .rg::after{background:linear-gradient(180deg,rgba(14,42,32,.82),rgba(14,42,32,.9))!important}
    .rg .bg{filter:blur(3px) saturate(.8)}
    .rg{align-items:center}.rg .in{padding:130px 0 70px}
    .rgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(24px,4vw,64px);align-items:center}
    .rgrid h1{font-size:clamp(3rem,7vw,6rem)}
    .rgfig{margin:0;color:#fff}.rgfig figcaption{font-size:.82rem;margin-top:.8em;opacity:.92}.rgfig .gap{margin-right:.5em}
    @media(max-width:900px){.rgrid{grid-template-columns:1fr}}
    .timeline{list-style:none;padding:0;margin:var(--s3) 0 0;border-left:2px solid var(--gold)}
    .timeline li{padding:0 0 18px 20px;position:relative}
    .timeline li::before{content:"";position:absolute;left:-7px;top:.55em;width:12px;height:12px;border-radius:50%;background:var(--green-deep)}
    .timeline b{display:block;font:400 1.7rem var(--display);color:var(--green-deep)}
    .legend{list-style:none;padding:0;margin:0 0 var(--s3);font-size:.9rem}
    .legend .k{display:inline-block;width:14px;height:14px;border-radius:50%;margin-right:8px;vertical-align:-2px}
    .k.solar{background:#183C32}.k.area{background:#7FA07F}
  </style>
  <script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>("#subnav a")];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((l) => l.classList.toggle("on", l.getAttribute("href") === "#" + e.target.id)); }), { rootMargin: "-40% 0px -55% 0px" });
    links.forEach((l) => { const t = document.querySelector(l.getAttribute("href")!); if (t) io.observe(t); });
  </script>
</Proto>
