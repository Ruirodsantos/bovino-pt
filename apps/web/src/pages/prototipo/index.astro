---
import Proto from "../../layouts/Proto.astro";
import Img from "../../components/proto/Img.astro";
import credits from "../../data/images.json";
const b = import.meta.env.BASE_URL;
const hero = (credits as any)["mertolenga-tejo"];
const stages = [
  ["Nascimento", "Tudo começa na exploração, com o vitelo junto da mãe.", "Em várias raças os vitelos mamam durante meses antes do desmame."],
  ["Criação", "Meses ou anos no campo, conforme a raça e o sistema de produção.", "Cada raça tem o seu território e o seu ritmo."],
  ["Alimentação", "Pasto, forragens e, quando a erva não chega, complementos.", "Nas carnes certificadas, o caderno de especificações define o que o animal pode comer."],
  ["Transporte", "O animal segue para o matadouro; há também animais vivos que seguem para engorda.", "Animais vivos e carne são dois negócios diferentes: um vende-se antes do abate, o outro depois."],
  ["Abate", "Feito em matadouro licenciado, sob controlo veterinário.", ""],
  ["Classificação", "A carcaça é classificada por conformação e estado de gordura.", "É a classificação europeia SEUROP, usada em Portugal."],
  ["Desmancha", "A carcaça é dividida em peças e cortes.", "Os cortes variam consoante o mercado e a tradição regional."],
  ["Distribuição", "Talho, grande distribuição, restauração ou venda direta.", "Cada carne certificada tem rotulagem própria."],
  ["Consumidor", "Chega à mesa — e, com rotulagem e rastreabilidade, é possível saber de onde vem.", ""],
];
---
<Proto title="Início" hero>
  <section class="hero">
    <img class="bg" src={`${b}img/mertolenga-tejo-lg.webp`} srcset={`${b}img/mertolenga-tejo-md.webp 900w, ${b}img/mertolenga-tejo-lg.webp 1800w`} sizes="100vw" alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" />
    <div class="wrap in">
      <span class="tag">Atlas do Bovino Português</span>
      <h1>15 raças.<br />Um património extraordinário.</h1>
      <a class="cue" href="#descobrir">Começar a descobrir <i aria-hidden="true">↓</i></a>
    </div>
    <p class="credit">{hero.caption} · Foto: <a href={hero.source_page} rel="noopener">{hero.author}</a> · {hero.license}</p>
  </section>

  <section class="band" id="descobrir" aria-label="Descobrir Portugal">
    <Img id="montalegre" class="px" sizes="100vw" pos="50% 40%" />
    <p class="q rv">Do Minho aos Açores, raças que só existem aqui.</p>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="rv" style="max-width:34rem"><span class="eyebrow">Conhecer as raças</span><h2 style="margin:.2em 0 .4em">Cada raça, uma paisagem.</h2></div>
    </div>
    <div class="strip rv" role="list" aria-label="Algumas raças">
      {[["mirandesa", "miranda-douro"], ["barrosa", "barrosa"], ["maronesa", "maronesa-alvao"], ["cachena", "cachena"], ["alentejana", "alentejana-silves"], ["mertolenga", "mertolenga-tejo"]].map(([slug, img]) => (
        <a role="listitem" href={`${b}prototipo/racas/${slug === "ramo-grande" ? "ramo-grande/" : ""}#${slug}`}>
          <div class="frame"><Img id={img} sizes="360px" /></div>
          <h3 style="text-transform:capitalize">{slug}</h3>
        </a>
      ))}
    </div>
    <div class="wrap"><a class="btn rv" href={`${b}prototipo/racas/`}>Ver as 15 raças →</a></div>
  </section>

  <section class="band" aria-label="A ligação à terra">
    <Img id="tourem-manada" class="px" sizes="100vw" pos="50% 55%" />
    <p class="q rv">A raça e a terra moldaram-se uma à outra.</p>
  </section>

  <section class="sec green">
    <div class="wrap split">
      <div class="rv"><span class="eyebrow">A carne portuguesa</span><h2 style="margin:.2em 0 .5em">Do campo ao talho, com nome e origem.</h2>
        <p class="lead">Cortes, qualidade, maturação e as carnes com denominação de origem.</p>
        <a class="btn ghost" href={`${b}carne/`}>Explorar a carne →</a></div>
      <div class="frame rv" style="aspect-ratio:4/3"><Img id="carne-cortes" sizes="(max-width:820px) 100vw, 600px" credit /></div>
    </div>
  </section>

  <section class="sec soft" id="percurso">
    <div class="wrap">
      <span class="eyebrow">Da pastagem ao prato</span>
      <h2 style="margin:.2em 0 .3em">Nove passos. Clique em cada um.</h2>
      <div class="progress" aria-hidden="true"><i id="pg" style="width:11%"></i></div>
      <div class="route" role="tablist" aria-label="Etapas do percurso">
        {stages.map(([n], i) => <button role="tab" id={`t${i}`} aria-selected={i === 0} aria-controls="stage" tabindex={i === 0 ? 0 : -1}>{i + 1}. {n}</button>)}
      </div>
      <div class="stage" id="stage" role="tabpanel" aria-live="polite">
        <h3 id="sn">{stages[0][0]}</h3><p id="st" class="lead">{stages[0][1]}</p><p id="sx">{stages[0][2]}</p>
        <p class="note">Percurso geral e possível, não um caso documentado. Os casos reais, com fonte, estão na <a href={`${b}da-pastagem-ao-prato/`}>página completa</a>.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <span class="eyebrow">Continuar a descobrir</span>
      <h2 style="margin:.2em 0 var(--s4)">Para onde agora?</h2>
      <div class="doors">
        <a href={`${b}prototipo/racas/ramo-grande/`}><h3>Ramo Grande</h3><p>Uma raça dos Açores, com carne DOP.</p></a>
        <a href={`${b}aprender/`}><h3>Aprender</h3><p>Pequenos temas para perceber o mundo do bovino.</p></a>
        <a href={`${b}observatorio/`}><h3>Observatório</h3><p>Produção, abate, comércio e séries históricas.</p></a>
        <a href={`${b}prototipo/design-system/`}><h3>Design system</h3><p>As cores, letras e componentes deste protótipo.</p></a>
      </div>
    </div>
  </section>

  <script define:vars={{ stages }}>
    const tabs = [...document.querySelectorAll(".route button")];
    const set = (i) => {
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      document.getElementById("sn").textContent = stages[i][0];
      document.getElementById("st").textContent = stages[i][1];
      document.getElementById("sx").textContent = stages[i][2];
      document.getElementById("pg").style.width = ((i + 1) / stages.length * 100) + "%";
    };
    tabs.forEach((t, i) => { t.addEventListener("click", () => set(i)); t.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") { const n = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length; set(n); tabs[n].focus(); } }); });
  </script>
</Proto>
