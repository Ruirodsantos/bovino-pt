---
import DescobertaEntry from "../../views/DescobertaEntry.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() { return (await getCollection("descobertas")).map((d) => ({ params: { id: d.id }, props: { d } })); }
const { d } = Astro.props;
---
<DescobertaEntry lang="pt" d={d} />
