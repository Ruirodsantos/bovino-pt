---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { fmtDate } from "../../lib/data";
const base = import.meta.env.BASE_URL;
const all = (await getCollection("descobertas")).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Descobertas" description="Novas descobertas sobre o bovino português, verificadas e com fontes, todos os dias.">
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">Diário de investigação</span>
    <h1>Descobertas</h1>
    <p class="lede">Uma nova peça de conhecimento quase todos os dias: um número que mudou, um facto confirmado, uma pergunta respondida. Todas indicam as fontes.</p>
    <ol class="feed">
      {all.map((d) => (
        <li><a href={`${base}descobertas/${d.id}/`}>
          <span class="mono date">{fmtDate(d.data.date.toISOString().slice(0, 10))}</span>
          <h2>{d.data.title}</h2><p>{d.data.summary}</p>
          <span>{d.data.tags.map((t) => <span class="chip">{t}</span>)}</span>
        </a></li>
      ))}
    </ol>
  </div></section>
</Base>
<style>
  .feed { list-style: none; padding: 0; margin: 32px 0 0; border-left: 2px solid var(--line); }
  .feed li { padding: 0 0 32px 24px; position: relative; }
  .feed li::before { content: ""; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .feed a { color: var(--ink); text-decoration: none; display: block; }
  .feed h2 { font-size: 1.5rem; margin: 6px 0; }
  .feed p { color: var(--muted); }
  .date { color: var(--accent); font-size: .8rem; }
  .chip { margin-right: 6px; }
</style>
