---
import Base from "../../layouts/Base.astro";
import Photo from "../../components/Photo.astro";
import { getCollection } from "astro:content";
const all = (await getCollection("carne")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<Base title="A Carne" description="A carne de bovino por dentro: crua, maturada, cozinhada e servida ao nível dos melhores restaurantes.">
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">A Carne</span>
    <h1>Conhecer a carne como quem a serve</h1>
    <p class="lede">Do animal ao prato: o que se vê na carne crua, o que a maturação faz, o que acontece ao lume e como se serve. Escrito para quem quer chegar ao nível dos melhores restaurantes ibéricos.</p>
    <p class="muted">Todos os textos são originais e estão <strong>em revisão</strong>: são escritos a partir de ciência da carne de referência, e as fontes estão listadas no fim de cada página. Onde um valor ainda não foi conferido, o texto di-lo.</p>
    <div class="cards">
      {all.map((d) => (
        <a class="card c" href={`${base}carne/${d.id}/`}>
          {d.data.photo && <Photo id={d.data.photo} class="cph" sizes="(max-width: 700px) 100vw, 360px" caption={false} />}
          <div class="cb"><span class="eyebrow">{String(d.data.order).padStart(2, "0")}</span><h2>{d.data.title}</h2><p>{d.data.summary}</p></div>
        </a>
      ))}
    </div>
  </div></section>
</Base>
<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 18px; margin-top: 28px; }
  .c { padding: 0; overflow: hidden; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
  .c :global(.cph) { aspect-ratio: 16/10; }
  .c :global(.cph img) { height: 100%; }
  .cb { padding: 16px 18px 20px; }
  .cb h2 { font-size: 1.25rem; margin: 4px 0 8px; }
  .cb p { margin: 0; color: var(--muted); font-size: .92rem; }
</style>
