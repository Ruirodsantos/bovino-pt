---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import Photo from "../components/Photo.astro";
import { summary, breeds, fmtDate, hasDataset, photoFor } from "../lib/data";
import { getCollection } from "astro:content";
import credits from "../data/images.json";

const s = summary();
const hero = s.stats.find((x) => x.id === "pt_es_live_eur");
const others = s.stats.filter((x) => x !== hero);
const allBreeds = breeds();
const desc = (await getCollection("descobertas")).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const base = import.meta.env.BASE_URL;
const run = s.last_run;
const heroPhoto = (credits as any)["hero-alentejo"];
---
<Base title="Início">
  <section class="hero" style={heroPhoto ? `--bg:url(${base}img/hero-alentejo-lg.webp)` : ""}>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="eyebrow light">Observatório independente · dados oficiais · atualizado todos os dias</span>
        <h1>Portugal cria.<br />Espanha compra?</h1>
        <p class="lede light">As 15 raças, os números e o comércio do gado bovino português. Cada número indica a fonte e o período a que se refere.</p>
        <p class="actions"><a class="btn primary" href={`${base}observatorio/`}>Explorar o comércio Portugal ↔ Espanha</a> <a class="btn ghost" href={`${base}racas/`}>Conhecer as 15 raças</a></p>
      </div>
      {hero && <div class="hero-stat"><StatCard stat={hero} big /></div>}
    </div>
    {heroPhoto && <p class="hero-credit">{heroPhoto.caption} · Foto: <a href={heroPhoto.source_page}>{heroPhoto.author}</a> ({heroPhoto.license})</p>}
  </section>

  <section class="block numbers">
    <div class="wrap">
      <span class="eyebrow">Portugal em números</span>
      <h2>O essencial em 10 segundos</h2>
      <div class="grid cols-3">{others.map((st) => <StatCard stat={st} />)}</div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <span class="eyebrow">Mapa</span>
      <h2>De onde vem cada raça</h2>
      <p class="lede">O solar de cada raça autóctone, segundo o Catálogo Oficial da DGAV/CAP. Passe o cursor ou toque num ponto para ver a raça e quantos animais estão inscritos no livro genealógico.</p>
      <div class="map-grid">
        <div class="card map-card"><div class="chart map" data-chart="breeds-map" role="img" aria-label="Mapa de Portugal com a localização aproximada do solar de cada raça bovina autóctone"></div>
          <div id="map-chips" class="map-chips" aria-label="Escolher raça"></div>
          <p class="note">Localização aproximada do solar (não são explorações). Fronteiras © EuroGeographics. Açores e Madeira fora de escala geográfica.</p></div>
        <aside class="map-side" id="map-side" aria-live="polite">
          <Photo id="barrosa" sizes="(max-width: 860px) 100vw, 380px" />
          <p class="hint">Escolha uma raça no mapa.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <span class="eyebrow">As raças</span>
      <h2>As 15 raças autóctones</h2>
      <div class="breeds">
        {allBreeds.map((b, i) => {
          const p = photoFor(b.slug);
          return (
            <a class="breed reveal" href={`${base}racas/${b.slug}/`} style={`--i:${i}`}>
              <div class="thumb">
                {p ? <Photo id={p.id} sizes="(max-width: 640px) 50vw, 240px" caption={false} /> : <div class="nophoto">Fotografia em procura</div>}
                {p && <span class:list={["tag", p.kind]}>{p.kind === "raça" ? "A raça" : p.kind === "paisagem" ? "Paisagem" : "O solar"}</span>}
              </div>
              <span class="num mono">{String(i + 1).padStart(2, "0")}</span>
              <span class="name">{b.official_name}</span>
              {b.herd && <span class="herd">{b.herd.females.toLocaleString("pt-PT")} fêmeas inscritas ({b.herd.year})</span>}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="block split">
    <div class="wrap split-grid">
      <Photo id="tourem-manada" class="split-photo" sizes="(max-width: 860px) 100vw, 50vw" />
      <div>
        <span class="eyebrow">Observatório Portugal ↔ Espanha</span>
        <h2>Que bovinos vivos saem para Espanha — e quanto valem</h2>
        <p>Exportações de Portugal para Espanha por categoria da Nomenclatura Combinada. Os anos incompletos estão assinalados.</p>
      </div>
    </div>
    <div class="wrap">
      <div class="card">
        <div class="toggle" role="group" aria-label="Medida"><button data-mode="eur" aria-pressed="true">Valor (€)</button><button data-mode="heads" aria-pressed="false">Cabeças</button></div>
        <div class="chart tall" data-chart="live-trade" data-dataset="trade_live_bovine_pt_es" data-mode="eur" role="img" aria-label="Exportações anuais de bovinos vivos de Portugal para Espanha por categoria"></div>
        <p class="note">Fonte: Eurostat — Comext (DS-045409). As categorias detalhadas não cobrem todo o total oficial: a diferença aparece como "não discriminado" e as cabeças são um <strong>mínimo</strong>. <a href={`${base}metodologia/#categorias`}>Porquê?</a></p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap grid cols-2">
      <div>
        <span class="eyebrow">Efetivo</span>
        <h2>Quantos bovinos há em Portugal e em Espanha</h2>
        <div class="toggle" role="group" aria-label="Escala"><button data-mode="abs" aria-pressed="true">Cabeças</button><button data-mode="index" aria-pressed="false">Índice</button></div>
        <div class="chart" data-chart="population" data-dataset="bovine_population" role="img" aria-label="Evolução do efetivo bovino em Portugal e Espanha"></div>
      </div>
      <div>
        <span class="eyebrow">Carne de bovino</span>
        <h2>A carne faz o caminho inverso</h2>
        <div class="chart" data-chart="beef-balance" data-dataset="trade_beef_pt_es" role="img" aria-label="Comércio anual de carne de bovino entre Portugal e Espanha em toneladas"></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="band-photos">
      <Photo id="carne-cortes" sizes="33vw" caption={false} />
      <Photo id="outono-castanheiros" sizes="33vw" caption={false} />
      <Photo id="carne-madeira" sizes="33vw" caption={false} />
    </div>
    <div class="wrap band-text">
      <span class="eyebrow light">Da pastagem ao prato</span>
      <h2>Carne com nome de raça e de território</h2>
      <p class="lede light">Várias raças autóctones dão origem a carnes com Denominação de Origem Protegida, como a Carne Barrosã, que o catálogo da DGAV refere. A lista completa está a ser confirmada no registo oficial da União Europeia.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <span class="eyebrow">Descobertas</span>
      <h2>Acabado de verificar</h2>
      <div class="grid cols-3">
        {desc.map((d) => (
          <a class="card disc reveal" href={`${base}descobertas/${d.id}/`}>
            <span class="date mono">{fmtDate(d.data.date.toISOString().slice(0, 10))}</span>
            <h3>{d.data.title}</h3>
            <p>{d.data.summary}</p>
          </a>
        ))}
      </div>
      <p><a href={`${base}descobertas/`}>Todas as descobertas →</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <span class="eyebrow">Bastidores</span>
      <h2>Últimas atualizações automáticas</h2>
      {run && (
        <ul class="runs">
          {s.catalog.map((c) => (
            <li><span class:list={["chip", c.state === "ok" ? "ok" : "wait"]}>{c.state === "ok" ? "Atualizado" : "Em preparação"}</span> <strong>{c.title_pt}</strong>{c.last_period && <span class="muted"> · dados até {c.last_period} · {c.rows} valores</span>}</li>
          ))}
        </ul>
      )}
      {run && <p class="muted">Última verificação: {new Date(run.finished_at).toLocaleString("pt-PT", { timeZone: "Europe/Lisbon" })} (hora de Lisboa).</p>}
    </div>
  </section>
</Base>

<script>import "../scripts/charts.ts";</script>

<style>
  .hero { position: relative; min-height: min(92vh, 860px); display: flex; flex-direction: column; justify-content: flex-end; padding: 120px 0 28px; color: #fff;
    background: linear-gradient(180deg, rgba(15,12,10,.15) 0%, rgba(15,12,10,.35) 45%, rgba(15,12,10,.82) 100%), var(--bg, #2b241d) center 60% / cover no-repeat; margin-top: -61px; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: end; width: 100%; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .hero { min-height: auto; padding-top: 140px; } }
  .hero h1 { color: #fff; font-size: clamp(2.8rem, 8vw, 6rem); text-shadow: 0 2px 30px rgba(0,0,0,.35); }
  .light { color: rgba(255,255,255,.88) !important; }
  .eyebrow.light { color: #f3c9a8 !important; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .btn.primary { background: #fff; color: #1e1b18; border-color: #fff; }
  .btn.ghost { color: #fff; border-color: rgba(255,255,255,.7); }
  .hero-stat :global(.stat) { background: color-mix(in srgb, var(--surface) 94%, transparent); color: var(--ink); backdrop-filter: blur(6px); }
  .hero-credit { position: relative; margin: 18px auto 0; max-width: var(--max); padding: 0 16px; width: 100%; font-size: .72rem; color: rgba(255,255,255,.7); }
  .hero-credit a { color: inherit; }
  .numbers { border-top: 0; }
  .map-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; align-items: start; }
  @media (max-width: 860px) { .map-grid { grid-template-columns: 1fr; } }
  .chart.map { height: 640px; }
  .map-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px 0; }
  .map-chips :global(.chip-btn) { font: 600 .8rem var(--sans, "Public Sans"); padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .map-chips :global(.chip-btn[aria-pressed="true"]) { background: var(--accent); border-color: var(--accent); color: #fff; }
  @media (max-width: 560px) { .chart.map { height: 460px; } }
  .map-side { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 10px; }
  .map-side :global(.photo img) { border-radius: var(--radius); aspect-ratio: 4/3; }
  .hint { color: var(--muted); }
  .note { font-size: .8rem; color: var(--muted); margin-top: 10px; }
  .breeds { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr)); gap: 14px; }
  .breed { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); }
  .thumb { position: relative; aspect-ratio: 4/5; border-radius: var(--radius); overflow: hidden; background: var(--cork-soft); }
  .thumb :global(.photo) { position: absolute; inset: 0; }
  .thumb :global(.photo img) { width: 100%; height: 100%; }
  .thumb :global(img) { transition: transform .6s ease; }
  .breed:hover .thumb :global(img) { transform: scale(1.05); }
  .nophoto { display: grid; place-items: center; height: 100%; color: var(--muted); font-size: .85rem; text-align: center; padding: 12px; }
  .tag { position: absolute; left: 10px; top: 10px; font-size: .7rem; font-weight: 600; padding: 3px 8px; border-radius: 999px; background: rgba(0,0,0,.55); color: #fff; }
  .tag.raça { background: var(--pasture); }
  .num { color: var(--accent); font-size: .78rem; margin-top: 4px; }
  .name { font: 600 1.4rem/1.1 var(--display); }
  .herd { font-size: .82rem; color: var(--muted); }
  .split { border-top: 1px solid var(--line); }
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; margin-bottom: 24px; }
  .split-grid :global(.split-photo img) { border-radius: var(--radius); aspect-ratio: 16/10; }
  @media (max-width: 860px) { .split-grid { grid-template-columns: 1fr; } }
  .band { position: relative; color: #fff; background: #1b1714; }
  .band-photos { display: grid; grid-template-columns: repeat(3, 1fr); height: clamp(260px, 38vw, 460px); opacity: .55; }
  .band-photos :global(.photo), .band-photos :global(img) { height: 100%; }
  .band-text { position: absolute; inset: auto 0 0 0; padding-bottom: clamp(24px, 5vw, 56px); }
  .band h2 { color: #fff; }
  .disc { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 8px; }
  .disc .date { color: var(--accent); font-size: .78rem; }
  .disc p { color: var(--muted); font-size: .95rem; margin: 0; }
  .runs { list-style: none; padding: 0; display: grid; gap: 8px; }
  .muted { color: var(--muted); }
</style>
