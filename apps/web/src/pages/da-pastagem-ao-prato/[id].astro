---
import TemaPage from "../../views/TemaPage.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const all = (await getCollection("temas")).filter((t) => t.data.parent === "prato").sort((a, b) => a.data.order - b.data.order);
  return all.map((d, i) => ({ params: { id: d.id }, props: { d, prev: all[i - 1], next: all[i + 1] } }));
}
const { d, prev, next } = Astro.props;
---
<TemaPage lang="pt" d={d} prev={prev} next={next} />
