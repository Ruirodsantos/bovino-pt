---
import Base from "../../layouts/Base.astro";
import { summary, fmtDate } from "../../lib/data";
const s = summary();
const base = import.meta.env.BASE_URL;
---
<Base title="Dados" description="Todos os conjuntos de dados do Atlas do Bovino Português, com fonte, período e download.">
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">Nível 3 · Investigar</span>
    <h1>Os dados, todos</h1>
    <p class="lede">Cada conjunto vem de uma fonte oficial, é verificado automaticamente todos os dias e pode ser descarregado. As revisões feitas pelas fontes ficam registadas no <a href="https://github.com/Ruirodsantos/bovino-pt/tree/main/data/history">histórico</a>.</p>
    <div class="tbl" role="table">
      {s.catalog.map((c) => (
        <div class="card ds" id={c.id}>
          <div><h2>{c.title_pt}</h2><code>{c.id}</code></div>
          {c.state === "ok" ? (
            <dl>
              <div><dt>Fonte</dt><dd>Eurostat <span class="mono">{c.source_code}</span></dd></div>
              <div><dt>Período</dt><dd>{c.first_period} → {c.last_period}</dd></div>
              <div><dt>Valores</dt><dd>{c.rows}</dd></div>
              <div><dt>Publicado pela fonte</dt><dd>{fmtDate(c.publication_date)}</dd></div>
              <div><dt>Verificado</dt><dd>{fmtDate(c.retrieved_at?.slice(0, 10))}</dd></div>
              <div><dt>Descarregar</dt><dd><a href={`${base}data/${c.id}.json`}>JSON</a> · <a href={`https://github.com/Ruirodsantos/bovino-pt/blob/main/data/validated/${c.id}.csv`}>CSV</a></dd></div>
            </dl>
          ) : <p class="chip wait">Em preparação: a fonte ainda não respondeu com dados válidos</p>}
        </div>
      ))}
    </div>
  </div></section>
</Base>
<style>
  .tbl { display: grid; gap: 12px; margin-top: 24px; }
  .ds h2 { font-size: 1.3rem; margin: 0 0 4px; } .ds code { color: var(--muted); font-size: .8rem; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 16px 0 0; }
  dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); } dd { margin: 2px 0 0; font-weight: 600; }
</style>
