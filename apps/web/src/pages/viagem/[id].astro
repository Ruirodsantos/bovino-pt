---
import TemaPage from "../../views/TemaPage.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const temas = (await getCollection("temas")).sort((a, b) => a.data.order - b.data.order);
  return temas.map((d, i) => ({ params: { id: d.id }, props: { d, prev: temas[i - 1], next: temas[i + 1] } }));
}
const { d, prev, next } = Astro.props;
---
<TemaPage lang="pt" d={d} prev={prev} next={next} />
