---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Img from "../components/proto/Img.astro";
import { breeds, breedEn, cardPhoto, REGIONS, REGION_LABELS } from "../lib/data";
import { ORDEM, TERRA, FRASE, FRASE_EN } from "../lib/proto";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const all = breeds();
const labels = REGION_LABELS(lang);
const tiles = ORDEM.map(([slug, size]) => {
  const br = all.find((x) => x.slug === slug)!;
  return { slug, size, name: br.official_name, photo: cardPhoto(slug), regions: REGIONS[slug] ?? [] };
});
const gaps = tiles.filter((t) => !t.photo || t.photo.kind !== "raça");
---
<Base lang={lang} title={T("As raças", "The breeds")} description={T("As 15 raças bovinas autóctones de Portugal: fotografias, solar e história.", "Portugal's 15 native cattle breeds: photographs, homeland and history.")}>
  <section class="ghead"><div class="wrap">
    <span class="eyebrow">{T("15 raças autóctones", "15 native breeds")}</span>
    <h1 style="font-size:clamp(2.2rem,6vw,4.4rem);margin:.15em 0 .3em">{T("As raças", "The breeds")}</h1>
    <p class="lead">{T("Escolha uma paisagem e siga a raça que a habita.", "Pick a landscape and follow the breed that lives there.")}</p>
    <div class="filters" role="group" aria-label={T("Filtrar por região", "Filter by region")}>
      <button aria-pressed="true" data-r="">{T("Todas", "All")}</button>
      {Object.entries(labels).map(([k, v]) => <button aria-pressed="false" data-r={k}>{v}</button>)}
    </div>
  </div></section>
  <section class="wrap" style="padding-bottom:var(--s5)">
    <div class="mosaic">
      {tiles.map((t) => (
        <a class:list={["btile", t.size, !t.photo && "nophoto"]} id={t.slug} data-regions={t.regions.join(" ")} href={`${href(lang, "racas/")}${t.slug}/`}>
          {t.photo && <Img id={t.photo.id} sizes="(max-width:820px) 100vw, 60vw" lang={lang} />}
          {t.photo && t.photo.kind !== "raça" && <span class="gap">{T("Paisagem · foto da raça por obter", "Landscape · breed photo to be found")}</span>}
          {!t.photo && <span class="gap">{T("Foto da raça por obter", "Breed photo to be found")}</span>}
          <div class="t"><span class="r">{TERRA[t.slug]}</span><h3>{t.name}</h3><p class="s">{lang === "en" ? FRASE_EN[t.slug] : FRASE[t.slug]}</p></div>
        </a>
      ))}
    </div>
    <p class="srcs" style="margin-top:var(--s4);color:var(--muted);font-size:.88rem;max-width:62ch">
      {T(`${gaps.length} das 15 raças ainda não têm fotografia própria autorizada: ${gaps.map((g) => g.name).join(", ")}. Nesses casos mostra-se uma paisagem do território, claramente assinalada, nunca uma fotografia de outra raça.`, `${gaps.length} of the 15 breeds still have no authorised photograph of their own: ${gaps.map((g) => g.name).join(", ")}. In those cases a landscape of the territory is shown, clearly labelled, never a photograph of another breed.`)}
    </p>
  </section>
  <section class="block map" id="mapa">
    <div class="wrap">
      <span class="eyebrow">{T("Mapa", "Map")}</span>
      <h2>{T("De onde vem cada raça", "Where each breed comes from")}</h2>
      <p class="lede">{T("O solar de cada raça, segundo o Catálogo Oficial da DGAV/CAP. Toque num ponto para ver a raça.", "The homeland of each breed, according to the official DGAV/CAP Catalogue. Tap a point to see the breed.")}</p>
      <div class="map-grid">
        <div class="card map-card"><div class="chart map" data-chart="breeds-map" role="img" aria-label={T("Mapa de Portugal com a localização aproximada do solar de cada raça bovina autóctone", "Map of Portugal showing the approximate homeland of each native cattle breed")}></div>
          <div id="map-chips" class="map-chips" aria-label={T("Escolher raça", "Choose a breed")}></div>
          <p class="note">{T("Localização aproximada do solar (não são explorações). Fronteiras © EuroGeographics. Açores e Madeira fora de escala geográfica.", "Approximate location of each homeland (not farms). Boundaries © EuroGeographics. Azores and Madeira are not shown to geographic scale.")}</p></div>
        <aside class="map-side" id="map-side" aria-live="polite"><Photo id="barrosa" sizes="(max-width: 860px) 100vw, 380px" lang={lang} /><p class="hint">{T("Escolha uma raça no mapa.", "Choose a breed on the map.")}</p></aside>
      </div>
    </div>
  </section>
</Base>
<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>(".filters button")];
  btns.forEach((bt) => bt.addEventListener("click", () => {
    btns.forEach((x) => x.setAttribute("aria-pressed", String(x === bt)));
    const r = bt.dataset.r;
    document.querySelectorAll<HTMLElement>(".btile").forEach((t) => { t.hidden = !!r && !(t.dataset.regions ?? "").split(" ").includes(r); });
  }));
  const mapEl = document.querySelector("[data-chart='breeds-map']");
  if (mapEl) { const o = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { o.disconnect(); import("../scripts/charts.ts"); } }, { rootMargin: "400px" }); o.observe(mapEl); }
</script>
<style>
  .map-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; align-items: start; }
  @media (max-width: 860px) { .map-grid { grid-template-columns: 1fr; } }
  .chart.map { height: 640px; } @media (max-width: 560px) { .chart.map { height: 460px; } }
  .map-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px 0; }
  .map-chips :global(.chip-btn) { font: 500 .8rem var(--sans); padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .map-chips :global(.chip-btn[aria-pressed="true"]) { background: var(--accent); border-color: var(--accent); color: #fff; }
  .map-side { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 10px; }
  .map-side :global(.photo img) { border-radius: var(--radius); aspect-ratio: 4/3; }
  .hint, .note { color: var(--muted); font-size: .85rem; }
</style>
