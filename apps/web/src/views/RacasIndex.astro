---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { breeds, breedEn, num, photoFor } from "../lib/data";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const list = breeds();
const total = list.reduce((s, b) => s + (b.herd?.females ?? 0), 0);
---
<Base lang={lang} title={T("Raças", "Breeds")} description={T("As 15 raças bovinas autóctones de Portugal: solar, efetivo e fotografias.", "Portugal's 15 native cattle breeds: homeland, herd size and photographs.")}>
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">{T("Raças autóctones", "Native breeds")}</span>
    <h1>{T("As 15 raças bovinas de Portugal", "Portugal's 15 cattle breeds")}</h1>
    <p class="lede">{T("Reconhecidas oficialmente pela DGAV e pela CAP. Juntas, tinham", "Officially recognised by DGAV and CAP. Together, they had")} {num(total, lang)} {T("fêmeas inscritas em linha pura no livro genealógico em 2019. Fonte: Catálogo Oficial de Raças Autóctones Portuguesas.", "pure-line females registered in the herd book in 2019. Source: Official Catalogue of Portuguese Native Breeds (Catálogo Oficial de Raças Autóctones Portuguesas).")}</p>
    <div class="grid3">
      {list.map((b, i) => { const p = photoFor(b.slug); return (
        <a class="c" href={href(lang, `racas/${b.slug}/`)}>
          <div class:list={["img", !p && "empty"]}>{p ? <Photo id={p.id} sizes="(max-width: 640px) 100vw, 380px" caption={false} lang={lang} /> : <div class="none">{T("Fotografia em procura", "Photograph being sought")}</div>}
            {p && <span class="tag">{p.kind === "raça" ? T("A raça", "The breed") : p.kind === "paisagem" ? T("Paisagem", "Landscape") : T("O solar", "The homeland")}</span>}</div>
          <div class="meta"><span class="mono num">{String(i + 1).padStart(2, "0")}</span><h2>{b.official_name}</h2>
            <p>{lang === "en" ? (breedEn(b.slug).solar ?? b.solar) : b.solar}</p>
            {b.herd && <p class="h"><strong>{num(b.herd.females, lang)}</strong> {T("fêmeas", "females")} · <strong>{num(b.herd.breeders, lang)}</strong> {T("criadores", "breeders")} (2019)</p>}</div>
        </a>); })}
    </div>
  </div></section>
</Base>
<style>
  .grid3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 20px; margin-top: 32px; }
  .c { text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .c:hover { border-color: var(--cork); }
  .img { position: relative; aspect-ratio: 3/2; background: var(--cork-soft); overflow: hidden; }
  .img :global(.photo) { position: absolute; inset: 0; }
  .img :global(.photo), .img :global(img) { height: 100%; }
  .img.empty { aspect-ratio: auto; height: 44px; }
  .none { display: grid; place-items: center; height: 100%; color: var(--muted); font-size: .85rem; }
  .tag { position: absolute; left: 10px; top: 10px; font-size: .7rem; font-weight: 600; padding: 3px 8px; border-radius: 999px; background: rgba(0,0,0,.55); color: #fff; }
  .meta { padding: 16px 18px 20px; }
  .num { color: var(--accent); font-size: .8rem; }
  h2 { font-size: 1.6rem; margin: 4px 0 6px; }
  .meta p { margin: 0 0 6px; color: var(--muted); font-size: .92rem; }
  .h { color: var(--ink) !important; }
</style>
