---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import Photo from "../components/Photo.astro";
import { summary } from "../lib/data";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const s = summary();
const pick = ["pt_es_live_eur", "pt_es_live_heads", "pt_beef_imports_es"].map((id) => s.stats.find((x) => x.id === id)).filter(Boolean);
const questions = [
  [T("Quantos bovinos vivos Portugal exporta para Espanha?", "How many live cattle does Portugal export to Spain?", "¿Cuántos bovinos vivos exporta Portugal a España?", "Combien de bovins vivants le Portugal exporte-t-il vers l’Espagne ?"), "parcial", T("Em valor: sim, oficial e completo. Em cabeças: apenas um mínimo, porque nem todas as categorias trazem contagem.", "By value: yes, official and complete. By head: only a minimum, because not every category carries a count.", "En valor: sí, oficial y completo. En cabezas: solo un mínimo, porque no todas las categorías incluyen recuento.", "En valeur : oui, officiel et complet. En nombre de têtes : seulement un minimum, car toutes les catégories n’incluent pas de comptage.")],
  [T("Como evoluiu nos últimos 20 anos?", "How has it evolved over the last 20 years?", "¿Cómo ha evolucionado en los últimos 20 años?", "Comment cela a-t-il évolué ces 20 dernières années ?"), "sim", T("Série mensal desde 2005 (valor) e desde 2012 por categoria.", "Monthly series since 2005 (value) and since 2012 by category.", "Serie mensual desde 2005 (valor) y desde 2012 por categoría.", "Série mensuelle depuis 2005 (valeur) et depuis 2012 par catégorie.")],
  [T("Que categorias de animais são exportadas?", "Which categories of animals are exported?", "¿Qué categorías de animales se exportan?", "Quelles catégories d’animaux sont exportées ?"), "sim", T("Categorias da Nomenclatura Combinada: para abate, recria/engorda, vitelos e reprodutores de raça pura.", "Combined Nomenclature categories: for slaughter, rearing/fattening, calves and pure-bred breeding animals.", "Categorías de la Nomenclatura Combinada: para sacrificio, recría/cebo, terneros y reproductores de raza pura.", "Catégories de la nomenclature combinée : destinés à l’abattage, élevage/engraissement, veaux et reproducteurs de race pure.")],
  [T("Quanta carne de bovino Portugal compra e vende a Espanha?", "How much beef does Portugal buy from and sell to Spain?", "¿Cuánta carne de vacuno compra y vende Portugal a España?", "Quelle quantité de viande bovine le Portugal achète-t-il à l’Espagne et lui vend-il ?"), "sim", T("Comércio mensal de carne fresca, refrigerada e congelada.", "Monthly trade in fresh, chilled and frozen meat.", "Comercio mensual de carne fresca, refrigerada y congelada.", "Commerce mensuel de viande fraîche, réfrigérée et congelée.")],
  [T("Como se comparam os preços ao produtor nos dois países?", "How do producer prices compare in the two countries?", "¿Cómo se comparan los precios al productor en los dos países?", "Comment se comparent les prix à la production dans les deux pays ?"), "em curso", T("A aguardar a verificação das condições de reutilização das cotações (SIMA/GPP, MAPA, Comissão Europeia).", "Awaiting verification of the reuse terms for price quotations (SIMA/GPP, MAPA, European Commission).", "A la espera de verificar las condiciones de reutilización de las cotizaciones (SIMA/GPP, MAPA, Comisión Europea).", "En attente de la vérification des conditions de réutilisation des cotations (SIMA/GPP, MAPA, Commission européenne).")],
  [T("Quanto valor fica em Portugal?", "How much value stays in Portugal?", "¿Cuánto valor se queda en Portugal?", "Quelle part de la valeur reste au Portugal ?"), "em curso", T("Requer dados de abate, transformação e preços. A metodologia será revista antes de publicar.", "Requires slaughter, processing and price data. The methodology will be reviewed before publication.", "Requiere datos de sacrificio, transformación y precios. La metodología se revisará antes de publicarse.", "Nécessite des données sur l’abattage, la transformation et les prix. La méthodologie sera revue avant publication.")],
  [T("Que raças estão envolvidas?", "Which breeds are involved?", "¿Qué razas intervienen?", "Quelles races sont concernées ?"), "em aberto", T("As estatísticas de comércio não identificam a raça. Será preciso investigar outras fontes.", "Trade statistics do not identify the breed. Other sources will have to be investigated.", "Las estadísticas de comercio no identifican la raza. Habrá que investigar otras fuentes.", "Les statistiques commerciales n’identifient pas la race. Il faudra explorer d’autres sources.")],
];
const label = (st: string) => st === "sim" ? T("Respondida com dados", "Answered with data", "Respondida con datos", "Réponse fondée sur des données") : st === "parcial" ? T("Resposta parcial", "Partial answer", "Respuesta parcial", "Réponse partielle") : st === "em curso" ? T("Em curso", "In progress", "En curso", "En cours") : T("Em aberto", "Open", "Abierta", "Ouverte");
---
<Base lang={lang} title={T("Portugal ↔ Espanha", "Portugal ↔ Spain", "Portugal ↔ España", "Portugal ↔ Espagne")} description={T("Observatório do comércio de bovinos entre Portugal e Espanha: animais vivos, carne, preços e quem ganha com isso.", "Observatory of cattle trade between Portugal and Spain: live animals, meat, prices and who benefits.", "Observatorio del comercio de bovinos entre Portugal y España: animales vivos, carne, precios y quién sale ganando.", "Observatoire du commerce de bovins entre le Portugal et l’Espagne : animaux vivants, viande, prix et qui en profite.")}>
  <section class="photoband"><Photo id="montanha-cornos" sizes="100vw" lang={lang} /></section>
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">{T("Investigação nº 1 · Observatório do Bovino Português", "Investigation no. 1 · Portuguese Cattle Observatory", "Investigación n.º 1 · Observatorio del Bovino Portugués", "Enquête n° 1 · Observatoire du Bovin Portugais")}</span>
    <h1>{T("Portugal cria, Espanha compra: quem ganha?", "Portugal raises, Spain buys: who benefits?", "Portugal cría, España compra: ¿quién gana?", "Le Portugal élève, l’Espagne achète : qui y gagne ?")}</h1>
    <p class="lede">{T("Uma investigação independente, com dados oficiais. Não partimos do princípio de que a compra espanhola é boa ou má para Portugal: medimos o que se pode medir e mostramos o que ainda não se sabe.", "An independent investigation using official data. We do not assume that Spanish buying is good or bad for Portugal: we measure what can be measured and show what is not yet known.", "Una investigación independiente, con datos oficiales. No partimos de la idea de que la compra española sea buena o mala para Portugal: medimos lo que se puede medir y mostramos lo que aún no se sabe.", "Une enquête indépendante, fondée sur des données officielles. Nous ne partons pas du principe que les achats espagnols sont bons ou mauvais pour le Portugal : nous mesurons ce qui peut l’être et montrons ce qui n’est pas encore connu.")}</p>
    <div class="grid cols-3" style="margin-top:32px">{pick.map((st) => <StatCard stat={st!} lang={lang} />)}</div>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>{T("Animais vivos: o que atravessa a fronteira", "Live animals: what crosses the border", "Animales vivos: lo que cruza la frontera", "Animaux vivants : ce qui traverse la frontière")}</h2>
    <div class="card">
      <div class="toggle" role="group" aria-label={T("Medida", "Measure", "Medida", "Mesure")}><button data-mode="eur" aria-pressed="true">{T("Valor (€)", "Value (€)", "Valor (€)", "Valeur (€)")}</button><button data-mode="heads" aria-pressed="false">{T("Cabeças", "Head", "Cabezas", "Têtes")}</button></div>
      <div class="chart tall" data-chart="live-trade" data-dataset="trade_live_bovine_pt_es" data-mode="eur" role="img" aria-label={T("Exportações anuais de bovinos vivos de Portugal para Espanha por categoria", "Annual live cattle exports from Portugal to Spain by category", "Exportaciones anuales de bovinos vivos de Portugal a España por categoría", "Exportations annuelles de bovins vivants du Portugal vers l’Espagne, par catégorie")}></div>
    </div>
    <p class="note">{T("Exportações declaradas por Portugal (Eurostat Comext). Animais vivos (NC 0102) e carne (NC 0201/0202) são produtos diferentes e nunca são somados.", "Exports reported by Portugal (Eurostat Comext). Live animals (CN 0102) and meat (CN 0201/0202) are different products and are never added together.", "Exportaciones declaradas por Portugal (Eurostat Comext). Los animales vivos (NC 0102) y la carne (NC 0201/0202) son productos distintos y nunca se suman.", "Exportations déclarées par le Portugal (Eurostat Comext). Les animaux vivants (NC 0102) et la viande (NC 0201/0202) sont des produits différents et ne sont jamais additionnés.")}</p>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>{T("Carne: o caminho inverso", "Meat: the opposite direction", "Carne: el camino inverso", "Viande : le chemin inverse")}</h2>
    <div class="card"><div class="chart" data-chart="beef-balance" data-dataset="trade_beef_pt_es" role="img" aria-label={T("Comércio de carne de bovino entre Portugal e Espanha", "Beef trade between Portugal and Spain", "Comercio de carne de vacuno entre Portugal y España", "Commerce de viande bovine entre le Portugal et l’Espagne")}></div></div>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>{T("As perguntas da investigação", "The research questions", "Las preguntas de la investigación", "Les questions de l’enquête")}</h2>
    <p>{T("Em que ponto estamos em cada pergunta:", "Where we stand on each question:", "En qué punto estamos en cada pregunta:", "Où nous en sommes pour chaque question :")}</p>
    <div class="qs">
      {questions.map(([q, st, note]) => (
        <div class="q card"><span class:list={["chip", st === "sim" ? "ok" : "wait"]}>{label(st)}</span><h3>{q}</h3><p>{note}</p></div>
      ))}
    </div>
    <p><a href={href(lang, "metodologia/")}>{T("Como trabalhamos →", "How we work →", "Cómo trabajamos →", "Notre façon de travailler →")}</a></p>
  </div></section>
</Base>
<script>import "../scripts/charts.ts";</script>
<style>
  .photoband :global(img) { max-height: 70vh; }
  .photoband :global(figcaption) { max-width: var(--max); margin: 0 auto; padding: 6px 16px; }
  .note { font-size: .85rem; color: var(--muted); margin-top: 10px; }
  .qs { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .q h3 { margin: 12px 0 6px; } .q p { color: var(--muted); font-size: .95rem; margin: 0; }
</style>
