---
import Base from "../layouts/Base.astro";
import { coll } from "../lib/content";
import { fmtDate } from "../lib/data";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const all = (await coll("descobertas", lang)).sort((a: any, b: any) => +b.data.date - +a.data.date);
---
<Base lang={lang} title={T("Descobertas", "Discoveries", "Descubrimientos", "Découvertes")} description={T("Novas descobertas sobre o bovino português, verificadas e com fontes, todos os dias.", "New, verified and sourced discoveries about Portuguese cattle, every day.", "Nuevos descubrimientos sobre el bovino portugués, verificados y con fuentes, cada día.", "De nouvelles découvertes sur les bovins portugais, vérifiées et sourcées, chaque jour.")}>
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">{T("Diário de investigação", "Research journal", "Diario de investigación", "Journal de recherche")}</span>
    <h1>{T("Descobertas", "Discoveries", "Descubrimientos", "Découvertes")}</h1>
    <p class="lede">{T("Uma nova peça de conhecimento quase todos os dias: um número que mudou, um facto confirmado, uma pergunta respondida. Todas indicam as fontes.", "A new piece of knowledge almost every day: a number that changed, a confirmed fact, a question answered. All state their sources.", "Una nueva pieza de conocimiento casi todos los días: una cifra que cambió, un hecho confirmado, una pregunta respondida. Todas indican las fuentes.", "Un nouvel élément de savoir presque chaque jour : un chiffre qui a changé, un fait confirmé, une question résolue. Tous indiquent leurs sources.")}</p>
    <ol class="feed">
      {all.map((d) => (
        <li><a href={href(lang, `descobertas/${d.id}/`)}>
          <span class="mono date">{fmtDate(d.data.date.toISOString().slice(0, 10), lang)}</span>
          <h2>{d.data.title}</h2><p>{d.data.summary}</p>
          <span>{d.data.tags.map((t) => <span class="chip">{t}</span>)}</span>
        </a></li>
      ))}
    </ol>
  </div></section>
</Base>
<style>
  .feed { list-style: none; padding: 0; margin: 32px 0 0; border-left: 2px solid var(--line); }
  .feed li { padding: 0 0 32px 24px; position: relative; }
  .feed li::before { content: ""; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .feed a { color: var(--ink); text-decoration: none; display: block; }
  .feed h2 { font-size: 1.5rem; margin: 6px 0; }
  .feed p { color: var(--muted); }
  .date { color: var(--accent); font-size: .8rem; }
  .chip { margin-right: 6px; }
</style>
