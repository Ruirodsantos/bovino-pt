---
import Base from "../layouts/Base.astro";
import Img from "../components/proto/Img.astro";
import credits from "../data/images.json";
import { lf, href, licenseLabel, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const b = import.meta.env.BASE_URL;
const cr = (id: string) => {
  const c0 = (credits as Record<string, any>)[id];
  if (!c0) return "";
  const cap = lf(c0, "caption", lang);
  return `${cap} · ${T("Foto", "Photo", "Foto", "Photo")}: ${c0.author} · ${licenseLabel(lang, c0.license)}`;
};
const crUrl = (id: string) => (credits as Record<string, any>)[id]?.source_page;

// Fontes (cada número no texto tem uma destas fontes, com ano de referência)
const S = {
  ra2019: { l: T("INE — Recenseamento Agrícola 2019, resultados definitivos (publicação de 31.03.2021)", "Statistics Portugal (INE) — Agricultural Census 2019, final results (published 31.03.2021)", "INE — Recenso Agrario 2019, resultados definitivos (publicación de 31.03.2021)", "INE — Recensement agricole 2019, résultats définitifs (publication du 31.03.2021)"), u: "https://www.agroportal.pt/wp-content/uploads/2021/03/31RA2019.pdf", n: T("cópia integral da publicação do INE alojada pela Agroportal", "full copy of the INE publication hosted by Agroportal", "copia íntegra de la publicación del INE alojada por Agroportal", "copie intégrale de la publication de l’INE hébergée par Agroportal") },
  drem: { l: T("DREM — Recenseamento Agrícola 2019, Região Autónoma da Madeira (2022), que cita a média nacional de 64 anos", "DREM — Agricultural Census 2019, Madeira (2022), citing the national average of 64 years", "DREM — Recenso Agrario 2019, Región Autónoma de Madeira (2022), que cita la media nacional de 64 años", "DREM — Recensement agricole 2019, Région autonome de Madère (2022), qui cite la moyenne nationale de 64 ans"), u: "https://estatistica.madeira.gov.pt/download-now/economica/agricultura-floresta-e-pesca/recenseamento-agricola-pt/recenseamento-agricola-publicacoes-pt/send/361-estruturas-das-exploracoes-agricolas-publicacoes/14692-recenseamento-agricola-2019pdf.html" },
  cat: { l: T("DGAV/CAP — Catálogo Oficial das Raças Autóctones Portuguesas (livros genealógicos, 2019)", "DGAV/CAP — Official Catalogue of Portuguese Native Breeds (herd books, 2019)", "DGAV/CAP — Catálogo Oficial de las Razas Autóctonas Portuguesas (libros genealógicos, 2019)", "DGAV/CAP — Catalogue officiel des races autochtones portugaises (livres généalogiques, 2019)"), u: "https://www.dgav.pt/wp-content/uploads/2021/04/Catalogo-Oficial-Racas-Autoctones-Portuguesas.pdf" },
  dgadr: { l: T("DGADR — Produtos tradicionais com nome protegido: carne de bovino (consultado a 21.10.2026)", "DGADR — Traditional products with protected names: beef (consulted 21.10.2026)", "DGADR — Productos tradicionales con nombre protegido: carne de vacuno (consultado el 21.10.2026)", "DGADR — Produits traditionnels à nom protégé : viande bovine (consulté le 21.10.2026)"), u: "https://tradicional.dgadr.gov.pt/pt/cat/carne/carne-de-bovino" },
  gpp: { l: T("GPP — PEPAC, ficha da intervenção E.7.1 Apoio à Instalação de Jovens Agricultores", "GPP — CAP Strategic Plan, intervention sheet E.7.1 Support for the Setting-up of Young Farmers", "GPP — PEPAC, ficha de la intervención E.7.1 Apoyo a la instalación de jóvenes agricultores", "GPP — PEPAC (plan stratégique de la PAC), fiche d’intervention E.7.1 Aide à l’installation des jeunes agriculteurs"), u: "https://www.gpp.pt/images/PEPAC/Fichas_PEPAC/Intervencoes_PEPAC/E_7_1.pdf" },
  lsk: { l: T("Eurostat — ef_lsk_main, explorações com bovinos e número de bovinos, Portugal, 2005–2023 (atualizado a 17.06.2026)", "Eurostat — ef_lsk_main, holdings with cattle and number of cattle, Portugal, 2005–2023 (updated 17.06.2026)", "Eurostat — ef_lsk_main, explotaciones con bovinos y número de bovinos, Portugal, 2005–2023 (actualizado el 17.06.2026)", "Eurostat — ef_lsk_main, exploitations avec bovins et nombre de bovins, Portugal, 2005–2023 (mis à jour le 17.06.2026)"), u: "https://ec.europa.eu/eurostat/databrowser/view/ef_lsk_main/default/table" },
  mgr: { l: T("Eurostat — ef_m_farmang, explorações por idade do dirigente, Portugal e UE-27, 2010–2023 (atualizado a 17.06.2026)", "Eurostat — ef_m_farmang, farms by age of the manager, Portugal and EU-27, 2010–2023 (updated 17.06.2026)", "Eurostat — ef_m_farmang, explotaciones por edad del titular, Portugal y UE-27, 2010–2023 (actualizado el 17.06.2026)", "Eurostat — ef_m_farmang, exploitations par âge du chef d’exploitation, Portugal et UE-27, 2010–2023 (mis à jour le 17.06.2026)"), u: "https://ec.europa.eu/eurostat/databrowser/view/ef_m_farmang/default/table" },
  rot: { l: T("Regulamento (CE) n.º 1760/2000 — identificação e registo de bovinos e rotulagem da carne", "Regulation (EC) No 1760/2000 — identification and registration of cattle and beef labelling", "Reglamento (CE) n.º 1760/2000 — identificación y registro de bovinos y etiquetado de la carne", "Règlement (CE) n° 1760/2000 — identification et enregistrement des bovins et étiquetage de la viande"), u: `https://eur-lex.europa.eu/legal-content/${lang.toUpperCase()}/TXT/?uri=CELEX:32000R1760` },
};
const ordem = ["ra2019", "drem", "cat", "dgadr", "gpp", "rot", "lsk", "mgr"] as const;
const num = Object.fromEntries(ordem.map((k, i) => [k, i + 1])) as Record<(typeof ordem)[number], number>;

const vidaPt = [
  "Muito antes de o dia nascer, já há quem esteja a trabalhar.",
  "Não há fins de semana garantidos. Não há feriados para os animais. Não há dias em que a terra deixe de precisar de cuidados.",
  "Durante gerações, os criadores portugueses preservaram raças, paisagens e conhecimentos que não se aprendem nos livros.",
  "Mas muitos enfrentam hoje uma pergunta difícil: quem continuará este trabalho amanhã?",
];
const vidaByLang: Record<Lang, string[]> = {
  pt: vidaPt,
  en: [
    "Long before daybreak, someone is already at work.",
    "There are no guaranteed weekends. Animals don’t take public holidays. There is no day when the land stops needing care.",
    "For generations, Portuguese farmers have kept alive breeds, landscapes and knowledge that cannot be learned from books.",
    "But many now face a hard question: who will carry on this work tomorrow?",
  ],
  es: [
    "Mucho antes de que amanezca, ya hay quien está trabajando.",
    "No hay fines de semana garantizados. No hay festivos para los animales. No hay días en que la tierra deje de necesitar cuidados.",
    "Durante generaciones, los criadores portugueses han preservado razas, paisajes y conocimientos que no se aprenden en los libros.",
    "Pero hoy muchos se enfrentan a una pregunta difícil: ¿quién continuará este trabajo mañana?",
  ],
  fr: [
    "Bien avant le lever du jour, il y a déjà quelqu’un au travail.",
    "Il n’y a pas de week-ends garantis. Il n’y a pas de jours fériés pour les animaux. Il n’y a pas de jour où la terre cesse d’avoir besoin de soins.",
    "Depuis des générations, les éleveurs portugais ont préservé des races, des paysages et des savoirs qui ne s’apprennent pas dans les livres.",
    "Mais beaucoup sont aujourd’hui confrontés à une question difficile\u00a0: qui poursuivra ce travail demain\u00a0?",
  ],
};
const vida = vidaByLang[lang];

const quote = T("Há quem passe uma vida inteira a cuidar da terra. E quem cuida deles?", "Some people spend a whole lifetime caring for the land. And who cares for them?", "Hay quien pasa una vida entera cuidando la tierra. ¿Y quién cuida de ellos?", "Certains passent toute une vie à prendre soin de la terre. Et qui prend soin d’eux ?");
---
<Base lang={lang} overlay title={T("Os Guardiões da Terra", "Guardians of the Land", "Los Guardianes de la Tierra", "Les Gardiens de la Terre")} image={`${b}img/guardiao-ia-lg.webp`}
  description={T("Uma homenagem aos agricultores e criadores de bovinos de Portugal: o seu trabalho, as dificuldades que enfrentam e o que o país pode perder se esta atividade desaparecer.", "A tribute to Portugal's farmers and cattle breeders: their work, the difficulties they face and what the country could lose if this activity disappears.", "Un homenaje a los agricultores y criadores de bovinos de Portugal: su trabajo, las dificultades que afrontan y lo que el país podría perder si esta actividad desaparece.", "Un hommage aux agriculteurs et éleveurs de bovins du Portugal : leur travail, les difficultés auxquelles ils font face et ce que le pays pourrait perdre si cette activité disparaissait.")}>

  <!-- 1. Capa -->
  <header class="gt-cover">
    <img class="gt-cover-img" src={`${b}img/guardiao-ia-lg.webp`} srcset={`${b}img/guardiao-ia-sm.webp 480w, ${b}img/guardiao-ia-md.webp 900w, ${b}img/guardiao-ia-lg.webp 1536w`}
      sizes="(max-aspect-ratio: 3/2) 150vh, 100vw" width="1536" height="1024" fetchpriority="high"
      alt={T("Ilustração: pastor idoso de boné e casaco encerado, apoiado numa vara, olha para a câmara; atrás, vacas castanhas, um muro de pedra e serras", "Illustration: an elderly shepherd in a cap and waxed jacket leans on a staff and looks at the camera; behind him, brown cows, a stone wall and hills", "Ilustración: un pastor anciano con gorra y chaqueta encerada, apoyado en una vara, mira a la cámara; detrás, vacas marrones, un muro de piedra y sierras", "Illustration : un vieux berger en casquette et veste cirée, appuyé sur un bâton, regarde la caméra ; derrière lui, des vaches brunes, un mur de pierre et des montagnes")} />
    <div class="gt-cover-in">
      <h1 class="gt-kicker">{T("Os Guardiões da Terra", "Guardians of the Land", "Los Guardianes de la Tierra", "Les Gardiens de la Terre")}</h1>
      <p class="gt-quote">{lang === "fr" ? "«\u00a0" + quote + "\u00a0»" : "«" + quote + "»"}</p>
    </div>
  </header>

  <!-- 2. Uma vida inteira -->
  <section class="gt-vida" aria-labelledby="gt-vida-t">
    <div class="gt-narrow">
      <h2 id="gt-vida-t" class="gt-h rv">{T("Uma vida inteira", "A whole lifetime", "Una vida entera", "Toute une vie")}</h2>
      {vida.map((p, i) => <p class:list={["gt-line rv", i === vida.length - 1 && "gt-line-last"]} style={`transition-delay:${i * 90}ms`}>{p}</p>)}
      <p class="gt-fact rv">{T("Em 2019, os produtores agrícolas portugueses tinham, em média, ", "In 2019, Portuguese farmers were on average ", "En 2019, los productores agrícolas portugueses tenían, de media, ", "En 2019, les exploitants agricoles portugais avaient en moyenne ")}<strong>{T("64 anos", "64 years old", "64 años", "64 ans")}</strong>{T(". Quase dois terços do efetivo bovino eram explorados em regime extensivo.", ". Almost two thirds of the cattle herd was farmed extensively.", ". Casi dos tercios del censo bovino se explotaban en régimen extensivo.", ". Près de deux tiers du cheptel bovin étaient élevés de façon extensive.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 1", "Source 1", "Fuente 1", "Source 1")}>{num.ra2019}</a></p>
    </div>
  </section>

  <!-- 3. O peso de continuar -->
  <section class="gt-peso" aria-labelledby="gt-peso-t">
    <div class="gt-wrap gt-intro rv">
      <span class="eyebrow">{T("Cinco capítulos", "Five chapters", "Cinco capítulos", "Cinq chapitres")}</span>
      <h2 id="gt-peso-t" class="gt-h">{T("O peso de continuar", "The weight of carrying on", "El peso de continuar", "Le poids de continuer")}</h2>
      <p class="gt-lead">{T("Criar bovinos é um trabalho de longo prazo: uma vaca demora anos a dar o primeiro vitelo, e uma decisão tomada hoje só se vê nos animais daqui a muito tempo. Estas são as dificuldades que mais pesam.", "Raising cattle is long-term work: a cow takes years to produce her first calf, and a decision taken today only shows in the herd much later. These are the difficulties that weigh most.", "Criar bovinos es un trabajo a largo plazo: una vaca tarda años en dar su primer ternero, y una decisión tomada hoy solo se ve en los animales mucho más tarde. Estas son las dificultades que más pesan.", "Élever des bovins est un travail de longue haleine : une vache met des années à donner son premier veau, et une décision prise aujourd’hui ne se voit dans le troupeau que bien plus tard. Voici les difficultés qui pèsent le plus.")}</p>
    </div>

    <!-- 3.1 Custos -->
    <article class="gt-ch gt-ch-split">
      <figure class="gt-ch-fig rv"><Img id="outono-castanheiros" sizes="(max-width:860px) 100vw, 60vw" lang={lang} /><figcaption><a href={crUrl("outono-castanheiros")} rel="noopener">{cr("outono-castanheiros")}</a></figcaption></figure>
      <div class="gt-ch-txt rv">
        <span class="gt-num">01</span>
        <h3>{T("Custos de produção", "Production costs", "Costes de producción", "Coûts de production")}</h3>
        <p>{T("A maior parte do ano, os animais comem o que a terra dá. Mas quando o pasto não chega — no fim do verão ou no inverno —, é preciso comprar ou produzir feno, silagem, cereais e rações. É, em muitas explorações, a maior fatura.", "For most of the year the animals eat what the land provides. But when grass runs short — at the end of summer or in winter — hay, silage, cereals and feed must be bought or grown. On many farms that is the biggest bill.", "Gran parte del año los animales comen lo que da la tierra. Pero cuando el pasto no alcanza —a finales del verano o en invierno—, hay que comprar o producir heno, ensilado, cereales y piensos. En muchas explotaciones es la mayor factura.", "La majeure partie de l’année, les animaux mangent ce que la terre donne. Mais quand l’herbe vient à manquer — à la fin de l’été ou en hiver —, il faut acheter ou produire du foin, de l’ensilage, des céréales et des aliments. Dans beaucoup d’exploitations, c’est la plus grosse facture.")}</p>
        <p>{T("Somam-se o gasóleo dos tratores, a eletricidade, a água, as vedações, as máquinas, o veterinário e a manutenção de caminhos, abrigos e bebedouros. São custos que se pagam todos os meses, enquanto a venda de um vitelo acontece uma vez, ao fim de muitos meses de trabalho.", "Then come tractor diesel, electricity, water, fences, machinery, the vet, and upkeep of tracks, shelters and troughs. These costs are paid every month, while a calf is sold once, after many months of work.", "A ello se suman el gasóleo de los tractores, la electricidad, el agua, las vallas, la maquinaria, el veterinario y el mantenimiento de caminos, refugios y bebederos. Son costes que se pagan todos los meses, mientras que la venta de un ternero ocurre una vez, tras muchos meses de trabajo.", "À cela s’ajoutent le gazole des tracteurs, l’électricité, l’eau, les clôtures, les machines, le vétérinaire et l’entretien des chemins, des abris et des abreuvoirs. Ces coûts se paient tous les mois, alors qu’un veau ne se vend qu’une fois, après de longs mois de travail.")}</p>
        <p class="gt-tag">{T("Enquadramento editorial. Os índices oficiais de preços dos meios de produção serão acrescentados ao Observatório.", "Editorial framing. Official input price indices will be added to the Observatory.", "Marco editorial. Los índices oficiales de precios de los medios de producción se añadirán al Observatorio.", "Cadrage éditorial. Les indices officiels des prix des intrants seront ajoutés à l’Observatoire.")}</p>
      </div>
    </article>

    <!-- 3.2 Preço -->
    <article class="gt-ch gt-ch-band">
      <figure class="gt-band-fig rv"><Img id="acores-pico-estrada" sizes="100vw" lang={lang} pos="center 40%" /><figcaption><a href={crUrl("acores-pico-estrada")} rel="noopener">{cr("acores-pico-estrada")}</a></figcaption></figure>
      <div class="gt-wrap gt-band-txt">
        <div class="rv"><span class="gt-num">02</span><h3>{T("O preço de vender", "The price of selling", "El precio de vender", "Le prix de la vente")}</h3></div>
        <div class="gt-cols rv">
          <p>{T("O criador vende, em geral, um animal vivo. O consumidor compra um bife embalado. Entre os dois há transporte, abate, classificação, desmancha, frio, embalagem, distribuição, loja e impostos — e cada etapa tem custos reais.", "The farmer usually sells a live animal. The consumer buys a packed steak. In between come transport, slaughter, grading, cutting, cold storage, packing, distribution, the shop and taxes — and each step has real costs.", "El criador vende, en general, un animal vivo. El consumidor compra un filete envasado. Entre ambos hay transporte, sacrificio, clasificación, despiece, frío, envasado, distribución, tienda e impuestos, y cada etapa tiene costes reales.", "L’éleveur vend, en général, un animal vivant. Le consommateur achète un steak emballé. Entre les deux, il y a le transport, l’abattage, le classement, la découpe, le froid, l’emballage, la distribution, le magasin et les taxes — et chaque étape a des coûts réels.")}</p>
          <p>{T("Além disso, uma carcaça não é só lombo: tem partes muito procuradas e outras pouco valorizadas, e o preço do quilo no talho reflete esse equilíbrio. Por isso, comparar diretamente o preço pago ao produtor com o preço na prateleira não diz, só por si, quem fica com quê.", "And a carcass is not all sirloin: some parts are in high demand and others far less, and the price per kilo at the counter reflects that balance. So comparing the farmer's price directly with the shelf price does not, on its own, say who keeps what.", "Además, una canal no es solo solomillo: tiene partes muy demandadas y otras mucho menos valoradas, y el precio del kilo en la carnicería refleja ese equilibrio. Por eso, comparar directamente el precio pagado al productor con el precio en el lineal no dice, por sí solo, quién se queda con qué.", "Et une carcasse n’est pas faite que de faux-filet : certaines parties sont très recherchées, d’autres bien moins, et le prix au kilo à l’étal reflète cet équilibre. Comparer directement le prix payé à l’éleveur et le prix en rayon ne dit donc pas, à lui seul, qui garde quoi.")}</p>
          <p>{T("O que sabemos é que muitos criadores sentem que o preço que recebem não acompanha o trabalho e os custos. Medir essa diferença com rigor é uma das perguntas abertas do nosso ", "What we do know is that many farmers feel the price they receive does not keep up with their work and costs. Measuring that gap rigorously is one of the open questions in our ", "Lo que sabemos es que muchos criadores sienten que el precio que reciben no acompaña el trabajo ni los costes. Medir esa diferencia con rigor es una de las preguntas abiertas de nuestro ", "Ce que nous savons, c’est que beaucoup d’éleveurs ont le sentiment que le prix qu’ils reçoivent ne suit ni leur travail ni leurs coûts. Mesurer rigoureusement cet écart est l’une des questions ouvertes de notre ")}<a href={href(lang, "observatorio/")}>{T("Observatório", "Observatory", "Observatorio", "Observatoire")}</a>{T(". Não publicaremos margens sem dados oficiais.", ". We will not publish margins without official data.", ". No publicaremos márgenes sin datos oficiales.", ". Nous ne publierons pas de marges sans données officielles.")}</p>
        </div>
      </div>
    </article>

    <!-- 3.3 Burocracia -->
    <article class="gt-ch gt-ch-split gt-ch-dark gt-rev">
      <figure class="gt-ch-fig rv"><Img id="acores-graciosa" sizes="(max-width:860px) 100vw, 55vw" lang={lang} /><figcaption><a href={crUrl("acores-graciosa")} rel="noopener">{cr("acores-graciosa")}</a></figcaption></figure>
      <div class="gt-ch-txt rv">
        <span class="gt-num">03</span>
        <h3>{T("Burocracia", "Paperwork", "Burocracia", "Paperasserie")}</h3>
        <p>{T("Cada bovino tem de ser identificado com brincos e registado; nascimentos, movimentos, vendas e mortes são comunicados. É esta rastreabilidade, exigida pelas regras europeias, que permite saber de onde vem a carne que comemos.", "Every bovine must be ear-tagged and registered; births, movements, sales and deaths are reported. This traceability, required by European rules, is what lets us know where our meat comes from.", "Cada bovino debe identificarse con crotales y registrarse; nacimientos, movimientos, ventas y muertes se comunican. Esta trazabilidad, exigida por las normas europeas, es lo que permite saber de dónde viene la carne que comemos.", "Chaque bovin doit être identifié par des boucles d’oreille et enregistré ; naissances, mouvements, ventes et décès sont déclarés. Cette traçabilité, exigée par les règles européennes, permet de savoir d’où vient la viande que nous mangeons.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 6", "Source 6", "Fuente 6", "Source 6")}>{num.rot}</a></p>
        <p>{T("Há ainda controlos sanitários, registos de medicamentos, licenças, declarações e candidaturas a apoios, com prazos e plataformas próprias.", "There are also health checks, medicine records, licences, declarations and applications for support, each with its own deadlines and platforms.", "Además hay controles sanitarios, registros de medicamentos, licencias, declaraciones y solicitudes de ayudas, con plazos y plataformas propios.", "S’y ajoutent des contrôles sanitaires, des registres de médicaments, des licences, des déclarations et des demandes d’aides, chacun avec ses délais et ses plateformes.")}</p>
        <p>{T("Muitas destas exigências são necessárias e protegem animais e consumidores. Mas, para uma pequena exploração familiar, sem ninguém dedicado ao escritório, podem significar noites e fins de semana passados entre papéis.", "Many of these requirements are necessary and protect animals and consumers. But on a small family farm, with nobody dedicated to the office, they can mean nights and weekends spent on paperwork.", "Muchas de estas exigencias son necesarias y protegen a los animales y a los consumidores. Pero, para una pequeña explotación familiar, sin nadie dedicado a la oficina, pueden significar noches y fines de semana entre papeles.", "Beaucoup de ces exigences sont nécessaires et protègent les animaux comme les consommateurs. Mais dans une petite exploitation familiale, sans personne dédié au bureau, elles peuvent signifier des soirées et des week-ends passés dans la paperasse.")}</p>
      </div>
    </article>

    <!-- 3.4 Envelhecimento -->
    <article class="gt-ch gt-ch-full">
      <figure class="gt-full-fig"><Img id="mertolenga-rebanho" sizes="100vw" lang={lang} pos="center 45%" />
        <blockquote class="gt-full-q rv"><span class="gt-num">04</span>{T("Em metade das explorações agrícolas portuguesas, quem as dirige tem 65 anos ou mais.", "On half of Portugal's farms, the person in charge is 65 or older.", "En la mitad de las explotaciones agrícolas portuguesas, quien las dirige tiene 65 años o más.", "Dans la moitié des exploitations agricoles portugaises, la personne qui les dirige a 65 ans ou plus.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 8", "Source 8", "Fuente 8", "Source 8")}>{num.mgr}</a></blockquote>
      </figure>
      <p class="gt-cap gt-wrap"><a href={crUrl("mertolenga-rebanho")} rel="noopener">{cr("mertolenga-rebanho")}</a></p>
      <div class="gt-narrow gt-full-txt rv">
        <h3>{T("Envelhecimento e sucessão", "Ageing and succession", "Envejecimiento y relevo", "Vieillissement et transmission")}</h3>
        <p>{T("Segundo o Recenseamento Agrícola de 2019, os produtores tinham em média 64 anos e 46,3 % só tinham concluído o primeiro nível do ensino básico; 53 % tinham formação agrícola exclusivamente prática. Havia 290 mil explorações, menos 15 mil do que em 2009, e a mão de obra agrícola caiu 14,4 % face a 2009, refletindo a redução do trabalho familiar.", "According to the 2019 Agricultural Census, farmers were on average 64 years old and 46.3 % had only completed the first stage of basic education; 53 % had purely practical agricultural training. There were 290 thousand farms, 15 thousand fewer than in 2009, and the farm workforce fell 14.4 % compared with 2009, reflecting less family labour.", "Según el Recenso Agrario de 2019, los productores tenían de media 64 años y el 46,3 % solo había completado el primer nivel de la enseñanza básica; el 53 % tenía formación agrícola exclusivamente práctica. Había 290 mil explotaciones, 15 mil menos que en 2009, y la mano de obra agrícola cayó un 14,4 % respecto a 2009, reflejo de la reducción del trabajo familiar.", "Selon le recensement agricole de 2019, les exploitants avaient en moyenne 64 ans et 46,3 % n’avaient achevé que le premier cycle de l’enseignement de base ; 53 % avaient une formation agricole exclusivement pratique. Il y avait 290 mille exploitations, 15 mille de moins qu’en 2009, et la main-d’œuvre agricole a reculé de 14,4 % par rapport à 2009, ce qui reflète la baisse du travail familial.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fontes 1 e 2", "Sources 1 and 2", "Fuentes 1 y 2", "Sources 1 et 2")}>{num.ra2019},{num.drem}</a></p>
        <p>{T("Os dados do Eurostat mostram o mesmo de outro ângulo: em 2023, em 51,9 % das explorações agrícolas portuguesas o dirigente tinha 65 anos ou mais, e só em 4,9 % tinha menos de 40. Em 2020, a média da União Europeia era de 33,2 % com 65 anos ou mais (Portugal: 50,3 %).", "Eurostat data show the same from another angle: in 2023, on 51.9 % of Portuguese farms the manager was 65 or older, and on only 4.9 % under 40. In 2020 the EU average was 33.2 % aged 65 or older (Portugal: 50.3 %).", "Los datos de Eurostat muestran lo mismo desde otro ángulo: en 2023, en el 51,9 % de las explotaciones agrícolas portuguesas el titular tenía 65 años o más, y solo en el 4,9 % menos de 40. En 2020, la media de la Unión Europea era del 33,2 % con 65 años o más (Portugal: 50,3 %).", "Les données d’Eurostat montrent la même chose sous un autre angle : en 2023, dans 51,9 % des exploitations agricoles portugaises, le chef d’exploitation avait 65 ans ou plus, et dans seulement 4,9 % moins de 40 ans. En 2020, la moyenne de l’Union européenne était de 33,2 % pour les 65 ans ou plus (Portugal : 50,3 %).")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 8", "Source 8", "Fuente 8", "Source 8")}>{num.mgr}</a></p>
        <p>{T("Muito do saber de um criador — ler o tempo, conhecer cada animal, saber onde há água em agosto — passa de pais para filhos, no campo. Quando não há quem continue, esse saber pode perder-se com a exploração.", "Much of a farmer's knowledge — reading the weather, knowing each animal, knowing where there is water in August — passes from parent to child, in the field. When no one carries on, that knowledge can be lost along with the farm.", "Gran parte del saber de un criador —leer el tiempo, conocer a cada animal, saber dónde hay agua en agosto— pasa de padres a hijos, en el campo. Cuando nadie continúa, ese saber puede perderse con la explotación.", "Une grande part du savoir d’un éleveur — lire le temps, connaître chaque animal, savoir où il y a de l’eau en août — se transmet de parent à enfant, sur le terrain. Quand personne ne prend la suite, ce savoir peut disparaître avec l’exploitation.")}</p>
      </div>
    </article>

    <!-- 3.5 Clima -->
    <article class="gt-ch gt-ch-split gt-ch-soft">
      <figure class="gt-ch-fig gt-tall rv"><Img id="pasto-seco" sizes="(max-width:860px) 100vw, 50vw" lang={lang} /><figcaption><a href={crUrl("pasto-seco")} rel="noopener">{cr("pasto-seco")}</a></figcaption></figure>
      <div class="gt-ch-txt rv">
        <span class="gt-num">05</span>
        <h3>{T("Clima e território", "Climate and land", "Clima y territorio", "Climat et territoire")}</h3>
        <p>{T("Num ano de seca, o pasto seca mais cedo e a erva não volta a tempo. É preciso alimentar os animais durante mais meses com o que se compra ou se guardou, e garantir água em charcas, poços e bebedouros.", "In a drought year, pasture dries earlier and grass doesn't return in time. Animals must be fed for more months on what was bought or stored, and water secured in ponds, wells and troughs.", "En un año de sequía, el pasto se seca antes y la hierba no vuelve a tiempo. Hay que alimentar a los animales durante más meses con lo que se compra o se ha guardado, y asegurar agua en charcas, pozos y bebederos.", "Lors d’une année de sécheresse, le pâturage sèche plus tôt et l’herbe ne repousse pas à temps. Il faut nourrir les animaux pendant plus de mois avec ce qui est acheté ou stocké, et garantir l’eau dans les mares, les puits et les abreuvoirs.")}</p>
        <p>{T("Os incêndios podem destruir pastagens, vedações e abrigos numa tarde. E as mudanças nas chuvas e nas temperaturas obrigam a repensar quando e onde os animais pastam.", "Wildfires can destroy pasture, fences and shelters in an afternoon. And changing rainfall and temperatures force farmers to rethink when and where animals graze.", "Los incendios pueden destruir pastos, vallas y refugios en una tarde. Y los cambios en las lluvias y las temperaturas obligan a replantear cuándo y dónde pastan los animales.", "Les incendies peuvent détruire pâturages, clôtures et abris en un après-midi. Et l’évolution des pluies et des températures oblige à repenser quand et où les animaux pâturent.")}</p>
        <p class="gt-tag">{T("Enquadramento editorial, sem quantificação nesta fase.", "Editorial framing, not yet quantified.", "Marco editorial, sin cuantificar en esta fase.", "Cadrage éditorial, sans quantification à ce stade.")}</p>
      </div>
    </article>
  </section>

  <!-- 4. O que está em risco -->
  <section class="gt-risco" aria-labelledby="gt-risco-t">
    <div class="gt-wrap">
      <span class="eyebrow rv">{T("O que está em risco", "What is at stake", "Lo que está en riesgo", "Ce qui est en jeu")}</span>
      <h2 id="gt-risco-t" class="gt-h gt-h-wide rv">{T("Quando um criador desiste, perdemos mais do que uma exploração.", "When a farmer gives up, we lose more than a farm.", "Cuando un criador abandona, perdemos más que una explotación.", "Quand un éleveur renonce, nous perdons plus qu’une exploitation.")}</h2>
      <p class="gt-lead rv">{T("Entre 2005 e 2023, o número de explorações com bovinos em Portugal passou de 61 830 para 31 620 — quase metade. O número de animais não caiu: eram 1 315 440 em 2005 e 1 439 710 em 2023. Há hoje menos criadores, cada um com mais animais em média.", "Between 2005 and 2023 the number of farms with cattle in Portugal fell from 61,830 to 31,620 — almost half. The number of animals did not fall: 1,315,440 in 2005 and 1,439,710 in 2023. Today there are fewer farmers, each with more animals on average.", "Entre 2005 y 2023, el número de explotaciones con bovinos en Portugal pasó de 61 830 a 31 620, casi la mitad. El número de animales no cayó: eran 1 315 440 en 2005 y 1 439 710 en 2023. Hoy hay menos criadores, cada uno con más animales de media.", "Entre 2005 et 2023, le nombre d’exploitations avec bovins au Portugal est passé de 61 830 à 31 620 — presque la moitié. Le nombre d’animaux n’a pas baissé : 1 315 440 en 2005 et 1 439 710 en 2023. Il y a aujourd’hui moins d’éleveurs, chacun avec plus d’animaux en moyenne.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 7", "Source 7", "Fuente 7", "Source 7")}>{num.lsk}</a></p>
    </div>
    <div class="gt-mosaic gt-wrap">
      <figure class="m1 rv"><Img id="montalegre" sizes="(max-width:860px) 100vw, 40vw" lang={lang} /><figcaption>{cr("montalegre")}</figcaption></figure>
      <figure class="m2 rv"><Img id="geres-descanso" sizes="(max-width:860px) 100vw, 55vw" lang={lang} /><figcaption>{cr("geres-descanso")}</figcaption></figure>
      <figure class="m3 rv"><Img id="tourem-manada" sizes="(max-width:860px) 100vw, 55vw" lang={lang} /><figcaption>{cr("tourem-manada")}</figcaption></figure>
    </div>
    <div class="gt-wrap gt-risk-list">
      <div class="rv"><h3>{T("As raças", "The breeds", "Las razas", "Les races")}</h3><p>{T("Algumas raças autóctones dependem de muito poucas pessoas. Em 2019, o livro genealógico de adultos da Algarvia tinha 2 machos e 2 fêmeas em linha pura, em 3 criadores; o da Garvonesa, 16 criadores; o da Jarmelista, 25.", "Some native breeds depend on very few people. In 2019 the Algarvia adult herd book listed 2 purebred males and 2 females, with 3 breeders; the Garvonesa, 16 breeders; the Jarmelista, 25.", "Algunas razas autóctonas dependen de muy pocas personas. En 2019, el libro genealógico de adultos de la Algarvia tenía 2 machos y 2 hembras en línea pura, en 3 criadores; el de la Garvonesa, 16 criadores; el de la Jarmelista, 25.", "Certaines races autochtones dépendent de très peu de personnes. En 2019, le livre généalogique des adultes de l’Algarvia comptait 2 mâles et 2 femelles de lignée pure, chez 3 éleveurs ; celui de la Garvonesa, 16 éleveurs ; celui de la Jarmelista, 25.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 3", "Source 3", "Fuente 3", "Source 3")}>{num.cat}</a></p></div>
      <div class="rv"><h3>{T("O saber", "Knowledge", "El saber", "Le savoir")}</h3><p>{T("Maneio, ofícios, calendários de pastoreio e nomes de lugares que só se aprendem com quem os viveu.", "Herd management, crafts, grazing calendars and place names that can only be learned from those who lived them.", "Manejo del ganado, oficios, calendarios de pastoreo y nombres de lugares que solo se aprenden de quien los vivió.", "Conduite du troupeau, métiers, calendriers de pâturage et noms de lieux qui ne s’apprennent qu’auprès de ceux qui les ont vécus.")}</p></div>
      <div class="rv"><h3>{T("As comunidades", "Communities", "Las comunidades", "Les communautés")}</h3><p>{T("Em muitas aldeias, a criação de gado mantém pessoas, feiras e serviços. Nem todas as situações são iguais, mas cada exploração que fecha pesa na vida local.", "In many villages, cattle farming keeps people, fairs and services going. Situations differ, but every farm that closes weighs on local life.", "En muchas aldeas, la cría de ganado mantiene a las personas, las ferias y los servicios. No todas las situaciones son iguales, pero cada explotación que cierra pesa en la vida local.", "Dans de nombreux villages, l’élevage fait vivre les habitants, les foires et les services. Les situations diffèrent, mais chaque exploitation qui ferme pèse sur la vie locale.")}</p></div>
      <div class="rv"><h3>{T("A paisagem", "The landscape", "El paisaje", "Le paysage")}</h3><p>{T("Lameiros, montados e pastagens de montanha são, em parte, obra do pastoreio. Sem animais, muitos destes espaços mudam.", "Meadows, cork-oak pastures and mountain grazing land are partly the work of grazing. Without animals, many of these places change.", "Los prados, los montados y los pastos de montaña son, en parte, obra del pastoreo. Sin animales, muchos de estos espacios cambian.", "Les prairies, les montados (pâturages sous chênes-lièges) et les pâturages de montagne sont en partie l’œuvre du pâturage. Sans animaux, beaucoup de ces espaces changent.")}</p></div>
      <div class="rv"><h3>{T("A mesa", "The table", "La mesa", "La table")}</h3><p>{T("Pratos e carnes ligados a um lugar e a uma raça só existem enquanto houver quem crie esses animais.", "Dishes and meats tied to a place and a breed only exist while someone raises those animals.", "Los platos y las carnes ligados a un lugar y a una raza solo existen mientras haya quien críe esos animales.", "Les plats et les viandes liés à un lieu et à une race n’existent que tant que quelqu’un élève ces animaux.")}</p></div>
    </div>
  </section>

  <!-- 5. Ainda há futuro -->
  <section class="gt-futuro" aria-labelledby="gt-futuro-t">
    <figure class="gt-futuro-fig"><Img id="reflexo-mundo-acoriano" sizes="100vw" lang={lang} pos="center 60%" /><figcaption class="gt-wrap">{cr("reflexo-mundo-acoriano")}</figcaption></figure>
    <div class="gt-wrap gt-futuro-in">
      <div class="gt-futuro-head rv">
        <span class="eyebrow">{T("Esperança", "Hope", "Esperanza", "Espoir")}</span>
        <h2 id="gt-futuro-t" class="gt-h">{T("Ainda há futuro para a nossa terra.", "There is still a future for our land.", "Todavía hay futuro para nuestra tierra.", "Il y a encore un avenir pour notre terre.")}</h2>
      </div>
      <ol class="gt-paths">
        <li class="rv"><h3>{T("Carnes com nome e origem", "Meats with a name and an origin", "Carnes con nombre y origen", "Des viandes avec un nom et une origine")}</h3><p>{T("Portugal tem 14 carnes de bovino com nome protegido na lista da DGADR: 11 com Denominação de Origem Protegida (DOP) — como a Carne Barrosã, a Carnalentejana, a Carne Mirandesa ou a Carne Ramo Grande — e 3 com Indicação Geográfica Protegida (IGP), como a Vitela de Lafões. Ligam o preço a uma raça, a um território e a regras de produção.", "Portugal has 14 beef products with a protected name on the DGADR list: 11 Protected Designations of Origin (PDO) — such as Carne Barrosã, Carnalentejana, Carne Mirandesa and Carne Ramo Grande — and 3 Protected Geographical Indications (PGI), such as Vitela de Lafões. They tie price to a breed, a territory and production rules.", "Portugal tiene 14 carnes de vacuno con nombre protegido en la lista de la DGADR: 11 con Denominación de Origen Protegida (DOP) —como la Carne Barrosã, la Carnalentejana, la Carne Mirandesa o la Carne Ramo Grande— y 3 con Indicación Geográfica Protegida (IGP), como la Vitela de Lafões. Vinculan el precio a una raza, a un territorio y a normas de producción.", "Le Portugal compte 14 viandes bovines à nom protégé sur la liste de la DGADR : 11 avec Appellation d’origine protégée (AOP) — comme la Carne Barrosã, la Carnalentejana, la Carne Mirandesa ou la Carne Ramo Grande — et 3 avec Indication géographique protégée (IGP), comme la Vitela de Lafões. Elles lient le prix à une race, à un territoire et à des règles de production.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 4", "Source 4", "Fuente 4", "Source 4")}>{num.dgadr}</a></p></li>
        <li class="rv"><h3>{T("Associações de criadores", "Breeders’ associations", "Asociaciones de criadores", "Associations d’éleveurs")}</h3><p>{T("As associações de cada raça gerem os livros genealógicos, que registam os animais em linha pura e permitem conservar e melhorar a raça. Na Cachena, por exemplo, o registo zootécnico começou em 1994 e o livro genealógico em 1998.", "Each breed's association keeps its herd book, which records purebred animals and makes it possible to conserve and improve the breed. For the Cachena, for example, zootechnical recording began in 1994 and the herd book in 1998.", "Las asociaciones de cada raza gestionan los libros genealógicos, que registran los animales en línea pura y permiten conservar y mejorar la raza. En la Cachena, por ejemplo, el registro zootécnico comenzó en 1994 y el libro genealógico en 1998.", "Les associations de chaque race gèrent les livres généalogiques, qui enregistrent les animaux de lignée pure et permettent de conserver et d’améliorer la race. Pour la Cachena, par exemple, l’enregistrement zootechnique a commencé en 1994 et le livre généalogique en 1998.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 3", "Source 3", "Fuente 3", "Source 3")}>{num.cat}</a></p></li>
        <li class="rv"><h3>{T("Novas gerações", "New generations", "Nuevas generaciones", "Nouvelles générations")}</h3><p>{T("O plano estratégico da PAC em Portugal inclui um apoio à instalação de jovens agricultores, entre os 18 e os 40 anos, que assumem pela primeira vez a gestão de uma exploração.", "Portugal's CAP Strategic Plan includes support for young farmers aged 18 to 40 who take over the management of a farm for the first time.", "El plan estratégico de la PAC en Portugal incluye una ayuda a la instalación de jóvenes agricultores, de entre 18 y 40 años, que asumen por primera vez la gestión de una explotación.", "Le plan stratégique de la PAC au Portugal comprend une aide à l’installation des jeunes agriculteurs, âgés de 18 à 40 ans, qui prennent pour la première fois la direction d’une exploitation.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 5", "Source 5", "Fuente 5", "Source 5")}>{num.gpp}</a></p></li>
        <li class="rv"><h3>{T("Venda mais próxima", "Selling closer to home", "Venta más cercana", "Une vente plus proche")}</h3><p>{T("Venda direta, talhos de proximidade, cabazes e restaurantes que compram a criadores conhecidos encurtam a distância entre quem produz e quem come.", "Direct sales, local butchers, box schemes and restaurants buying from known farmers shorten the distance between those who produce and those who eat.", "La venta directa, las carnicerías de proximidad, las cestas y los restaurantes que compran a criadores conocidos acortan la distancia entre quien produce y quien come.", "La vente directe, les boucheries de proximité, les paniers et les restaurants qui achètent à des éleveurs connus raccourcissent la distance entre celui qui produit et celui qui mange.")}</p></li>
        <li class="rv"><h3>{T("Conhecimento e reconhecimento", "Knowledge and recognition", "Conocimiento y reconocimiento", "Connaissance et reconnaissance")}</h3><p>{T("Formação, técnicas de pastoreio, registo de dados e novas ferramentas ajudam a produzir melhor. E reconhecer publicamente este trabalho também conta.", "Training, grazing techniques, record-keeping and new tools help farmers produce better. And publicly recognising this work matters too.", "La formación, las técnicas de pastoreo, el registro de datos y las nuevas herramientas ayudan a producir mejor. Y reconocer públicamente este trabajo también cuenta.", "La formation, les techniques de pâturage, la tenue de registres et les nouveaux outils aident à mieux produire. Et reconnaître publiquement ce travail compte aussi.")}</p></li>
      </ol>
    </div>
  </section>

  <!-- 6. O nosso papel -->
  <section class="gt-papel" aria-labelledby="gt-papel-t">
    <div class="gt-papel-grid gt-wrap">
      <div class="gt-papel-head rv">
        <h2 id="gt-papel-t" class="gt-h">{T("O nosso papel", "Our part", "Nuestro papel", "Notre rôle")}</h2>
        <p class="gt-lead">{T("Cada compra é uma pequena escolha. Feita com informação, pode ajudar a dar valor a quem cria.", "Every purchase is a small choice. Made with information, it can help give value to those who raise the animals.", "Cada compra es una pequeña elección. Hecha con información, puede ayudar a dar valor a quien cría.", "Chaque achat est un petit choix. Fait en connaissance de cause, il peut aider à valoriser ceux qui élèvent les animaux.")}</p>
      </div>
      <ol class="gt-steps">
        <li class="rv"><strong>{T("Ler o rótulo.", "Read the label.", "Leer la etiqueta.", "Lire l’étiquette.")}</strong> {T("A rotulagem da carne de bovino indica onde o animal nasceu, foi criado e abatido.", "Beef labels state where the animal was born, reared and slaughtered.", "El etiquetado de la carne de vacuno indica dónde nació, se crió y se sacrificó el animal.", "L’étiquetage de la viande bovine indique où l’animal est né, a été élevé et abattu.")}<a class="gt-ref" href="#gt-fontes" aria-label={T("Fonte 6", "Source 6", "Fuente 6", "Source 6")}>{num.rot}</a> <a href={href(lang, "viagem/")}>{T("Saber mais sobre a carne →", "More about the meat →", "Saber más sobre la carne →", "En savoir plus sur la viande →")}</a></li>
        <li class="rv"><strong>{T("Conhecer as raças.", "Get to know the breeds.", "Conocer las razas.", "Connaître les races.")}</strong> {T("Cada uma tem a sua terra e a sua história.", "Each has its own land and its own story.", "Cada una tiene su tierra y su historia.", "Chacune a sa terre et son histoire.")} <a href={href(lang, "racas/")}>{T("As 15 raças autóctones →", "The 15 native breeds →", "Las 15 razas autóctonas →", "Les 15 races autochtones →")}</a></li>
        <li class="rv"><strong>{T("Compreender as certificações.", "Understand certifications.", "Entender las certificaciones.", "Comprendre les certifications.")}</strong> {T("DOP e IGP garantem uma origem e um caderno de especificações controlado — não garantem, só por si, mais qualidade em todos os aspetos.", "PDO and PGI guarantee an origin and a controlled product specification — they do not, by themselves, guarantee higher quality in every respect.", "La DOP y la IGP garantizan un origen y un pliego de condiciones controlado; no garantizan, por sí solas, más calidad en todos los aspectos.", "L’AOP et l’IGP garantissent une origine et un cahier des charges contrôlé — elles ne garantissent pas, à elles seules, une meilleure qualité sur tous les plans.")}</li>
        <li class="rv"><strong>{T("Perguntar.", "Ask.", "Preguntar.", "Demander.")}</strong> {T("No talho ou no restaurante, perguntar de onde vem a carne mostra que a origem importa.", "At the butcher's or in a restaurant, asking where the meat comes from shows that origin matters.", "En la carnicería o en el restaurante, preguntar de dónde viene la carne demuestra que el origen importa.", "Chez le boucher ou au restaurant, demander d’où vient la viande montre que l’origine compte.")}</li>
        <li class="rv"><strong>{T("Comprar diretamente, quando possível.", "Buy direct when you can.", "Comprar directamente, cuando sea posible.", "Acheter en direct quand c’est possible.")}</strong> {T("Em feiras, mercados ou na própria exploração.", "At fairs, markets or on the farm itself.", "En ferias, mercados o en la propia explotación.", "Sur les foires, les marchés ou à l’exploitation même.")}</li>
      </ol>
    </div>
    <p class="gt-narrow gt-honest rv">{T("Uma nota de honestidade: ser produzida em Portugal não torna uma carne automaticamente melhor, mais sustentável ou com mais bem-estar animal. O que defendemos é a escolha informada.", "A note of honesty: being produced in Portugal does not automatically make a meat better, more sustainable or higher in animal welfare. What we stand for is informed choice.", "Una nota de honestidad: ser producida en Portugal no hace que una carne sea automáticamente mejor, más sostenible o con más bienestar animal. Lo que defendemos es la elección informada.", "Une note d’honnêteté : être produite au Portugal ne rend pas automatiquement une viande meilleure, plus durable ou plus respectueuse du bien-être animal. Ce que nous défendons, c’est le choix éclairé.")}</p>
  </section>

  <!-- Fontes -->
  <section class="gt-fontes" id="gt-fontes" aria-labelledby="gt-fontes-t">
    <div class="gt-narrow">
      <h2 id="gt-fontes-t">{T("Fontes e notas", "Sources and notes", "Fuentes y notas", "Sources et notes")}</h2>
      <ol>{ordem.map((k) => { const s = (S as any)[k]; return <li><a href={s.u} rel="noopener">{s.l} ↗</a>{s.n && <span> — {s.n}</span>}</li>; })}</ol>
      <p>{T("Os números citados têm fonte e ano de referência. Os parágrafos sem número de fonte são texto editorial de enquadramento: descrevem realidades conhecidas do setor, sem as quantificar, e não devem ser lidos como dados. Não usamos testemunhos nem citações de pessoas reais. Os inquéritos às explorações agrícolas do Eurostat mudaram de método ao longo dos anos (limiares e cobertura); por isso comparamos sobretudo a tendência, não diferenças pequenas.", "Figures quoted carry a source and a reference year. Paragraphs without a source number are editorial framing: they describe well-known realities of the sector without quantifying them and should not be read as data. We do not use testimonies or quotes from real people. Eurostat farm surveys have changed method over the years (thresholds and coverage), so we compare the trend rather than small differences.", "Las cifras citadas tienen fuente y año de referencia. Los párrafos sin número de fuente son texto editorial de contexto: describen realidades conocidas del sector, sin cuantificarlas, y no deben leerse como datos. No usamos testimonios ni citas de personas reales. Las encuestas de explotaciones agrícolas de Eurostat han cambiado de método a lo largo de los años (umbrales y cobertura); por eso comparamos sobre todo la tendencia, no diferencias pequeñas.", "Les chiffres cités ont une source et une année de référence. Les paragraphes sans numéro de source relèvent du cadrage éditorial : ils décrivent des réalités bien connues du secteur sans les quantifier et ne doivent pas être lus comme des données. Nous n’utilisons ni témoignages ni citations de personnes réelles. Les enquêtes d’Eurostat sur les exploitations agricoles ont changé de méthode au fil des ans (seuils et couverture) ; nous comparons donc surtout la tendance, non les petits écarts.")}</p>
      <p>{T("As fotografias de terceiros indicam autor, licença e origem.", "Third-party photographs credit author, licence and source.", "Las fotografías de terceros indican autor, licencia y origen.", "Les photographies de tiers indiquent l’auteur, la licence et l’origine.")}</p>
