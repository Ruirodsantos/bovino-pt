---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { getCollection } from "astro:content";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const all = (await getCollection(lang === "en" ? "carne_en" : "carne"));
const menu = [
  { id: "01-carne-crua", pt: "Carne crua", en: "Raw beef" },
  { id: "03-cortes", pt: "Cortes", en: "Cuts" },
  { id: "02-maturacao", pt: "Maturar", en: "Ageing" },
  { id: "04-cozedura", pt: "Cozinhar", en: "Cooking" },
  { id: "05-servir", pt: "Servir", en: "Serving" },
];
---
<Base lang={lang} title={T("A Carne", "The Meat")} description={T("A carne de bovino por dentro: crua, maturada, cozinhada e servida ao nível dos melhores restaurantes.", "Beef from the inside: raw, aged, cooked and served at the level of the best restaurants.")}>
  <section class="meat-hero"><img src={`${import.meta.env.BASE_URL}img/carne-capa-lg.webp`} srcset={`${import.meta.env.BASE_URL}img/carne-capa-sm.webp 500w, ${import.meta.env.BASE_URL}img/carne-capa-md.webp 1000w, ${import.meta.env.BASE_URL}img/carne-capa-lg.webp 2000w`} sizes="100vw" alt={T("Costeletão cru sobre uma tábua de madeira, com bovinos a pastar num vale ao fundo", "Raw bone-in rib steak on a wooden board, with cattle grazing in a valley behind")} width="1672" height="941" fetchpriority="high"/><div class="meat-hero-text"><span class="eyebrow">{T("A carne portuguesa", "Portuguese beef")}</span><h1>{T("Da origem ao sabor.", "From origin to flavour.")}</h1><p>{T("Conhecer. Escolher. Preparar. Saborear.", "Understand. Choose. Prepare. Savour.")}</p></div><small class="meat-hero-cap">{T("Imagem ilustrativa", "Illustrative image")}</small></section>
  <section class="meat-journey wrap"><p class="meat-intro">{T("Cinco formas de conhecer melhor aquilo que chega à nossa mesa.", "Five ways to understand what reaches our table.")}</p><div class="meat-links">
    {menu.map((m, i) => <a href={href(lang, `carne/${m.id}/`)} class="meat-link"><span class="number">{String(i+1).padStart(2,"0")}</span><h2>{lang === "en" ? m.en : m.pt}</h2><span class="arrow" aria-hidden="true">↗</span></a>)}
  </div></section>
</Base>
<style>
.meat-hero{min-height:clamp(580px,92svh,1000px);position:relative;display:flex;align-items:flex-end;color:white;background:#241c17;overflow:hidden}
.meat-hero .eyebrow{color:#e6efdc!important;text-shadow:0 1px 6px rgba(0,0,0,.6)}
.meat-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.78)}
.meat-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(12,19,15,.8))}
.meat-hero-text{position:relative;z-index:1;width:min(1140px,88%);margin:0 auto;padding-bottom:clamp(80px,12vh,150px)}
.meat-hero-text h1{color:white;font-size:clamp(3rem,7vw,7rem);line-height:1.06;max-width:12ch;margin:16px 0}
.meat-hero-text p{font-size:clamp(1.1rem,2vw,1.55rem);margin:0}
.meat-journey{padding-top:clamp(70px,10vw,150px);padding-bottom:clamp(80px,12vw,180px)}
.meat-intro{font-size:clamp(1.2rem,2vw,1.8rem);max-width:32ch;margin-bottom:55px}
.meat-link{display:grid;grid-template-columns:70px 1fr 50px;gap:20px;align-items:center;text-decoration:none;color:inherit;border-top:1px solid var(--line);padding:clamp(22px,3.5vw,44px) 0;transition:padding .3s,background .3s}
.meat-link:last-child{border-bottom:1px solid var(--line)}
.meat-link:hover{padding-left:18px;background:rgba(40,80,60,.035)}
.meat-link h2{font-size:clamp(1.8rem,4.4vw,4.3rem);font-weight:500;line-height:1.1;margin:0}
.meat-link .number{font-size:.9rem;color:var(--muted)}.meat-link .arrow{font-size:1.8rem;justify-self:end}
@media(max-width:650px){.meat-link{grid-template-columns:34px 1fr 25px;gap:12px}.meat-hero{min-height:75svh}}
.meat-hero{align-items:flex-start!important}
.meat-hero>img{filter:none!important;object-position:50% 60%}
.meat-hero:after{background:linear-gradient(180deg,rgba(8,20,14,.72) 0%,rgba(8,20,14,.35) 38%,transparent 62%)!important}
.meat-hero-text{padding-top:clamp(110px,17vh,190px)!important;padding-bottom:0!important}
.meat-hero-text h1{max-width:14ch}
.meat-hero-text p,.meat-hero-text h1{text-shadow:0 2px 14px rgba(0,0,0,.45)}
.meat-hero-cap{position:absolute;right:clamp(16px,3vw,40px);bottom:12px;z-index:1;color:rgba(255,255,255,.8);font-size:.7rem;letter-spacing:.06em;text-shadow:0 1px 4px rgba(0,0,0,.6)}
.meat-hero{display:block!important;min-height:0!important;background:#183b30}
.meat-hero>img{position:static!important;display:block;width:100%;height:auto!important;aspect-ratio:16/9;object-fit:cover!important;object-position:center!important;filter:none!important}
.meat-hero:after{display:block!important;background:linear-gradient(180deg,rgba(8,20,14,.7) 0%,rgba(8,20,14,.3) 40%,transparent 65%)!important}
.meat-hero-text{position:absolute;left:0;right:0;top:0;margin:0 auto;padding:clamp(64px,9vw,120px) 0 0!important}
.meat-hero-text h1{max-width:16ch;font-size:clamp(1.5rem,5vw,4.6rem);margin:8px 0}
.meat-hero-text p{font-size:clamp(.8rem,1.6vw,1.4rem)}
.meat-hero-text p,.meat-hero-text h1{text-shadow:0 2px 14px rgba(0,0,0,.5)!important}
.meat-hero-cap{bottom:12px!important;top:auto!important;right:clamp(16px,3vw,40px)}
</style>
