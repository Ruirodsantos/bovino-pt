---
import Base from "../layouts/Base.astro";
import Img from "../components/proto/Img.astro";
import credits from "../data/images.json";
import { getCollection } from "astro:content";
import { href } from "../i18n";
interface Props { parent: "carne" | "prato" }
const { parent } = Astro.props;
const prato = parent === "prato";
const root = prato ? "da-pastagem-ao-prato/" : "carne/";
const all = (await getCollection("temas")).filter((t) => t.data.parent === parent).sort((a, b) => a.data.order - b.data.order);
const has = (id?: string) => !!id && !!(credits as Record<string, any>)[id];
const groups: { name: string; items: typeof all }[] = [];
for (const t of all) { const g = prato ? "" : (t.data.group ?? ""); let x = groups.find((y) => y.name === g); if (!x) groups.push((x = { name: g, items: [] })); x.items.push(t); }
const heroId = prato ? "prato-capa" : "carne-capa";
const heroOk = has(heroId) || !prato;
const b = import.meta.env.BASE_URL;
const title = prato ? "Da Terra à Mesa" : "A carne";
const lead = prato ? "Do nascimento ao prato, em nove etapas." : "Da origem ao sabor: cada tema, uma página.";
const idx = (t: any) => all.indexOf(t) + 1;
---
<Base lang="pt" overlay title={title} description={lead} enPath={href("en", root)}>
  <header class:list={["hb-hero", !heroOk && "hb-plain"]}>
    {heroOk && !prato && <img class="hb-bg" src={`${b}img/carne-capa-lg.webp`} srcset={`${b}img/carne-capa-sm.webp 500w, ${b}img/carne-capa-md.webp 1000w, ${b}img/carne-capa-lg.webp 1800w`} sizes="100vw" alt="" />}
    {heroOk && prato && <Img id={heroId} sizes="100vw" eager class="hb-bg" />}
    {!heroOk && <div class="tp-slotlabel"><b>FOTO · CAPA</b> {heroId}<br />2400 × 1350 px · 16:9 · horizontal</div>}
    <div class="hb-in"><h1>{title}</h1><p>{lead}</p></div>
  </header>
  <div class="hb-body">
    {groups.map((g) => (
      <section class="hb-group">
        {g.name && <h2>{g.name}</h2>}
        <div class="hb-grid">
          {g.items.map((t) => (
            <a class={["hb-card", has(t.data.photo) && "has"].filter(Boolean).join(" ")} href={href("pt", `${root}${t.id}/`)}>
              {has(t.data.photo) && <Img id={t.data.photo!} sizes="(max-width:760px) 100vw, 33vw" />}
              <span class="hb-n">{String(idx(t)).padStart(2, "0")}</span>
              <span class="hb-t">{t.data.title}</span>
              {!has(t.data.photo) && <span class="hb-slot">FOTO · {t.data.photo}</span>}
            </a>
          ))}
        </div>
      </section>
    ))}
    {!prato && <section class="hb-group"><h2>Em 3D</h2><div class="hb-grid"><a class="hb-card hb-3d" href={href("pt", "anatomia-cortes/")}><span class="hb-n">3D</span><span class="hb-t">Anatomia e cortes</span></a></div></section>}
  </div>
</Base>
<script is:inline>if(/[?&]fotos/.test(location.search))document.documentElement.classList.add("show-slots");</script>
<style is:global>
  .hb-hero{position:relative;min-height:80svh;display:flex;align-items:flex-end;color:#fff;background:#21382d;overflow:hidden}
  .hb-hero .hb-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.65)}
  .hb-in{position:relative;z-index:1;width:min(70rem,calc(100% - 3rem));margin:0 auto;padding:9rem 0 clamp(3rem,9vh,6rem)}
  .hb-in h1{font-size:clamp(3.2rem,9vw,8rem);line-height:1;letter-spacing:-.045em;color:#fff;margin:0 0 .2em}.hb-in p{font-size:clamp(1.15rem,2vw,1.6rem);font-weight:300;margin:0}
  .hb-body{background:#f5f2e9;color:#263e30;padding:clamp(3rem,7vw,6rem) 1.5rem clamp(4rem,9vw,8rem)}
  .hb-group{max-width:72rem;margin:0 auto clamp(2.5rem,6vw,5rem)}.hb-group h2{font-size:.85rem;letter-spacing:.2em;text-transform:uppercase;color:#6b8a6b;margin:0 0 1.2rem;font-weight:600}
  .hb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,17rem),1fr));gap:14px}
  .hb-card{position:relative;display:flex;flex-direction:column;justify-content:flex-end;aspect-ratio:4/3;padding:1.1rem;border-radius:14px;overflow:hidden;text-decoration:none;color:#fff;background:#21382d;transition:transform .4s}
  .hb-card:hover{transform:translateY(-3px)}
  .hb-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s}.hb-card:hover img{transform:scale(1.05)}
  .hb-card.has::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(0,0,0,.7))}
  .hb-n,.hb-t{position:relative;z-index:1}.hb-card .hb-n{font-size:.75rem;letter-spacing:.2em;color:#cfe3cf!important}.hb-card .hb-t{font:500 1.6rem/1.15 var(--display);color:#fff!important}
  .hb-slot{display:none;position:relative;z-index:1;font:500 .66rem ui-monospace,monospace;margin-top:.4rem;color:#e6efdc}html.show-slots .hb-slot{display:block}
  .hb-3d{background:#3d5a4a}
  .hb-hero .tp-slotlabel{display:none;position:absolute;right:1.5rem;top:6rem;z-index:2;border:2px dashed rgba(255,255,255,.7);padding:.8rem 1rem;font:500 .8rem/1.5 ui-monospace,monospace;color:#fff;background:rgba(0,0,0,.25)}html.show-slots .hb-hero .tp-slotlabel{display:block}
</style>
