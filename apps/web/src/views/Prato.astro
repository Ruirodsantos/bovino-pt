---
import Base from "../layouts/Base.astro";
import Img from "../components/proto/Img.astro";
import Classificacao from "../components/diagrams/Classificacao.astro";
import CortesViewer from "../components/diagrams/CortesViewer.astro";
import credits from "../data/images.json";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const CAT = "https://www.dgav.pt/wp-content/uploads/2021/04/Catalogo-Oficial-Racas-Autoctones-Portuguesas.pdf";
const BARROSA = "https://www.ptpt.pt/en/produtos/68";
const CARNAL = "https://ptpt.pt/en/produtos/8";
const eur = (c: string) => `https://eur-lex.europa.eu/legal-content/${lang === "en" ? "EN" : "PT"}/TXT/?uri=CELEX:${c}`;
const L = (l: string, u: string) => ({ l, u });
type Ex = { b: string; slug?: string; p: string };
type Stage = { id: string; t: string; img?: string; general: string[]; ex: Ex[]; maybe: string[]; links: { l: string; u: string }[]; extra?: "classificacao" | "cuts" };
const stages: Stage[] = [
  { id: "nascimento", t: T("Nascimento", "Birth"), img: "mertolenga-rebanho",
    general: [T("O percurso começa numa vaca de cria. Nos sistemas de carne, o vitelo vive junto da mãe e mama durante os primeiros meses; nos sistemas de leite, é separado mais cedo. Cada animal tem de ser identificado (brinco auricular e registo) pouco depois de nascer, e é essa identificação que permite seguir o animal até ao prato.", "The route starts with a suckler cow. In beef systems the calf stays with its mother and nurses for its first months; in dairy systems it is separated earlier. Every animal must be identified (ear tag and registration) soon after birth, and that identification is what lets it be traced all the way to the plate.")],
    ex: [
      { b: "Mertolenga", slug: "mertolenga", p: T("O catálogo destaca a facilidade de parto, a longevidade produtiva e a boa capacidade maternal da raça.", "The catalogue highlights the breed's easy calving, productive longevity and good mothering ability.") },
      { b: "Mirandesa", slug: "mirandesa", p: T("No sistema extensivo, os vitelos andam com as mães em pastoreio até aos 5 a 7 meses e só então são desmamados.", "In the extensive system, calves stay with their mothers at pasture until 5 to 7 months and are only then weaned.") },
      { b: "Cachena", slug: "cachena", p: T("Raça de alta montanha, de forte instinto maternal.", "A high-mountain breed with a strong maternal instinct.") },
    ],
    maybe: [T("Em todas as regiões há também vitelos de bovinos leiteiros e de cruzamentos; a sua proporção ainda não está documentada aqui.", "In every region there are also calves from dairy cattle and crosses; their share is not documented here yet.")],
    links: [L(T("Catálogo das raças autóctones (DGAV/CAP)", "Native breeds catalogue (DGAV/CAP)"), CAT)] },
  { id: "criacao", t: T("Criação", "Rearing"), img: "montalegre",
    general: [T("Em sistemas extensivos os animais pastam ao ar livre durante grande parte do ano; em sistemas intensivos passam mais tempo em estábulo ou em parque. A raça, o clima e o que o criador pretende produzir (vitelo, novilho, vaca de refugo, boi) decidem o sistema.", "In extensive systems animals graze outdoors for much of the year; in intensive systems they spend more time indoors or in pens. Breed, climate and what the farmer wants to produce (veal, young bullock, culled cow, ox) decide the system.")],
    ex: [
      { b: "Barrosã", slug: "barrosa", p: T("Sistema extensivo, em montanha e meia encosta, aproveitando a carqueja e o tojo. A zona de produção da Carne Barrosã DOP abrange 21 concelhos do Norte.", "Extensive system on mountain and mid-slope land, using heather and gorse. The production area of Carne Barrosã PDO covers 21 municipalities in the north.") },
      { b: "Arouquesa", slug: "arouquesa", p: T("Os sistemas variam: pastoreio em baldios (raro hoje), estabulação permanente, estabulação só no inverno ou regime semi-extensivo.", "Systems vary: grazing on common land (rare today), permanent housing, housing only in winter, or a semi-extensive regime.") },
      { b: "Maronesa", slug: "maronesa", p: T("Semiestabulação e pastoreio nos adultos; estabulação permanente, com alimentação à manjedoura, nos jovens.", "Part-housing and grazing for adults; permanent housing with manger feeding for the young.") },
      { b: "Alentejana", slug: "alentejana", p: T("Clima continental, pouca chuva e verões secos: as pastagens pobres moldaram um animal robusto. A Carnalentejana DOP cobre os distritos de Beja, Évora e Portalegre e concelhos vizinhos.", "Continental climate, little rain and dry summers: poor pastures shaped a robust animal. Carnalentejana PDO covers the districts of Beja, Évora and Portalegre and neighbouring municipalities.") },
      { b: "Marinhoa", slug: "marinhoa", p: T("O sistema mais tradicional é o intensivo ao ar livre: pastagem alguns meses por ano e regresso diário ao estábulo.", "The most traditional system is intensive outdoors: pasture for some months a year and a daily return to the barn.") },
    ],
    maybe: [T("Falta documentar a dimensão média das explorações e o peso dos sistemas intensivos de leite.", "Still to document: average farm size and the weight of intensive dairy systems.")],
    links: [L(T("Carne Barrosã DOP", "Carne Barrosã PDO"), BARROSA), L("Carnalentejana DOP", CARNAL), L(T("Catálogo DGAV/CAP", "DGAV/CAP catalogue"), CAT)] },
  { id: "alimentacao", t: T("Alimentação", "Feeding"), img: "mirandesa-pasto",
    general: [T("A base da dieta é a erva: fresca no pasto, ou conservada em feno ou silagem para as épocas secas e frias. Os alimentos compostos (cereais, proteaginosas) completam a dieta quando o pasto não chega. A alimentação influencia a cor da gordura e o sabor da carne.", "The basis of the diet is grass: fresh at pasture, or preserved as hay or silage for dry and cold seasons. Compound feeds (cereals, protein crops) complete the diet when pasture falls short. Feeding influences fat colour and meat flavour.")],
    ex: [
      { b: "Arouquesa", slug: "arouquesa", p: T("Vive de pastos pobres da serra e de rebentos de tojo, carqueja, giesta e carvalho.", "It lives on poor mountain pasture and shoots of gorse, heather, broom and oak.") },
      { b: "Mirandesa", slug: "mirandesa", p: T("Depois do desmame, os vitelos são engordados com fenos e cereais da própria exploração.", "After weaning, calves are fattened on hay and cereals from the farm itself.") },
      { b: "Marinhoa", slug: "marinhoa", p: T("Pastagens naturais ou semeadas, complementadas com cereais, palhas e leguminosas.", "Natural or sown pastures, supplemented with cereals, straw and legumes.") },
    ],
    maybe: [], links: [L(T("Catálogo DGAV/CAP", "DGAV/CAP catalogue"), CAT)] },
  { id: "transporte", t: T("Transporte", "Transport"), img: "mertolenga-tejo",
    general: [T("Os animais vivos seguem para o matadouro ou para outra exploração em camiões licenciados, com regras europeias sobre duração, descanso, água, espaço e aptidão dos animais (Regulamento (CE) n.º 1/2005). Nas ilhas, o transporte pode incluir uma viagem marítima.", "Live animals travel to the abattoir or another farm in licensed vehicles, under European rules on duration, rest, water, space and fitness of the animals (Regulation (EC) No 1/2005). On islands the journey may include a sea crossing.")],
    ex: [
      { b: "Minhota", slug: "minhota", p: T("O catálogo aponta a exportação para Espanha, que absorve grande parte da produção, como um dos motivos da recuperação dos bois castrados.", "The catalogue points to exports to Spain, which absorbs much of the output, as one reason for the recovery of castrated oxen.") },
    ],
    maybe: [T("Por documentar: os percursos concretos até ao matadouro em cada região e o envio de bovinos entre ilhas ou para o continente. Os dados de comércio de bovinos vivos entre Portugal e Espanha estão no Observatório.", "To document: the actual routes to the abattoir in each region and shipping cattle between islands or to the mainland. Data on live cattle trade between Portugal and Spain is in the Observatory.")],
    links: [L(T("Regulamento (CE) n.º 1/2005", "Regulation (EC) No 1/2005"), eur("32005R0001")), L(T("Observatório", "Observatory"), href(lang, "observatorio/"))] },
  { id: "abate", t: T("Abate", "Slaughter"), img: "bife-rump",
    general: [T("O abate faz-se em matadouros licenciados, com inspeção veterinária e regras de bem-estar no atordoamento e na sangria (Regulamento (CE) n.º 1099/2009). Daqui em diante já não se fala de animais vivos mas de carcaças: a unidade passa a ser o peso de carne, não a cabeça de gado.", "Slaughter takes place in licensed abattoirs, with veterinary inspection and welfare rules for stunning and bleeding (Regulation (EC) No 1099/2009). From here on we no longer speak of live animals but of carcasses: the unit becomes weight of meat, not head of cattle.")],
    ex: [
      { b: "Minhota", slug: "minhota", p: T("O catálogo refere vitelas vendidas em média aos 6,2 meses, com carcaças de peso médio de 149,6 kg, e bois castrados abatidos normalmente depois dos três anos.", "The catalogue reports veal sold at an average of 6.2 months, with an average carcass weight of 149.6 kg, and castrated oxen normally slaughtered after three years.") },
      { b: "Barrosã e Alentejana", p: T("A Carne Barrosã DOP e a Carnalentejana DOP seguem as condições de abate e de desmancha dos respetivos cadernos de especificações.", "Carne Barrosã PDO and Carnalentejana PDO follow the slaughter and cutting conditions in their specification documents.") },
    ],
    maybe: [T("Por documentar: a rede de matadouros e os volumes por região.", "To document: the abattoir network and volumes by region.")],
    links: [L(T("Regulamento (CE) n.º 1099/2009", "Regulation (EC) No 1099/2009"), eur("32009R1099")), L(T("Abates no Observatório", "Slaughter data in the Observatory"), href(lang, "observatorio/"))] },
  { id: "classificacao", t: T("Classificação", "Grading"), img: "carne-madeira", extra: "classificacao",
    general: [T("Depois do abate, a carcaça é classificada por um classificador oficial segundo a escala europeia SEUROP: uma letra para a conformação (a forma e o desenvolvimento muscular) e um número de 1 a 5 para a cobertura de gordura (Regulamento (UE) n.º 1308/2013). A classificação é a base do preço pago ao produtor.", "After slaughter the carcass is graded by an official classifier on the European SEUROP scale: a letter for conformation (shape and muscle development) and a number from 1 to 5 for fat cover (Regulation (EU) No 1308/2013). Grading is the basis of the price paid to the producer.")],
    ex: [
      { b: "Minhota", slug: "minhota", p: T("O catálogo refere que 52,5 % dos abates de animais Minhotos dão carcaças de categoria V (animais com menos de 8 meses).", "The catalogue states that 52.5% of Minhota slaughters give category V carcasses (animals under 8 months).") },
    ],
    maybe: [], links: [L(T("Regulamento (UE) n.º 1308/2013", "Regulation (EU) No 1308/2013"), eur("32013R1308"))] },
  { id: "desmancha", t: T("Desmancha", "Cutting"), img: "carne-cortes", extra: "cuts",
    general: [T("A carcaça arrefece e matura em câmara; depois é dividida em quartos, peças e cortes. É aqui que a mesma vaca dá o lombo, a vazia, o acém ou a carne para estufar, e se decide o que vai para bife e o que vai para guisado ou carne picada. Os nomes dos cortes variam de região para região; o esquema usa uma nomenclatura comum e está em revisão.", "The carcass chills and ages in a cold room; it is then divided into quarters, primals and cuts. This is where one animal gives the loin, flank, chuck or stewing meat, and where it is decided what becomes steak and what becomes stew or mince. Cut names vary from region to region; the diagram uses a common nomenclature and is under review.")],
    ex: [
      { b: "Carnalentejana", p: T("Além da carne fresca, a DOP tem linhas embaladas de carne picada, almôndegas e hambúrgueres.", "Besides fresh meat, the PDO has packaged lines of mince, meatballs and burgers.") },
    ],
    maybe: [], links: [L(T("Guia de cortes", "Cuts guide"), href(lang, "carne/03-cortes/")), L(T("Maturação", "Ageing"), href(lang, "carne/02-maturacao/"))] },
  { id: "distribuicao", t: T("Distribuição", "Distribution"), img: "carne-variedade",
    general: [T("A carne chega ao consumidor por talhos, supermercados, restauração e venda direta. A rotulagem da carne de bovino é obrigatória e inclui o número de identificação do animal ou do lote, o país de nascimento, de criação e de abate, e o número de aprovação do matadouro e do centro de corte (Regulamento (CE) n.º 1760/2000).", "Beef reaches the consumer through butchers, supermarkets, restaurants and direct sales. Beef labelling is mandatory and includes the animal or batch reference, the country of birth, rearing and slaughter, and the approval number of the abattoir and cutting plant (Regulation (EC) No 1760/2000).")],
    ex: [
      { b: "Barrosã", slug: "barrosa", p: T("A Carne Barrosã DOP tem como entidade produtora indicada a CAPOLIB, a cooperativa agrícola de Boticas.", "Carne Barrosã PDO lists CAPOLIB, the Boticas agricultural cooperative, as its producer.") },
    ],
    maybe: [T("Por documentar: o comércio entre regiões e para o estrangeiro, para além dos dados do Observatório.", "To document: trade between regions and abroad, beyond the Observatory data.")],
    links: [L(T("Regulamento (CE) n.º 1760/2000", "Regulation (EC) No 1760/2000"), eur("32000R1760")), L(T("Comércio de carne no Observatório", "Meat trade in the Observatory"), href(lang, "observatorio/"))] },
  { id: "consumidor", t: T("Consumidor", "Consumer"), img: "bife-prato",
    general: [T("No fim do percurso, o rótulo e a denominação dizem de onde vem a carne. Cozinhar bem uma boa peça é a última etapa: ponto, descanso e corte decidem o resultado tanto como a raça.", "At the end of the route, the label and designation say where the meat comes from. Cooking a good cut well is the last stage: doneness, resting and slicing decide the result as much as the breed.")],
    ex: [
      { b: "Mirandesa", slug: "mirandesa", p: T("A posta mirandesa é o prato que dá fama à raça.", "The posta mirandesa is the dish that gives the breed its fame.") },
    ],
    maybe: [T("Por documentar: pontos de venda atuais das carnes DOP.", "To document: current points of sale for PDO meats.")],
    links: [L(T("Cozedura", "Cooking"), href(lang, "carne/04-cozedura/")), L(T("Servir", "Serving"), href(lang, "carne/05-servir/")), L(T("Raças", "Breeds"), href(lang, "racas/"))] },
];
---
<Base lang={lang} overlay title={T("Da Terra à Mesa", "From Land to Table")} description={T("As nove etapas do percurso do bovino e da carne em Portugal, do nascimento ao consumidor, com exemplos de várias raças e regiões.", "The nine stages of the journey of cattle and beef in Portugal, from birth to consumer, with examples from several breeds and regions.")}>
  <header class="hero ph-hero">
    <Img id="mirandesa-pasto" sizes="100vw" eager lang={lang} class="bg" />
    <div class="hero-in">
      <span class="eyebrow">{T("Do Minho ao Algarve e às ilhas", "From the Minho to the Algarve and the islands")}</span>
      <h1>{T("Da Terra à Mesa", "From Land to Table")}</h1>
      <p>{T("Uma viagem pela vida do animal, pelo trabalho de quem o cria e pelo caminho que a carne percorre até chegar à mesa.", "Follow the animal’s life, the people who raise it, and the journey of beef to the table.")}</p>
      <a class="cue-link" href="#etapas">{T("Ver as etapas ↓", "See the stages ↓")}</a>
    </div>
  </header>
  <section class="sec" id="etapas"><div class="narrow" style="width:min(1060px,100% - 40px)">
    <p class="journey-lead">{T("Percorra as nove etapas pela ordem natural. Em cada uma, descubra o essencial primeiro e aprofunde apenas se quiser.", "Follow the nine stages in their natural order. Start with the essentials and explore further when you wish.")}</p>
    <nav class="stepnav" aria-label={T("Etapas", "Stages")}>{stages.map((s, i) => <a href={`#${s.id}`}><span>{String(i + 1).padStart(2, "0")}</span>{s.t}</a>)}</nav>
    <div class="legend" style="display:none">
      <span class="chip ok">{T("Documentado", "Documented")}</span> {T("com fonte, ligada no fim do bloco.", "with a source, linked at the end of the block.")}
      <span class="chip wait">{T("Possível / por documentar", "Possible / to document")}</span> {T("hipótese plausível que ainda não confirmámos; não é afirmação.", "a plausible hypothesis we have not confirmed; it is not a claim.")}
    </div>
    {stages.map((s, i) => (
      s.extra === "classificacao" ? (
      <article class="stg stg-wide" id={s.id}>
        <div class="stg-body">
          <span class="eyebrow">{T("Etapa", "Stage")} {i + 1} / 9 · {s.t}</span>
          <h2>{T("Como saber se estamos a comprar boa carne?", "How do we know we are buying good meat?")}</h2>
          <p class="lead">{T("Da etiqueta do supermercado à classificação das carcaças: aprende a interpretar a informação e a escolher carne com mais confiança.", "From the supermarket label to carcass grading: learn to read the information and choose meat with more confidence.")}</p>
          <Classificacao lang={lang} />
          {s.ex.length > 0 && <details class="stage-detail"><summary>{T("Exemplos e histórias das raças", "Breed examples and stories")}</summary>
            <h3>{T("Exemplos", "Examples")}</h3>
            <ul class="exs">{s.ex.map((e) => <li><strong>{e.slug ? <a href={href(lang, `racas/${e.slug}/`)}>{e.b}</a> : e.b}</strong> — {e.p}</li>)}</ul>
          </details>}
          <p class="links"><strong>{T("Saber mais", "Learn more")}:</strong> {s.links.map((x, n) => <>{n > 0 && " · "}<a href={x.u} rel={x.u.startsWith("http") ? "noopener" : undefined}>{x.l}{x.u.startsWith("http") ? " ↗" : ""}</a></>)}</p>
        </div>
      </article>
      ) : (
      <article class={s.extra === "cuts" ? "stg stg-wide" : "stg"} id={s.id}>
        <div class="stg-fig">{s.img && (credits as Record<string, any>)[s.img] && <figure class="frame"><Img id={s.img} sizes="(max-width:900px) 100vw, 420px" credit lang={lang} /></figure>}</div>
        <div class="stg-body">
          <span class="eyebrow">{T("Etapa", "Stage")} {i + 1} / 9</span>
          <h2>{s.t}</h2>

          {s.general.map((p) => <p>{p}</p>)}
          {s.id === "criacao" && <p class="guardioes-link"><a href={href(lang, "guardioes-da-terra/")}>{T("Por trás de cada animal há um criador. Conheça os Guardiões da Terra →", "Behind every animal there is a farmer. Meet the Guardians of the Land →")}</a></p>}
          {s.extra === "cuts" && <CortesViewer lang={lang} />}
          {s.ex.length > 0 && <details class="stage-detail"><summary>{T("Exemplos de raças", "Breed examples")}</summary>
            <h3>{T("Exemplos", "Examples")}</h3>
            <ul class="exs">{s.ex.map((e) => <li><strong>{e.slug ? <a href={href(lang, `racas/${e.slug}/`)}>{e.b}</a> : e.b}</strong> — {e.p}</li>)}</ul>
          </details>}
          {s.maybe.length > 0 && <div class="maybe"><span class="chip wait">{T("Possível / por documentar", "Possible / to document")}</span>{s.maybe.map((p) => <p>{p}</p>)}</div>}
          <p class="links"><strong>{T("Saber mais", "Learn more")}:</strong> {s.links.map((x, n) => <>{n > 0 && " · "}<a href={x.u} rel={x.u.startsWith("http") ? "noopener" : undefined}>{x.l}{x.u.startsWith("http") ? " ↗" : ""}</a></>)}</p>
        </div>
      </article>
      )
    ))}
    <aside class="note">
      <h2>{T("Animais vivos ou carne?", "Live animals or meat?")}</h2>
      <p>{T("Quando se fala de «bovinos abatidos» conta-se por cabeças; quando se fala de «carne produzida» conta-se por toneladas de peso de carcaça. Os dois números não se somam nem se comparam diretamente: um animal mais pesado dá mais carne com o mesmo número de cabeças. No Observatório, cada série indica a unidade e o período.", "When we say «cattle slaughtered» we count heads; when we say «meat produced» we count tonnes of carcass weight. The two numbers cannot be added or compared directly: a heavier animal gives more meat for the same number of heads. In the Observatory each series states its unit and period.")}</p>
      <p><a class="btn" href={href(lang, "observatorio/")}>{T("Ver os dados no Observatório →", "See the data in the Observatory →")}</a> <a class="btn ghost" style="color:var(--green-deep)!important" href={href(lang, "racas/")}>{T("Conhecer as 15 raças →", "Meet the 15 breeds →")}</a></p>
      <p class="small">{T("Regra deste site: só publicamos como confirmado o que tem fonte, unidade e período. Texto de enquadramento geral (processos e regulamentos) está assinalado como tal e ligado à legislação; as versões dos diplomas consultadas devem ser confirmadas na fonte oficial antes de qualquer uso profissional.", "Rule of this site: we only publish as confirmed what has a source, unit and period. General framing text (processes and regulations) is marked as such and linked to the legislation; the versions of the acts consulted should be checked at the official source before any professional use.")}</p>
    </aside>
  </div></section>
</Base>
<style is:global>
  .journey-lead{font-size:1.15rem;line-height:1.8;max-width:670px;margin:0 0 2.5rem}.stage-detail{margin-top:1.5rem;padding:1rem 1.3rem;border:1px solid var(--line);border-radius:14px}.stage-detail summary{cursor:pointer;font-weight:650}.maybe{margin-top:1rem;opacity:.85}.stepnav{display:flex!important;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:12px}.stepnav a{flex:0 0 auto;scroll-snap-align:start;min-width:110px}.stg{padding:clamp(3rem,7vw,7rem) 0!important;gap:clamp(2rem,5vw,5rem)!important}.stg-body>p{line-height:1.85}.stg-body h2{font-size:clamp(2.1rem,3.6vw,3.5rem)}
  .ph-hero { position: relative; min-height: 62vh; display: grid; align-items: end; color: #fff; overflow: hidden; background: var(--green-deep); }
  .ph-hero .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.65)); }
  .ph-hero .hero-in { position: relative; z-index: 1; width: min(1060px, 100% - 40px); margin: 0 auto; padding: 140px 0 56px; }
  .ph-hero h1 { color: #fff; margin: .2em 0; } .ph-hero p { max-width: 62ch; font-weight: 300; font-size: 1.15rem; }
  .stepnav { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-bottom: 1.4rem; }
  .stepnav a { text-decoration: none; padding: 10px 12px; border-radius: 12px; background: var(--green-soft); color: var(--green-deep); font-weight: 500; font-size: .92rem; display: grid; gap: 2px; }
  .stepnav a span { font-size: .72rem; opacity: .65; }
  .legend { font-size: .9rem; margin: 0 0 2.4rem; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .stg { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 36px; padding: 44px 0; border-top: 1px solid var(--line); scroll-margin-top: 90px; }
  .stg-fig .frame { aspect-ratio: 4/5; position: sticky; top: 100px; margin: 0; }
  .stg-fig .frame img { width: 100%; height: 100%; object-fit: cover; }
  .stg-body h3 { font-size: 1rem; margin: 1.4em 0 .4em; color: var(--muted); font-weight: 500; }
  .exs { padding-left: 1.1em; } .exs li { margin-bottom: .6em; }
  .maybe { margin-top: 1rem; padding: 14px 16px; border-radius: 14px; background: var(--ivory-2); border: 1px dashed var(--gold); }
  .links { margin-top: 1.2rem; font-size: .92rem; }
  .guardioes-link { margin: 1.4rem 0 0; padding-left: .9em; border-left: 2px solid var(--gold); font-style: italic; }
  .guardioes-link a { color: var(--green-deep); text-decoration-thickness: 1px; text-underline-offset: .3em; }
  .note { margin-top: 3rem; padding: 28px; background: #fff; border: 1px solid var(--line); border-radius: 20px; }
  .note .small { font-size: .85rem; color: var(--muted); }
