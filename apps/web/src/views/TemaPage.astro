---
import Base from "../layouts/Base.astro";
import Img from "../components/proto/Img.astro";
import Myoglobin from "../components/diagrams/Myoglobin.astro";
import CortesViewer from "../components/diagrams/CortesViewer.astro";
import Classificacao from "../components/diagrams/Classificacao.astro";
import credits from "../data/images.json";
import { marked } from "marked";
import { href, licenseLabel, tr, type Lang } from "../i18n";
interface Props { lang: Lang; d: any; prev?: any; next?: any }
const { lang, d, prev, next } = Astro.props;
const T = tr(lang);
const prato = d.data.parent === "prato";
const root = prato ? "da-pastagem-ao-prato/" : "carne/";
const hubName = prato ? "Da Terra à Mesa" : "A carne";
const has = (id?: string) => !!id && !!(credits as Record<string, any>)[id];
const cr = (id: string) => (credits as Record<string, any>)[id];
const md = (t: string) => marked.parse(t) as string;
const N = d.data.scenes.length;
const OWN = ["nascimento", "criacao", "alimentacao", "transporte"]; // capas de paisagem/animais: servem de fundo
const POOL = ["carne-capa", "criacao-capa", "montado-pasto", "transporte-capa", "prato-capa", "mirandesa-pasto", "hero-alentejo", "alimentacao-capa", "mertolenga-tejo", "nascimento-capa"];
const slugs: string[] = [];
const idx = Math.max(0, ["cor","gordura","fibra","como-comprar","cortes","maturacao","pontos","crosta","sal","descanso","tecnicas","servir","vinhos","abate","classificacao","desmancha","distribuicao","consumidor"].indexOf(d.id));
const ownBg = OWN.includes(d.id) && has(d.data.photo);
const bgId = ownBg ? d.data.photo : POOL[idx % POOL.length];
const capaFig = !ownBg && has(d.data.photo) ? d.data.photo : null;
const capaIdx = capaFig ? d.data.scenes.findIndex((x: any) => !(x.fig ?? x.photo)) : -1;
const wide = (s: any) => !!s.diagram || /\n\|/.test(s.text) || s.text.startsWith("|");
const num = String(d.data.order).padStart(2, "0");
const bgCredit = has(bgId) && !cr(bgId).ai ? cr(bgId) : null;
---
<Base lang={lang} overlay title={d.data.title} description={d.data.lead} enPath={href("en", root)}>
  <div class="tp-fixed" aria-hidden="true">{has(bgId) && <Img id={bgId} sizes="100vw" eager lang={lang} class="tp-fbg" />}</div>
  <div class="tp-page">
    <header class="tp-top">
      <div class="tp-top-in">
        <div class="tp-top-txt">
          <a class="tp-back" href={href(lang, root)}>← {hubName}</a>
          <span class="tp-k">{prato ? d.data.kicker : `${d.data.kicker} · ${num}`}</span>
          <h1>{d.data.title}</h1>
          <p class="tp-lead">{d.data.lead}</p>
        </div>
      </div>
    </header>
    <div class="tp-hook"><span>{T("A pergunta", "The question")}</span><p>{d.data.hook}</p></div>
    {d.data.scenes.map((s: any, i: number) => {
      const fid = s.fig ?? s.photo ?? (i === capaIdx ? capaFig : null);
      return (
        <section class="tp-s">
          <div class:list={["tp-card", fid && "has-fig", wide(s) && "is-wide"]}>
            <div class="tp-txt"><span class="tp-n">{i + 1} / {N}</span><h2>{s.title}</h2><div class="tp-md" set:html={md(s.text)} /></div>
            {fid && (has(fid) ? <figure class="tp-ph"><Img id={fid} sizes="(min-width:900px) 420px, 100vw" flat lang={lang} />{s.fig && <figcaption>{cr(fid).caption}</figcaption>}</figure> : <figure class="tp-ph tp-slot"><div class="tp-slotlabel"><b>FOTO · CENA</b> {fid}</div></figure>)}
            {s.diagram && <div class="tp-diag-in">
              {s.diagram === "myoglobin" && <Myoglobin lang={lang} />}
              {s.diagram === "cuts" && <CortesViewer lang={lang} />}
              {s.diagram === "classificacao" && <Classificacao lang={lang} />}
            </div>}
          </div>
        </section>
      );
    })}
    <section class="tp-s"><div class="tp-card tp-end">
      {d.data.note && <p class="tp-note"><b>{T("Estado do texto", "Status")}:</b> {d.data.note}</p>}
      {d.data.sources.length > 0 && <><h3>{T("Fontes", "Sources")}</h3><ul>{d.data.sources.map((s: any) => <li>{s.url ? <a href={s.url} rel="noopener">{s.label}</a> : s.label}</li>)}</ul></>}
      {bgCredit && <p class="tp-bgc">{T("Imagem de fundo", "Background image")}: {bgCredit.caption} · {T("Foto", "Photo")}: <a href={bgCredit.source_page} rel="noopener">{bgCredit.author}</a> · {licenseLabel(lang, bgCredit.license)}</p>}
    </div></section>
    <section class="tp-s tp-nx"><a class="tp-card tp-next" href={next ? href(lang, `${root}${next.id}/`) : href(lang, root)}><span>{next ? T("Seguinte", "Next") : T("Voltar a", "Back to")}</span><strong>{next ? next.data.title : hubName} →</strong></a></section>
  </div>
</Base>
<script is:inline>if(/[?&]fotos/.test(location.search))document.documentElement.classList.add("show-slots");</script>
<style is:global>
  /* Fundo: paisagem fixa (sem carne). Conteúdo em painéis sobre ela; fotos de carne pequenas, junto ao texto. */
  .tp-fixed{position:fixed;inset:0;z-index:0;background:#111a15}
  .tp-fixed .tp-fbg{width:100%;height:100%;object-fit:cover;filter:brightness(.72) saturate(.9)}
  .tp-fixed::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,9,7,.35),rgba(6,9,7,.15) 40%,rgba(6,9,7,.4))}
  .tp-page{position:relative;z-index:1;color:#ece8da;--tp-mute:#b6c8ad;--tp-line:rgba(255,255,255,.2)}
  .tp-top{min-height:88svh;display:flex;align-items:flex-end;padding:8rem 1.5rem clamp(3rem,8vh,5rem)}
  .tp-top-in{width:min(72rem,100%);margin:0 auto;display:grid;grid-template-columns:1fr;gap:2rem;align-items:end}
  .tp-top h1{font-size:clamp(2.8rem,6.5vw,6rem);line-height:1.02;letter-spacing:-.04em;margin:.2em 0 .3em;color:#fff;font-weight:300;text-shadow:0 2px 30px rgba(0,0,0,.4)}
  .tp-lead{font-size:clamp(1.15rem,1.6vw,1.5rem);font-weight:300;max-width:34ch;line-height:1.5;margin:0;text-shadow:0 1px 18px rgba(0,0,0,.5)}
  .tp-k{font-size:.8rem;letter-spacing:.22em;text-transform:uppercase;color:#dfe9d2}
  .tp-back{display:block;color:#dfe9d2!important;margin-bottom:1.4rem;text-decoration:none;font-size:.9rem}
  .tp-hook{text-align:center;padding:clamp(2rem,6vh,4rem) 1.5rem clamp(2rem,6vh,4rem);text-shadow:0 1px 20px rgba(0,0,0,.5)}
  .tp-hook span{font-size:.75rem;letter-spacing:.22em;text-transform:uppercase;color:var(--tp-mute)}
  .tp-hook p{font:300 clamp(1.9rem,4vw,3.2rem)/1.15 var(--display);letter-spacing:-.03em;margin:.7rem auto 0;max-width:20ch;color:#fff}
  .tp-s{padding:clamp(1rem,3vh,2rem) clamp(.75rem,3vw,2rem)}
  .tp-card{margin:0 auto;width:min(46rem,100%);background:rgba(10,15,11,.66);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);padding:clamp(1.5rem,3vw,2.8rem);border-left:1px solid rgba(255,255,255,.22);display:grid;grid-template-columns:minmax(0,1fr);gap:1.6rem 2.5rem;align-items:start}
  .tp-card.has-fig{width:min(66rem,100%)}.tp-card.is-wide{width:min(74rem,100%)}
  @media(min-width:900px){.tp-card.has-fig{grid-template-columns:minmax(0,1fr) minmax(0,24rem)}.tp-top-in:has(.tp-ph){grid-template-columns:minmax(0,1fr) minmax(0,24rem)}.tp-card .tp-diag-in{grid-column:1/-1}}
  .tp-n{font-size:.8rem;letter-spacing:.2em;color:var(--tp-mute);display:block}
  .tp-card h2{font-size:clamp(1.8rem,2.8vw,2.8rem);line-height:1.12;letter-spacing:-.03em;margin:.5rem 0 1.1rem;color:#fff;font-weight:300}
  .tp-md{font-size:clamp(1.05rem,.9vw + .6rem,1.3rem);line-height:1.8;font-weight:400}
  .tp-md p{margin:0 0 1em}.tp-md ul,.tp-md ol{padding-left:1.2em;margin:0 0 1em}.tp-md li{margin-bottom:.5em}.tp-md a,.tp-end a{color:#bcd9a8;text-decoration:underline}.tp-md strong{color:#fff}
  .tp-md table{width:100%;border-collapse:collapse;font-size:.98rem;margin:1rem 0;display:block;overflow-x:auto}.tp-md th,.tp-md td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--tp-line);vertical-align:top;min-width:110px}.tp-md th{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--tp-mute)}
  .tp-ph{margin:0}.tp-ph img{display:block;width:100%;height:auto;border-radius:3px}.tp-ph figcaption{font-size:.85rem;color:var(--tp-mute);margin-top:.6rem}
  .tp-slot{display:none;aspect-ratio:3/2;background:rgba(255,255,255,.08);position:relative}html.show-slots .tp-slot{display:block}
  .tp-slotlabel{display:none;position:absolute;right:1.5rem;top:6rem;z-index:3;border:2px dashed rgba(255,255,255,.75);padding:.8rem 1rem;font:500 .8rem/1.5 ui-monospace,monospace;color:#fff;background:rgba(0,0,0,.35)}html.show-slots .tp-slotlabel{display:block}.tp-slot .tp-slotlabel{top:1rem;left:1rem;right:auto}
  .tp-diag-in{background:#f3efe4;color:#263e30;padding:clamp(1.2rem,3vw,2.4rem);border-radius:6px}
  .tp-card .tp-diag-in h2,.tp-card .tp-diag-in h3,.tp-card .tp-diag-in h4{color:#1f3326;font-weight:600;letter-spacing:-.01em}
  .tp-card .tp-diag-in h2{font-size:clamp(1.4rem,2.2vw,2rem);margin:.4rem 0 .8rem}
  .tp-diag-in a{color:#2f6b3f}
  .tp-diag-in .fr{max-width:40rem}.tp-diag-in .fr.two{gap:12px;background:none;aspect-ratio:auto;overflow:visible}.tp-diag-in .fr.two img{height:auto;aspect-ratio:4/3;border-radius:8px}
  .tp-end{font-size:.92rem;line-height:1.6;color:var(--tp-mute)}.tp-end h3{font-size:.8rem;letter-spacing:.15em;text-transform:uppercase;color:var(--tp-mute);margin:1rem 0 .4rem}.tp-bgc{font-size:.8rem;margin-top:1rem}
  .tp-nx{padding-bottom:clamp(3rem,8vh,5rem)}.tp-next{display:block;text-align:center;text-decoration:none;color:#fff!important}
  .tp-next span{display:block;font-size:.8rem;letter-spacing:.22em;text-transform:uppercase;color:var(--tp-mute)}.tp-next strong{font:300 clamp(1.8rem,4vw,3rem) var(--display)}
  @media(min-width:2200px){.tp-md{font-size:1.45rem}.tp-card{width:min(56rem,100%)}.tp-card.has-fig{width:min(80rem,100%)}.tp-card.is-wide{width:min(90rem,100%)}.tp-top-in{width:min(90rem,100%)}}
  @media(max-width:760px){.tp-top{min-height:78svh}}
</style>
