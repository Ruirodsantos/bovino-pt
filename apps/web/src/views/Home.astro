---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Photo from "../components/Photo.astro";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const doors = [
  { p: "da-pastagem-ao-prato/", img: "terceira", t: T("Da pastagem ao prato", "Pasture to plate"), d: T("Do nascimento ao consumidor", "From birth to consumer") },
  { p: "carne/", img: "carne-variedade", t: T("Carne portuguesa", "Portuguese beef"), d: T("Cortes, maturação, qualidade", "Cuts, ageing, quality") },
  { p: "racas/", img: "barrosa", t: T("As 15 raças", "The 15 breeds"), d: T("Fotografias, solares, história", "Photographs, homelands, history") },
  { p: "aprender/", img: "outono-castanheiros", t: T("Aprender", "Learn"), d: T("Dados, descobertas, método", "Data, discoveries, method") },
];
---
<Base lang={lang} home overlay title={T("Início", "Home")} image={`${import.meta.env.BASE_URL}img/cachena-retrato-lg.webp`}
  description={T("As 15 raças bovinas autóctones de Portugal, a carne e o caminho da pastagem ao prato, com fontes oficiais.", "Portugal's 15 native cattle breeds, the meat and the path from pasture to plate, with official sources.")}>
  <Scene id="cachena-retrato" lang={lang} h1 eager pos="50% 40%" kicker={T("Atlas do Bovino Português", "Portuguese Beef Atlas")}
    title={T("Descubra o Bovino Português", "Discover Portuguese Cattle")}
    text={T("As 15 raças autóctones, a carne e o caminho da pastagem ao prato.", "The 15 native breeds, the meat and the path from pasture to plate.")}
    cue="#racas" />
  <div id="racas"></div>
  <Scene id="mertolenga-tejo" lang={lang} pos="50% 60%" kicker={T("Baixo Alentejo", "Lower Alentejo")} title="Mertolenga"
    text={T("O boi de cabresto que se tornou raça.", "The halter-led ox that became a breed.")} href={href(lang, "racas/mertolenga/")} linkText={T("Conhecer a raça", "Meet the breed")} />
  <Scene id="barrosa" lang={lang} pos="50% 30%" kicker={T("Barroso", "Barroso")} title="Barrosã"
    text={T("A raça de grandes cornos em lira, do planalto do Barroso.", "The breed with great lyre-shaped horns, from the Barroso plateau.")} href={href(lang, "racas/barrosa/")} linkText={T("Conhecer a raça", "Meet the breed")} />
  <Scene id="alentejana-silves" lang={lang} pos="50% 55%" kicker={T("Alentejo", "Alentejo")} title="Alentejana"
    text={T("Uma raça moldada pelo calor e pela pobreza das pastagens do Sul.", "A breed shaped by the heat and the poor pastures of the South.")} href={href(lang, "racas/alentejana/")} linkText={T("Conhecer a raça", "Meet the breed")} />
  <Scene id="maronesa-alvao" lang={lang} pos="50% 60%" kicker={T("Serras do Alvão e do Marão", "Alvão and Marão mountains")} title="Maronesa"
    text={T("A «Serrana» das serras do Alvão e do Marão.", "The «Serrana» of the Alvão and Marão mountains.")} href={href(lang, "racas/maronesa/")} linkText={T("Conhecer a raça", "Meet the breed")} />
  <Scene id="carne-cortes" lang={lang} kicker={T("A carne", "The meat")} title={T("Da pastagem ao prato", "From pasture to plate")}
    text={T("Como se cria, como se abate, como se corta e como se serve.", "How it is raised, slaughtered, cut and served.")} href={href(lang, "da-pastagem-ao-prato/")} linkText={T("Seguir o percurso", "Follow the journey")} />
  <section class="doors">
    <div class="wrap">
      <h2>{T("Por onde começar", "Where to start")}</h2>
      <div class="door-grid">
        {doors.map((d) => (
          <a class="door reveal" href={href(lang, d.p)}>
            <Photo id={d.img} sizes="(max-width: 700px) 100vw, 25vw" caption={false} lang={lang} />
            <span class="dt"><strong>{d.t}</strong><span>{d.d}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .doors { padding: clamp(56px, 9vw, 110px) 0; background: var(--paper); }
  .door-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); margin-top: 24px; }
  .door { position: relative; display: block; aspect-ratio: 4/5; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; background: #1c1714; }
  .door :global(.photo) { position: absolute; inset: 0; }
  .door :global(img) { transition: transform .8s ease; }
  .door:hover :global(img) { transform: scale(1.06); }
  .door::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,.75)); }
  .dt { position: absolute; z-index: 1; left: 18px; right: 18px; bottom: 16px; display: grid; gap: 2px; }
  .dt strong { font: 500 1.25rem var(--display); }
  .dt span { font-size: .85rem; color: rgba(255,255,255,.85); }
</style>
