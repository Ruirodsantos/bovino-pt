---
import Base from "../layouts/Base.astro";
import Img from "../components/proto/Img.astro";
import credits from "../data/images.json";
import { breeds, cardPhoto } from "../lib/data";
import { locImg, href, licenseLabel, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const b = import.meta.env.BASE_URL;
const h0 = (credits as any)["mertolenga-tejo"];
const hero = locImg(h0, lang);
const names = Object.fromEntries(breeds().map((x) => [x.slug, x.official_name]));
const strip = ["mirandesa", "barrosa", "maronesa", "cachena", "alentejana", "mertolenga"].map((s) => ({ slug: s, name: names[s], photo: cardPhoto(s) })).filter((s) => s.photo) as { slug: string; name: string; photo: { id: string; kind: string } }[];
const stages: [string, string, string][] = [
  [T("Nascimento", "Birth", "Nacimiento", "Naissance"), T("Tudo começa na exploração, com o vitelo junto da mãe.", "It all starts on the farm, with the calf next to its mother.", "Todo empieza en la explotación, con el ternero junto a su madre.", "Tout commence à l'exploitation, avec le veau auprès de sa mère."), T("Em várias raças os vitelos mamam durante meses antes do desmame.", "In several breeds calves suckle for months before weaning.", "En varias razas los terneros maman durante meses antes del destete.", "Dans plusieurs races, les veaux tètent pendant des mois avant le sevrage.")],
  [T("Criação", "Rearing", "Cría", "Élevage"), T("Meses ou anos no campo, conforme a raça e o sistema de produção.", "Months or years in the field, depending on breed and production system.", "Meses o años en el campo, según la raza y el sistema de producción.", "Des mois ou des années aux champs, selon la race et le système de production."), T("Cada raça tem o seu território e o seu ritmo.", "Each breed has its own territory and rhythm.", "Cada raza tiene su territorio y su ritmo.", "Chaque race a son territoire et son rythme.")],
  [T("Alimentação", "Feeding", "Alimentación", "Alimentation"), T("Pasto, forragens e, quando a erva não chega, complementos.", "Pasture, forage and, when grass is short, supplements.", "Pasto, forrajes y, cuando la hierba no alcanza, complementos.", "Pâturage, fourrages et, quand l'herbe vient à manquer, compléments."), T("Nas carnes certificadas, o caderno de especificações define o que o animal pode comer.", "For certified meats, the product specification sets what the animal may eat.", "En las carnes certificadas, el pliego de condiciones define lo que el animal puede comer.", "Pour les viandes certifiées, le cahier des charges définit ce que l'animal peut manger.")],
  [T("Transporte", "Transport", "Transporte", "Transport"), T("O animal segue para o matadouro; há também animais vivos que seguem para engorda.", "The animal goes to the slaughterhouse; live animals may also go on for fattening.", "El animal va al matadero; también hay animales vivos que siguen a engorde.", "L'animal part à l'abattoir ; certains animaux vivants partent aussi à l'engraissement."), T("Animais vivos e carne são dois negócios diferentes: um vende-se antes do abate, o outro depois.", "Live animals and meat are two different trades: one is sold before slaughter, the other after.", "Animales vivos y carne son dos negocios distintos: uno se vende antes del sacrificio, el otro después.", "Animaux vivants et viande sont deux commerces différents : l'un se vend avant l'abattage, l'autre après.")],
  [T("Abate", "Slaughter", "Sacrificio", "Abattage"), T("Feito em matadouro licenciado, sob controlo veterinário.", "Carried out in a licensed slaughterhouse under veterinary control.", "Se realiza en un matadero autorizado, bajo control veterinario.", "Réalisé dans un abattoir agréé, sous contrôle vétérinaire."), T("", "", "", "")],
  [T("Classificação", "Grading", "Clasificación", "Classement"), T("A carcaça é classificada por conformação e estado de gordura.", "The carcase is graded for conformation and fat cover.", "La canal se clasifica por conformación y estado de engrasamiento.", "La carcasse est classée selon sa conformation et son état d'engraissement."), T("É a classificação europeia SEUROP, usada em Portugal.", "This is the European SEUROP scheme, used in Portugal.", "Es la clasificación europea SEUROP, usada en Portugal.", "C'est la classification européenne SEUROP, utilisée au Portugal.")],
  [T("Desmancha", "Cutting", "Despiece", "Découpe"), T("A carcaça é dividida em peças e cortes.", "The carcase is divided into joints and cuts.", "La canal se divide en piezas y cortes.", "La carcasse est divisée en morceaux et en coupes."), T("Os cortes variam consoante o mercado e a tradição regional.", "Cuts vary with the market and regional tradition.", "Los cortes varían según el mercado y la tradición regional.", "Les coupes varient selon le marché et la tradition régionale.")],
  [T("Distribuição", "Distribution", "Distribución", "Distribution"), T("Talho, grande distribuição, restauração ou venda direta.", "Butcher, retail chain, restaurants or direct sales.", "Carnicería, gran distribución, restauración o venta directa.", "Boucherie, grande distribution, restauration ou vente directe."), T("Cada carne certificada tem rotulagem própria.", "Each certified meat has its own labelling.", "Cada carne certificada tiene su propio etiquetado.", "Chaque viande certifiée a son propre étiquetage.")],
  [T("Consumidor", "Consumer", "Consumidor", "Consommateur"), T("Chega à mesa — e, com rotulagem e rastreabilidade, é possível saber de onde vem.", "It reaches the table — and with labelling and traceability you can know where it comes from.", "Llega a la mesa — y, con etiquetado y trazabilidad, es posible saber de dónde viene.", "Elle arrive sur la table — et, grâce à l'étiquetage et à la traçabilité, on peut savoir d'où elle vient."), T("", "", "", "")],
];
---
<Base lang={lang} home overlay title={T("Início", "Home", "Inicio", "Accueil")} image={`${b}img/home-hero-ia-lg.webp`}
  description={T("As 15 raças bovinas autóctones de Portugal, a carne e o caminho da pastagem ao prato, com fontes oficiais.", "Portugal's 15 native cattle breeds, the meat and the path from pasture to plate, with official sources.", "Las 15 razas bovinas autóctonas de Portugal, la carne y el camino del pasto al plato, con fuentes oficiales.", "Les 15 races bovines autochtones du Portugal, la viande et le chemin du pâturage à l'assiette, avec des sources officielles.")}>
  <section class="hero">
    <img class="bg" src={`${b}img/home-hero-ia-lg.webp`} srcset={`${b}img/home-hero-ia-sm.webp 480w, ${b}img/home-hero-ia-md.webp 900w, ${b}img/home-hero-ia-lg.webp 1672w`} sizes="100vw" alt={T("Vacas castanhas ao nascer do sol sobre um vale com rio e aldeia", "Brown cows at sunrise above a valley with a river and village", "Vacas pardas al amanecer sobre un valle con río y aldea", "Vaches brunes au lever du soleil au-dessus d'une vallée avec rivière et village")} width="1672" height="941" fetchpriority="high" />
    <div class="wrap in">
      <span class="tag">{T("Bovino Português", "Portuguese Cattle", "Ganado bovino portugués", "Bovins portugais")}</span>
      <h1>{T("15 raças.", "15 breeds.", "15 razas.", "15 races.")}<br />{T("Um património extraordinário.", "An extraordinary heritage.", "Un patrimonio extraordinario.", "Un patrimoine extraordinaire.")}</h1>
      <a class="cue-link" href="#descobrir">{T("Começar a descobrir", "Start exploring", "Empezar a descubrir", "Commencer à découvrir")} <i aria-hidden="true">↓</i></a>
    </div>
  </section>

  <!-- Um percurso editorial sem menus repetidos: paisagem, raças, vida, carne, mesa. -->
  <section class="journey-opening" id="viagem">
    <div class="journey-opening-copy"><span class="eyebrow">{T("A terra e os animais", "Land and animals", "La tierra y los animales", "La terre et les animaux")}</span>
      <h2>{T("Cada raça conta a história de um lugar.", "Every breed tells the story of a place.", "Cada raza cuenta la historia de un lugar.", "Chaque race raconte l'histoire d'un lieu.")}</h2>
      <p>{T("Dos lameiros de Trás-os-Montes às ilhas dos Açores, a paisagem e os animais cresceram juntos. Descubra este património ao seu ritmo.", "From the northern meadows to the Azores, landscape and cattle have grown together. Discover this heritage at your own pace.", "De los prados del norte a las islas Azores, el paisaje y los animales han crecido juntos. Descubra este patrimonio a su ritmo.", "Des prairies du nord aux îles des Açores, le paysage et les animaux ont grandi ensemble. Découvrez ce patrimoine à votre rythme.")}</p>
      <a class="journey-next" href={href(lang, "racas/")}>{T("Descobrir as 15 raças →", "Discover the 15 breeds →", "Descubrir las 15 razas →", "Découvrir les 15 races →")}</a>
    </div>
    <div class="journey-opening-photo"><img src={`${b}img/mirandesa-pasto-lg.webp`} alt={T("Bovinos em pastagem portuguesa", "Cattle in a Portuguese pasture", "Bovinos en un pasto portugués", "Bovins dans un pâturage portugais")} loading="lazy" /></div>
  </section>

  <section class="journey-welfare">
    <img src={`${b}img/paisagem-alentejo-ia-lg.webp`} alt={T("Bovinos a pastar no Alentejo", "Cattle grazing in Alentejo", "Bovinos pastando en el Alentejo", "Bovins au pâturage dans l'Alentejo")} loading="lazy" />
    <div class="journey-welfare-copy"><span class="eyebrow">{T("Antes da carne, há uma vida", "Before the meat, there is a life", "Antes de la carne, hay una vida", "Avant la viande, il y a une vie")}</span>
      <h2>{T("O respeito começa no campo.", "Respect begins in the field.", "El respeto empieza en el campo.", "Le respect commence aux champs.")}</h2>
      <p>{T("Conhecer as condições de criação, o bem-estar dos animais e o trabalho dos produtores ajuda-nos a compreender o verdadeiro valor daquilo que chega à mesa.", "Understanding rearing conditions, animal welfare and farmers' work helps us appreciate what reaches the table.", "Conocer las condiciones de cría, el bienestar de los animales y el trabajo de los productores nos ayuda a comprender el verdadero valor de lo que llega a la mesa.", "Connaître les conditions d'élevage, le bien-être des animaux et le travail des éleveurs nous aide à comprendre la vraie valeur de ce qui arrive sur la table.")}</p>
      <a class="journey-next" href={href(lang, "viagem/")}>{T("Acompanhar o percurso →", "Follow the journey →", "Seguir el recorrido →", "Suivre le parcours →")}</a>
    </div>
  </section>

  <!-- Última imagem antes do rodapé: os Guardiões da Terra -->
  <section class="guardian" aria-label={T("Os Guardiões da Terra", "Guardians of the Land", "Guardianes de la Tierra", "Gardiens de la Terre")}>
    <img class="guardian-img" src={`${b}img/guardiao-ia-lg.webp`} srcset={`${b}img/guardiao-ia-sm.webp 480w, ${b}img/guardiao-ia-md.webp 900w, ${b}img/guardiao-ia-lg.webp 1536w`}
      sizes="(max-aspect-ratio: 3/2) 150vh, 100vw" width="1536" height="1024" loading="lazy" decoding="async"
      alt={T("Ilustração: pastor idoso apoiado numa vara olha para a câmara, com vacas castanhas e serras atrás", "Illustration: an elderly shepherd leaning on a staff looks at the camera, with brown cows and hills behind him", "Ilustración: un pastor anciano apoyado en un bastón mira a la cámara, con vacas pardas y sierras detrás", "Illustration : un vieux berger appuyé sur un bâton regarde la caméra, avec des vaches brunes et des collines derrière lui")} />
    <div class="guardian-in rv">
      <p class="guardian-q">«{lang === "fr" ? " " : ""}{T("Há quem passe uma vida inteira a cuidar da terra. E quem cuida deles?", "Some people spend a whole lifetime caring for the land. And who cares for them?", "Hay quien pasa toda una vida cuidando de la tierra. ¿Y quién cuida de ellos?", "Certains passent toute une vie à prendre soin de la terre. Et qui prend soin d'eux ?")}{lang === "fr" ? " " : ""}»</p>
      <a class="guardian-link" href={href(lang, "guardioes-da-terra/")}>{T("Conhecer os Guardiões da Terra →", "Meet the Guardians of the Land →", "Conocer a los Guardianes de la Tierra →", "Découvrir les Gardiens de la Terre →")}</a>
    </div>
  </section>

  <!-- Porquê este projeto: inspiração (pedido do Rui, 2026-11-03) -->
  <section class="origem" aria-labelledby="origem-t">
    <div class="origem-in rv">
      <span class="eyebrow">{T("Porquê este projeto", "Why this project", "Por qué este proyecto", "Pourquoi ce projet")}</span>
      <h2 id="origem-t">{T("Por amor aos animais, e com enorme respeito.", "For love of the animals, and with deep respect.", "Por amor a los animales, y con enorme respeto.", "Par amour des animaux, et avec un immense respect.")}</h2>
      <p>{T("Este projeto nasceu inspirado por José Gordón e pelo El Capricho, em Jiménez de Jamuz (León), e pela experiência La Cúpula: uma vida dedicada a compreender os animais, a dar-lhes tempo e liberdade, e a tratá-los com respeito do pasto à mesa.", "This project was inspired by José Gordón and El Capricho, in Jiménez de Jamuz (León), and by its La Cúpula experience: a life devoted to understanding the animals, giving them time and freedom, and treating them with respect from pasture to table.", "Este proyecto nació inspirado por José Gordón y El Capricho, en Jiménez de Jamuz (León), y por la experiencia La Cúpula: una vida dedicada a comprender a los animales, a darles tiempo y libertad, y a tratarlos con respeto del pasto a la mesa.", "Ce projet est né de l'inspiration de José Gordón et d'El Capricho, à Jiménez de Jamuz (León), et de l'expérience La Cúpula : une vie consacrée à comprendre les animaux, à leur donner du temps et de la liberté, et à les traiter avec respect du pâturage à la table.")}</p>
      <p>{T("E nasceu de uma constatação: muitos portugueses não têm noção da qualidade da carne que temos — das nossas raças autóctones, das nossas pastagens e de quem cuida delas. Queremos mostrá-la, com rigor e com cuidado.", "And it grew from a realisation: many Portuguese people have no idea of the quality of the beef we have — our native breeds, our pastures and the people who look after them. We want to show it, carefully and accurately.", "Y nació de una constatación: muchos portugueses no tienen idea de la calidad de la carne que tenemos — de nuestras razas autóctonas, de nuestros pastos y de quienes los cuidan. Queremos mostrarla, con rigor y con cuidado.", "Et il est né d'un constat : beaucoup de Portugais n'ont pas idée de la qualité de la viande que nous avons — de nos races autochtones, de nos pâturages et de ceux qui en prennent soin. Nous voulons la montrer, avec rigueur et avec soin.")}</p>
      <p class="origem-links"><a href="https://bodegaelcapricho.com/" rel="noopener" target="_blank">El Capricho ↗</a> · <a href="https://lacupuladelcapricho.com/" rel="noopener" target="_blank">La Cúpula ↗</a></p>
      <p class="origem-nota">{T("Projeto independente, sem ligação ao El Capricho.", "An independent project, not affiliated with El Capricho.", "Proyecto independiente, sin vínculo con El Capricho.", "Projet indépendant, sans lien avec El Capricho.")}</p>
    </div>
  </section>

<style>
.journey-opening{position:relative;display:flex;align-items:center;background:#111a15;color:#e9e5d6;min-height:100svh}
.journey-opening-photo{position:absolute;inset:0}.journey-opening-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,10,.6),rgba(8,12,10,0) 65%)}
.journey-opening-copy{position:relative;z-index:1;margin:clamp(4rem,8vw,8rem) clamp(1.5rem,6vw,6rem);width:min(34rem,100%);padding:clamp(1.6rem,3vw,3rem);background:rgba(10,16,12,.62);backdrop-filter:blur(14px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.journey-opening h2{color:#fff}
.journey-opening h2,.journey-welfare h2,.journey-table h2{font-size:clamp(2.4rem,4.7vw,5.2rem);line-height:1.09;letter-spacing:-.04em;margin:1.1rem 0 1.5rem}
.journey-opening p,.journey-welfare p,.journey-table p{font-size:clamp(1.02rem,1.3vw,1.22rem);line-height:1.85;max-width:560px}
.journey-next{display:inline-block;margin-top:1.8rem;color:inherit;font-weight:650;text-underline-offset:.5rem}
.journey-opening-photo,.journey-table-photo{min-height:450px;overflow:hidden}
.journey-opening-photo img,.journey-table-photo img,.journey-welfare>img{width:100%;height:100%;object-fit:cover;display:block}
.journey-welfare{position:relative;min-height:100svh;display:flex;align-items:center;color:white;background:#21382d;overflow:hidden}
.journey-welfare>img{position:absolute;inset:0;filter:brightness(.57)}
.journey-welfare-copy{position:relative;z-index:1;padding:clamp(4rem,8vw,9rem) clamp(24px,8vw,150px);width:min(100%,880px);box-sizing:border-box}.journey-welfare-copy p{max-width:54ch}.journey-welfare>img{object-position:center 45%}
.journey-table{display:grid;grid-template-columns:1.1fr 1fr;background:#243d31;color:#fff;min-height:650px}
.journey-table-copy{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:clamp(3rem,7vw,7rem)}
@media(max-width:760px){.journey-opening,.journey-table{grid-template-columns:1fr}.journey-opening{align-items:flex-end}.journey-opening-copy{margin:5rem 1rem 2.5rem;width:auto}.journey-opening-copy,.journey-table-copy{padding:3.5rem 1.5rem 4.5rem}.journey-table-photo{min-height:43vh}.journey-welfare{min-height:70vh}.journey-welfare-copy{padding:5rem 1.5rem}}
.journey-welfare .eyebrow,.journey-table .eyebrow{color:#e6efdc;text-shadow:0 1px 6px rgba(0,0,0,.55)}
.guardian{position:relative;height:100svh;min-height:540px;overflow:hidden;background:#21382d;color:#fff}
.guardian-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:38% 30%}
.guardian::before{content:"";position:absolute;inset:0 0 auto;height:22vh;z-index:1;background:linear-gradient(180deg,#21382d 0%,rgba(33,56,45,0) 100%);pointer-events:none}
.guardian::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,18,15,0) 50%,rgba(12,18,15,.62) 100%);pointer-events:none}
.guardian-in{position:absolute;z-index:2;right:clamp(20px,6vw,96px);bottom:clamp(48px,11vh,120px);width:min(34rem,44vw)}
.guardian-q{font:300 clamp(1.6rem,2.9vw,2.7rem)/1.25 var(--display);letter-spacing:-.02em;margin:0 0 1.4rem;text-shadow:0 2px 24px rgba(0,0,0,.45)}
.guardian-link{color:#fff!important;text-decoration:none;font-weight:400;letter-spacing:.02em;border-bottom:1px solid rgba(255,255,255,.55);padding-bottom:3px;transition:border-color .3s}
.guardian-link:hover{border-color:#fff}
@media (max-aspect-ratio: 1/1){.guardian-img{object-position:31% 22%}.guardian::after{background:linear-gradient(180deg,rgba(12,18,15,0) 50%,rgba(12,18,15,.78) 100%)}.guardian-in{left:20px;right:20px;width:auto;bottom:56px}.guardian-q{font-size:clamp(1.45rem,6.2vw,2rem)}}
.origem{background:#111a15;color:#e9e5d6;padding:clamp(4.5rem,10vw,9rem) 1.5rem}
.origem-in{max-width:42rem;margin:0 auto}
.origem h2{color:#fff;font-size:clamp(2rem,3.8vw,3.6rem);line-height:1.1;letter-spacing:-.03em;margin:1rem 0 1.6rem}
.origem p{font-size:clamp(1.02rem,1.25vw,1.18rem);line-height:1.85;margin:0 0 1.2rem}
.origem-links{font-weight:600;margin-top:1.6rem!important}.origem-links a{color:inherit;text-underline-offset:.3rem}
.origem-nota{font-size:.85rem!important;color:#a9bfa0;margin-top:2rem!important}
</style>
</Base>
