---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Img from "../components/proto/Img.astro";
import credits from "../data/images.json";
import { breeds, breedEn, cardPhoto, fmtDate, num, type Breed } from "../lib/data";
import { TERRA, FRASE, FRASE_EN } from "../lib/proto";
import { getEntry, render } from "astro:content";
import { href, licenseLabel, tr, type Lang } from "../i18n";
interface Props { lang: Lang; b: Breed }
const { lang, b } = Astro.props;
const T = tr(lang);
const base = import.meta.env.BASE_URL;
const en = breedEn(b.slug);
const own = cardPhoto(b.slug);
const heroC0 = own ? (credits as any)[own.id] : null;
const heroC = heroC0 && lang === "en" ? { ...heroC0, alt: heroC0.alt_en ?? heroC0.alt, caption: heroC0.caption_en ?? heroC0.caption } : heroC0;
const FRAMED = new Set(["ramo-grande-feira", "arouquesa-touro", "barrosa-festa"]);
const framed = !own || FRAMED.has(own.id);
const BG_LAND: Record<string, string> = { alentejana: "hero-alentejo", mertolenga: "mertola", preta: "montado-pasto", garvonesa: "montado-pasto", algarvia: "monchique", "brava-de-lide": "leziria", arouquesa: "montalegre", maronesa: "montalegre", cachena: "montalegre", barrosa: "montalegre", minhota: "rio-lima", mirandesa: "miranda-douro", jarmelista: "montado-pasto", marinhoa: "baixo-vouga" };
const bgId = b.slug === "ramo-grande" ? "reflexo-mundo-acoriano" : (own?.kind === "raça" ? (BG_LAND[b.slug] ?? "montado-pasto") : own?.id ?? "montado-pasto");
const isBreedPhoto = own?.kind === "raça";
const ficha = (await getEntry(lang === "en" ? "fichas_en" : "fichas", b.slug))?.data ?? null;
const prof = await getEntry(lang === "en" ? "racas_en" : "racas", b.slug);
const Profile = prof ? (await render(prof)).Content : null;
const all = breeds();
const i = all.findIndex((x) => x.slug === b.slug);
const prev = all[(i + all.length - 1) % all.length], next = all[(i + 1) % all.length];
const solar = lang === "en" ? (en.solar ?? b.solar) : b.solar;
const fallbackFacts = [
  { label: T("Solar", "Homeland"), value: TERRA[b.slug] ?? (solar ?? "").split(" — ")[0] },
  ...(b.herd ? [{ label: T("Efetivo", "Herd"), value: `${num(b.herd.females, lang)} ${T("fêmeas", "females")}` }, { label: T("Criadores", "Breeders"), value: num(b.herd.breeders, lang) }] : []),
];
const facts = (ficha?.facts ?? fallbackFacts).map((f) => ({ label: f.label, value: f.value }));
const intro = ficha?.intro ?? prof?.data.summary ?? "";
const sec: Record<string, any> = ficha ? Object.fromEntries(ficha.sections.map((s) => [s.id, s])) : {};
const NAV: Record<string, string> = lang === "en"
  ? { historia: "History", territorio: "Territory", caracteristicas: "Characteristics", criacao: "Rearing", carne: "Meat", certificacao: "Certification", onde: "Where to find it", curiosidades: "Curiosities" }
  : { historia: "História", territorio: "Território", caracteristicas: "Características", criacao: "Criação", carne: "Carne", certificacao: "Certificação", onde: "Onde encontrar", curiosidades: "Curiosidades" };
const SECFIG: Record<string, string> = { historia: "acores-sao-jorge", criacao: "acores-pico-lagoa", certificacao: "bife-prato", onde: "carne-variedade", curiosidades: "acores-corvo" };
const MORE: Record<string, { l: string; u: string }[]> = {
  historia: [{ l: "Catálogo de raças autóctones (DGAV/CAP)", u: "https://www.dgav.pt/wp-content/uploads/2021/04/Catalogo-Oficial-Racas-Autoctones-Portuguesas.pdf" }],
  criacao: [{ l: "Caderno de especificações (DGADR)", u: "https://tradicional.dgadr.gov.pt/images/prod_imagens/carne/docs/CE_Ramo_Grande_DOP.pdf" }],
  certificacao: [{ l: "Carne Ramo Grande DOP (DGADR)", u: "https://tradicional.dgadr.gov.pt/pt/cat/carne/carne-de-bovino/1080-carne-ramo-grande-dop" }, { l: "Caderno de especificações (PDF)", u: "https://tradicional.dgadr.gov.pt/images/prod_imagens/carne/docs/CE_Ramo_Grande_DOP.pdf" }],
};
const order = ["historia", "territorio", "caracteristicas", "criacao", "carne", "certificacao", "onde", "curiosidades"].filter((id) => sec[id]);
const H2: Record<string, string> = lang === "en"
  ? { historia: "A breed born of the islands.", territorio: "Nine islands. One production area.", caracteristicas: "Red, strong, large.", criacao: "Grazing almost all year.", carne: "Bright red and firm.", certificacao: "Carne Ramo Grande PDO.", onde: "Under research.", curiosidades: "Small curiosities." }
  : { historia: "Uma raça nascida da ilha.", territorio: "Nove ilhas. Uma só área de produção.", caracteristicas: "Vermelha, forte, de grande porte.", criacao: "Pastoreio quase todo o ano.", carne: "Vermelho-vivo e firme.", certificacao: "Carne Ramo Grande DOP.", onde: "Em investigação.", curiosidades: "Pequenas curiosidades." };
const rg = b.slug === "ramo-grande";
const Src = (s?: { label: string; url: string }[]) => s;
// Mapa esquemático dos Açores (só para o Ramo Grande), a partir da geometria NUTS do repositório.
let islands: { name: string; d: string; x: number; y: number }[] = [], H = 0;
if (rg) {
  const geo = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/geo/nuts3_pt.json"), "utf-8"));
  const polys: number[][][][] = geo.features.find((f: any) => f.properties.name === "PT200").geometry.coordinates;
  const NAMES: [string, number, number][] = [["Santa Maria", 36.97, -25.08], ["São Miguel", 37.78, -25.5], ["Terceira", 38.72, -27.22], ["Graciosa", 39.05, -28.0], ["São Jorge", 38.65, -28.05], ["Pico", 38.47, -28.33], ["Faial", 38.58, -28.71], ["Flores", 39.45, -31.18], ["Corvo", 39.7, -31.11]];
  const k = Math.cos(38.4 * Math.PI / 180);
  const pts = polys.flatMap((p) => p[0]);
  const minX = Math.min(...pts.map((p) => p[0])), maxX = Math.max(...pts.map((p) => p[0])), minY = Math.min(...pts.map((p) => p[1])), maxY = Math.max(...pts.map((p) => p[1]));
  const sc = 880 / ((maxX - minX) * k); H = (maxY - minY) * sc + 40;
  const X = (x: number) => 20 + (x - minX) * k * sc, Y = (y: number) => 20 + (maxY - y) * sc;
  islands = polys.map((p) => {
    const c = p[0]; const cx = c.reduce((a, q) => a + q[0], 0) / c.length, cy = c.reduce((a, q) => a + q[1], 0) / c.length;
    const n = NAMES.reduce((best, m) => (Math.hypot(m[2] - cx, m[1] - cy) < Math.hypot(best[2] - cx, best[1] - cy) ? m : best))[0];
    return { name: n, d: "M" + c.map((q) => `${X(q[0]).toFixed(1)},${Y(q[1]).toFixed(1)}`).join("L") + "Z", x: X(cx), y: Y(cy) };
  });
}
const srcLine = (s?: { label: string; url: string }[]) => s && s.length > 0 ? s : null;
---
<Base lang={lang} overlay title={T(`Raça ${b.official_name}`, `${b.official_name} breed`)} description={intro}
  image={own ? `${base}img/${own.id}-lg.webp` : undefined}>
  <section class:list={["hero", "rg", "breed-quiet-hero"]} style="min-height:92svh">
    <img class="bg" src={`${base}img/${bgId}-lg.webp`} srcset={`${base}img/${bgId}-md.webp 900w, ${base}img/${bgId}-lg.webp 1800w`} sizes="100vw" alt={framed ? "" : (heroC?.alt ?? "")} width={(credits as any)[bgId]?.width} height={(credits as any)[bgId]?.height} fetchpriority="high" />
    <div class="wrap breed-hero-content">
      <a class="breed-back" href={href(lang, "racas/")}>← {T("As 15 raças", "The 15 breeds")}</a>
      <span class="breed-counter">{T("Raça autóctone portuguesa", "Portuguese native breed")} · {String(i + 1).padStart(2, "0")}/15</span>
      <h1>{b.official_name}</h1>
      <p class="breed-hero-line">{lang === "en" ? FRASE_EN[b.slug] : FRASE[b.slug]}</p>
      <a class="breed-discover" href="#conhecer">{T("Descobrir a raça", "Discover the breed")} ↓</a>
    </div>
    <div class="breed-hero-bottom">{bgId.endsWith("-ia") ? T("Paisagem do Alentejo · ilustração gerada por IA", "Alentejo landscape · AI-generated illustration") : <>{lang === "en" ? ((credits as any)[bgId]?.caption_en ?? (credits as any)[bgId]?.caption) : (credits as any)[bgId]?.caption}{(credits as any)[bgId] && <> · {T("Foto", "Photo")}: <a href={(credits as any)[bgId].source_page} rel="noopener" style="color:inherit">{(credits as any)[bgId].author}</a>, {licenseLabel(lang, (credits as any)[bgId].license)}</>}</>}</div>
  </section>

  <section class="breed-introduction sec" id="conhecer">
    <div class="wrap breed-intro-grid">
      <div class="breed-intro-copy rv">
        <span class="eyebrow">{T("Conhecer a raça", "Meet the breed")}</span>
        <h2>{b.official_name}</h2>
        <p class="lead">{intro}</p>
        <dl class="breed-facts">{facts.slice(0, 4).map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
      </div>
      {own && <figure class="breed-intro-photo rv"><Img id={own.id} sizes="(max-width:850px) 100vw, 640px" credit lang={lang} /><figcaption>{T("Fotografia documental identificada da raça", "Documentary photograph identified as this breed")}{own.kind !== "raça" ? T(" · imagem do território, não do animal", " · landscape, not the animal") : ""}</figcaption></figure>}
    </div>
  </section>

  {ficha ? (
    <>
      <div class="subnav" id="subnav"><div class="wrap" role="navigation" aria-label={T("Neste tema", "On this page")}>{order.map((id) => <a href={`#${id}`}>{NAV[id]}</a>)}</div></div>
      {order.map((id, n) => {
        const s = sec[id];
        const blocks = s.blocks as any[];
        const tone = id === "criacao" ? "green" : n % 2 === 1 ? "soft" : "";
        return (
          <section class:list={["sec", tone]} id={id}>
            {rg && SECFIG[id] && id !== "historia" && <figure class="frame rv secfig" style="width:min(820px,100% - 40px);margin:0 auto var(--s3);aspect-ratio:21/9"><Img id={SECFIG[id]} sizes="(max-width:820px) 100vw, 820px" credit lang={lang} /></figure>}
            <div class:list={["wrap", id === "caracteristicas" || id === "carne" || id === "territorio" || id === "historia" ? "split" : "narrow"]} style={id === "certificacao" || id === "criacao" ? "width:min(820px,100% - 40px)" : undefined}>
              
              <div class="rv">
                <span class="eyebrow">{NAV[id]}</span><h2 style="margin:.2em 0 .5em">{rg ? H2[id] : s.title}</h2>
                <p class="lead">{s.summary}</p>
                {id === "historia" && rg && (
                  <ol class="timeline" aria-label={T("Datas-chave", "Key dates")}>
                    <li><b>{T("Séc. XV", "15th c.")}</b> {T("Povoamento: chegam bovinos de várias regiões do continente.", "Settlement: cattle arrive from several mainland regions.")}</li>
                    <li><b>1943</b> {T("Estudo citado no caderno de especificações sobre as raças de origem.", "Study cited in the product specification on the founding breeds.")}</li>
                    <li><b>1996</b> {T("Criação do livro genealógico.", "Herd book created.")}</li>
                  </ol>
                )}
                {id === "territorio" && rg && <ul class="legend"><li><i class="k solar"></i> {T("Solar da raça: Terceira", "Breed homeland: Terceira")}</li><li><i class="k area"></i> {T("Área geográfica da DOP: as nove ilhas do arquipélago, segundo o caderno de especificações", "PDO geographical area: all nine islands, according to the product specification")}</li></ul>}
                <div style="margin-top:var(--s3)">
                  {blocks.map((bl, k) => (
                    <article class="atlas-story-block">
                      <h3>{bl.title}{bl.status && <span class="status-pill">{T("em investigação", "under research")}</span>}</h3>
                      <div class="body">
                        {bl.paras?.map((p: string) => <p>{p}</p>)}
                        {bl.list && <ul>{bl.list.map((x: string) => <li>{x}</li>)}</ul>}
                        {bl.table && <div class="tbl"><table><thead><tr>{bl.table.head.map((h: string) => <th>{h}</th>)}</tr></thead><tbody>{bl.table.rows.map((r: string[]) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody></table></div>}
                        {srcLine(bl.sources) && <p class="srcs">{T("Fontes", "Sources")}: {bl.sources.map((x: any, q: number) => <>{q > 0 && " · "}<a href={x.url} rel="noopener">{x.label}</a></>)}</p>}
                      </div>
                    </article>
                  ))}
                </div>
                {rg && MORE[id] && <p class="srcs" style="margin-top:1em"><strong>{T("Saber mais", "Learn more")}:</strong> {MORE[id].map((x, q) => <>{q > 0 && " · "}<a href={x.u} rel="noopener">{x.l} ↗</a></>)}</p>}
                {id === "carne" && <p class="srcs" style="margin-top:1em">{T("A fotografia de carne é ilustrativa (carne bovina em geral); não é carne desta raça.", "The meat photograph is illustrative (beef in general); it is not meat of this breed.")}</p>}
                {id === "caracteristicas" && own && own.kind === "raça" && FRAMED.has(own.id) && <p class="srcs">{T("A fotografia mostra animais numa feira ou recinto; procura-se uma fotografia melhor da raça em pastoreio.", "The photograph shows animals at a fair or enclosure; a better photograph of the breed grazing is being sought.")}</p>}
                {id === "certificacao" && <p style="margin-top:1.5em"><a class="btn" href={href(lang, "da-pastagem-ao-prato/")}>{T("Ver o percurso até ao prato →", "See the journey to the plate →")}</a></p>}
                {id === "onde" && rg && <p style="margin-top:1.5em"><a class="btn" href="https://tradicional.dgadr.gov.pt/pt/cat/carne/carne-de-bovino/1080-carne-ramo-grande-dop" rel="noopener">DGADR — Carne Ramo Grande DOP ↗</a></p>}
                {id === "onde" && <p class="srcs">{T("Não indicamos pontos de venda nem preços que não tenhamos verificado.", "We do not list points of sale or prices we have not verified.")}</p>}
              </div>
              {id === "territorio" && rg && (
                <div class="mapbox rv">
                  <svg viewBox={`0 0 920 ${H.toFixed(0)}`} role="img" aria-label={T("Mapa esquemático dos Açores com a ilha Terceira destacada", "Schematic map of the Azores with Terceira island highlighted")}>
                    {islands.map((is) => <g><path d={is.d} fill={is.name === "Terceira" ? "#183C32" : "#7FA07F"} stroke="#fff" stroke-width="1.2" stroke-linejoin="round"><title>{is.name}</title></path><text x={is.x} y={is.y + (is.name === "Terceira" ? 26 : 22)} text-anchor="middle" style="font:500 14px var(--sans);fill:#183C32">{is.name}</text></g>)}
                  </svg>
                  <p class="srcs" style="margin:.6em 0 0">{T("Mapa esquemático, geometria generalizada (Eurostat/GISCO, © EuroGeographics).", "Schematic map, generalised geometry (Eurostat/GISCO, © EuroGeographics).")}</p>
                </div>
              )}
              {id === "historia" && rg && <div class="frame rv" style="aspect-ratio:4/5"><Img id="acores-sao-jorge" sizes="(max-width:820px) 100vw, 560px" credit lang={lang} /></div>}
              {id === "carne" && <div class="frame rv" style="aspect-ratio:4/5"><Img id="carne-madeira" sizes="(max-width:820px) 100vw, 560px" credit lang={lang} /></div>}
            </div>
          </section>
        );
      })}
    </>
  ) : (
    <section class="sec">
      <div class="wrap split">
        <div class="rv">
          <span class="eyebrow">{T("Descobrir", "Discover")}</span><h2 style="margin:.2em 0 .5em">{T("A raça em poucas palavras", "The breed in brief")}</h2>
          <p class="lead">{intro}</p>
          {b.herd && <p class="srcs">{T("Efetivo: livro genealógico de adultos", "Herd: adult herd book")}, {b.herd.year}. {T("Fonte", "Source")}: <a href={b.name_sources?.[0]?.url}>{T("Catálogo Oficial de Raças Autóctones Portuguesas", "Official Catalogue of Portuguese Native Breeds")}</a> (DGAV/CAP), p. {b.herd.source_page}. {T("Verificado", "Verified")} {fmtDate(b.last_verified, lang)}.</p>}
          {b.solar && <p class="srcs">{T("Solar", "Homeland")}: {solar}</p>}
        </div>
        <div class="rv">
          {Profile && <div class="atlas-story-block prose"><Profile /></div>}
          <div class="atlas-story-block"><div class="body"><p>{T("A ficha completa desta raça seguirá o modelo da do Ramo Grande (História, Território, Características, Criação, Carne, Certificação, Onde encontrar) e será publicada à medida que cada fonte for confirmada. Não publicamos o que não conseguimos verificar.", "The full profile for this breed will follow the Ramo Grande model (History, Territory, Characteristics, Rearing, Meat, Certification, Where to find it) and be published as each source is confirmed. We do not publish what we cannot verify.")}</p></div></div>
        </div>
      </div>
    </section>
  )}

  <section class="sec tight soft">
    <div class="wrap">
      <span class="eyebrow">{T("Continuar a descobrir", "Keep discovering")}</span>
      <nav class="pn" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between;margin-top:var(--s2)">
        <a class="btn ghost" style="color:var(--green-deep)!important" href={href(lang, `racas/${prev.slug}/`)}>← {prev.official_name}</a>
        <a class="btn ghost" style="color:var(--green-deep)!important" href={href(lang, "da-pastagem-ao-prato/")}>{T("Da pastagem ao prato", "Pasture to plate")}</a>
        <a class="btn ghost" style="color:var(--green-deep)!important" href={href(lang, `racas/${next.slug}/`)}>{next.official_name} →</a>
      </nav>
    </div>
  </section>

  <script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>("#subnav a")];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((l) => l.classList.toggle("on", l.getAttribute("href") === "#" + e.target.id)); }), { rootMargin: "-40% 0px -55% 0px" });
    links.forEach((l) => { const t = document.querySelector(l.getAttribute("href")!); if (t) io.observe(t); });
  </script>
</Base>
<style is:global>
  .rg::after{background:linear-gradient(180deg,rgba(14,42,32,.82),rgba(14,42,32,.9))!important}
  .rg.rg-pico:not(.full) .bg{filter:none!important}
  .rg-pico::after{background:linear-gradient(90deg,rgba(10,30,22,.78) 0%,rgba(10,30,22,.45) 55%,rgba(10,30,22,.15) 100%),linear-gradient(180deg,rgba(10,30,22,.5),transparent 25%)!important}
  @media(max-width:900px){.rg-pico::after{background:linear-gradient(180deg,rgba(10,30,22,.6),rgba(10,30,22,.72))!important}}
  .rg.full::after{background:linear-gradient(180deg,rgba(10,30,22,.45) 0%,rgba(10,30,22,0) 32%,rgba(10,30,22,.15) 55%,rgba(10,30,22,.78) 100%)!important}
  .rg:not(.full) .bg{filter:blur(3px) saturate(.8)}
  .rg{align-items:center}.rg .in{padding:130px 0 70px}
  .rg.full{align-items:end}.rg.full .in{padding:130px 0 90px}
  .rgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(24px,4vw,64px);align-items:center}
  .rgrid h1,.rg h1{font-size:clamp(2.2rem,5.4vw,4.2rem);font-weight:600}
  .rgfig{margin:0;color:#fff}.rgfig figcaption{font-size:.82rem;margin-top:.8em;opacity:.92}.rgfig .gap{margin-right:.5em}
  @media(max-width:900px){.rgrid{grid-template-columns:1fr}}
  .timeline{list-style:none;padding:0;margin:var(--s3) 0 0;border-left:2px solid var(--gold)}
  .timeline li{padding:0 0 18px 20px;position:relative}
  .timeline li::before{content:"";position:absolute;left:-7px;top:.55em;width:12px;height:12px;border-radius:50%;background:var(--green-deep)}
  .timeline b{display:block;font:500 1.3rem var(--display);color:var(--green-deep)}
  .legend{list-style:none;padding:0;margin:0 0 var(--s3);font-size:.9rem}
  .legend .k{display:inline-block;width:14px;height:14px;border-radius:50%;margin-right:8px;vertical-align:-2px}
  .k.solar{background:#183C32}.k.area{background:#7FA07F}
  .prose h2{font-size:1.6rem;margin:1.2em 0 .4em}
</style>

<style is:global>
.atlas-story-block{padding:clamp(20px,3vw,38px) 0;border-bottom:1px solid rgba(41,61,48,.18)}.atlas-story-block h3{font-size:clamp(1.3rem,2vw,1.9rem);line-height:1.3;margin:0 0 1em;font-weight:550}.atlas-story-block .body{display:block!important;max-width:75ch}.atlas-story-block .body p{line-height:1.85}.atlas-story-block .body li{line-height:1.75;margin-bottom:.55em}.atlas-story-block .status-pill{font-size:.7rem;margin-left:1em}.rg .lead{max-width:58ch!important}.rg .facts4{max-width:650px}.rg .in>div>div:first-child{min-width:0}.rg .wrap{width:min(1200px,calc(100% - 48px))}.rg p{overflow-wrap:normal;word-break:normal}.rg .rgrid>div{min-width:0}
</style>

<style is:global>
/* V5: the landscape is the hero; all factual content starts below the fold. */
.rg.breed-quiet-hero{min-height:100svh!important;display:flex;align-items:flex-end!important;position:relative}
.rg.breed-quiet-hero .bg{filter:none!important;object-fit:cover}
.rg.breed-quiet-hero::after{background:linear-gradient(180deg,rgba(9,26,22,.34) 0%,rgba(9,26,22,.03) 36%,rgba(9,26,22,.12) 60%,rgba(9,26,22,.68) 100%)!important}
.rg.breed-quiet-hero .breed-hero-content{position:relative;z-index:2;padding:140px 0 100px!important;width:min(1280px,calc(100% - 72px));margin-inline:auto}
.breed-quiet-hero .breed-back{display:inline-block;color:#fff!important;text-decoration:none;font-size:.9rem;letter-spacing:.04em;margin-bottom:22px}
