---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import credits from "../data/images.json";
import { breeds, breedEn, cardPhoto, fmtDate, num, HERO_OVERRIDE, type Breed } from "../lib/data";
import { getEntry, render } from "astro:content";
import { href, licenseLabel, tr, type Lang } from "../i18n";
interface Props { lang: Lang; b: Breed }
const { lang, b } = Astro.props;
const T = tr(lang);
const en = breedEn(b.slug);
const own = cardPhoto(b.slug);
const heroId = HERO_OVERRIDE[b.slug] ?? own?.id ?? null;
const heroC = heroId ? (credits as Record<string, any>)[heroId] : null;
const heroKind = HERO_OVERRIDE[b.slug] ? "paisagem" : own?.kind;
const inset = HERO_OVERRIDE[b.slug] && own ? own.id : null;
const ficha = (await getEntry(lang === "en" ? "fichas_en" : "fichas", b.slug))?.data ?? null;
const prof = await getEntry(lang === "en" ? "racas_en" : "racas", b.slug);
const Profile = prof ? (await render(prof)).Content : null;
const all = breeds();
const i = all.findIndex((x) => x.slug === b.slug);
const prev = all[(i + all.length - 1) % all.length], next = all[(i + 1) % all.length];
const solar = lang === "en" ? (en.solar ?? b.solar) : b.solar;
const fallbackFacts = [
  { label: T("Solar", "Homeland"), value: (solar ?? "").split(" — ")[0].split(" (")[0], note: "" },
  ...(b.herd ? [{ label: T("Efetivo", "Herd"), value: `${num(b.herd.females, lang)} ${T("fêmeas", "females")}`, note: `${num(b.herd.males, lang)} ${T("machos", "males")} · ${num(b.herd.breeders, lang)} ${T("criadores", "breeders")} (${b.herd.year})` }] : []),
];
const facts = ficha?.facts ?? fallbackFacts;
const kindTag = heroKind === "raça" ? T("Fotografia da raça", "Photograph of the breed") : heroKind ? T("Paisagem do solar · fotografia da raça em procura", "Homeland landscape · breed photograph being sought") : null;
const pending = [T("Território", "Territory"), T("Carne", "Meat"), T("Certificação", "Certification"), T("Onde encontrar", "Where to find it"), T("Curiosidades", "Curiosities")];
---
<Base lang={lang} overlay title={T(`Raça ${b.official_name}`, `${b.official_name} breed`)}
  description={ficha?.intro ?? T(`Raça bovina autóctone ${b.official_name}: solar, efetivo e história, com fontes oficiais.`, `The native ${b.official_name} cattle breed: homeland, herd size and history, with official sources.`)}
  image={heroId ? `${import.meta.env.BASE_URL}img/${heroId}-lg.webp` : undefined}>
  <section class="hero">
    {heroId ? <Photo id={heroId} class="bgp" sizes="100vw" eager caption={false} lang={lang} /> : <div class="bgp empty"></div>}
    <div class="wrap hcap">
      <a class="back" href={href(lang, "racas/")}>← {T("Todas as raças", "All breeds")}</a>
      <span class="kicker">{T("Raça bovina autóctone", "Native cattle breed")} · {String(i + 1).padStart(2, "0")}/15</span>
      <h1>{b.official_name}</h1>
      <p class="where">{solar}</p>
      {kindTag && <span class="chip">{kindTag}</span>}
    </div>
    {heroC && <p class="credit-line">{lang === "en" ? (heroC.caption_en ?? heroC.caption) : heroC.caption} · {T("Foto", "Photo")}: <a href={heroC.source_page} rel="noopener">{heroC.author}</a> · {licenseLabel(lang, heroC.license)}</p>}
  </section>

  <section class="discover">
    <div class="wrap d-grid">
      <div class="d-text">
        <span class="eyebrow">{T("Descobrir", "Discover")}</span>
        <p class="intro">{ficha?.intro ?? prof?.data.summary}</p>
        <dl class="facts">
          {facts.map((f) => <div><dt>{f.label}</dt><dd><strong>{f.value}</strong>{f.note && <span>{f.note}</span>}</dd></div>)}
        </dl>
        {b.herd && <p class="src">{T("Efetivo: livro genealógico de adultos", "Herd: adult herd book")}, {b.herd.year}. {T("Fonte", "Source")}: <a href={b.name_sources?.[0]?.url}>{T("Catálogo Oficial de Raças Autóctones Portuguesas", "Official Catalogue of Portuguese Native Breeds")}</a> (DGAV/CAP), p. {b.herd.source_page}. {T("Verificado", "Verified")} {fmtDate(b.last_verified, lang)}.</p>}
      </div>
      {inset && <Photo id={inset} class="inset" sizes="(max-width: 860px) 100vw, 50vw" lang={lang} />}
    </div>
  </section>

  {ficha ? (
    <section class="explore" id="explorar">
      <nav class="tabs" aria-label={T("Áreas de conhecimento", "Areas of knowledge")} data-tabs>
        <div class="wrap tabs-in">{ficha.sections.map((s, k) => <a href={`#${s.id}`} data-tab={s.id} aria-current={k === 0 ? "true" : undefined}>{s.title}</a>)}</div>
      </nav>
      <div class="wrap panels">
        {ficha.sections.map((s) => (
          <section class="panel" id={s.id} data-panel={s.id}>
            <span class="eyebrow">{T("Explorar", "Explore")}</span>
            <h2>{s.title}</h2>
            <p class="lede">{s.summary}</p>
            <div class="dives">
              {s.blocks.map((blk) => (
                <details class="dive">
                  <summary><span>{blk.title}</span>{blk.status && <span class="chip wait">{blk.status}</span>}</summary>
                  <div class="dive-body">
                    {blk.paras?.map((p) => <p>{p}</p>)}
                    {blk.list && <ul>{blk.list.map((x) => <li>{x}</li>)}</ul>}
                    {blk.table && <table><thead><tr>{blk.table.head.map((h) => <th>{h}</th>)}</tr></thead><tbody>{blk.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody></table>}
                    {blk.sources && <p class="srcs">{T("Fontes", "Sources")}: {blk.sources.map((x, n) => <>{n > 0 && " · "}<a href={x.url} rel="noopener">{x.label}</a></>)}</p>}
                  </div>
                </details>
              ))}
            </div>
            {s.id === "certificacao" && <p class="go"><a class="btn" href={href(lang, "da-pastagem-ao-prato/")}>{T("Ver o percurso até ao prato →", "See the journey to the plate →")}</a></p>}
          </section>
        ))}
      </div>
    </section>
  ) : (
    <section class="block">
      <div class="wrap narrow">
        <span class="eyebrow">{T("Explorar", "Explore")}</span>
        {Profile && <div class="prose"><Profile /></div>}
        <h2 class="h2s">{T("Em investigação", "Under research")}</h2>
        <p>{T("A ficha completa desta raça segue o modelo da do Ramo Grande e será publicada à medida que cada fonte for confirmada:", "The full profile for this breed will follow the Ramo Grande model and be published as each source is confirmed:")}</p>
        <p>{pending.map((x) => <span class="chip wait">{x}</span>)}</p>
      </div>
    </section>
  )}

  <section class="block more">
    <div class="wrap">
      <span class="eyebrow">{T("Continuar a descobrir", "Keep discovering")}</span>
      <nav class="pn">
        <a href={href(lang, `racas/${prev.slug}/`)}>← {prev.official_name}</a>
        <a href={href(lang, "da-pastagem-ao-prato/")}>{T("Da pastagem ao prato", "Pasture to plate")}</a>
        <a href={href(lang, `racas/${next.slug}/`)}>{next.official_name} →</a>
      </nav>
    </div>
  </section>
</Base>
<script>
  const tabs = document.querySelector<HTMLElement>("[data-tabs]");
  if (tabs) {
    const links = [...tabs.querySelectorAll<HTMLAnchorElement>("a[data-tab]")];
    const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
    const show = (id: string, push = true) => {
      document.documentElement.classList.add("js-tabs");
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
      links.forEach((l) => l.toggleAttribute("aria-current", l.dataset.tab === id));
      if (push) history.replaceState(null, "", "#" + id);
    };
    const start = location.hash.slice(1);
    show(panels.some((p) => p.dataset.panel === start) ? start : panels[0].dataset.panel!, false);
    links.forEach((l) => l.addEventListener("click", (e) => { e.preventDefault(); show(l.dataset.tab!); document.getElementById("explorar")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" }); }));
    addEventListener("hashchange", () => { const id = location.hash.slice(1); if (panels.some((p) => p.dataset.panel === id)) show(id, false); });
  }
</script>
<style>
  .hero { position: relative; min-height: min(86svh, 780px); display: grid; align-items: end; color: #fff; overflow: hidden; isolation: isolate; background: #1c1714; margin-top: -61px; }
  .hero :global(.bgp), .hero .bgp { position: absolute; inset: 0; z-index: -2; }
  .hero :global(.bgp img) { object-position: 50% 40%; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(14,11,9,.35) 0%, rgba(14,11,9,0) 30%, rgba(14,11,9,.8) 100%); }
  .hcap { width: 100%; padding-bottom: clamp(36px, 7vh, 64px); padding-top: 110px; }
  .hcap > * { opacity: 0; transform: translateY(18px); animation: rise .9s ease forwards; }
  .hcap > *:nth-child(2) { animation-delay: .08s; } .hcap > *:nth-child(3) { animation-delay: .16s; } .hcap > *:nth-child(4) { animation-delay: .24s; } .hcap > *:nth-child(5) { animation-delay: .32s; }
  @media (prefers-reduced-motion: reduce) { .hcap > * { opacity: 1; transform: none; animation: none; } }
  .hero h1 { color: #fff; font-size: clamp(3rem, 9vw, 6.5rem); margin: 0; text-shadow: 0 2px 30px rgba(0,0,0,.4); }
  .kicker { display: block; font: 500 .8rem/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: #f3c9a8; margin: 10px 0 14px; }
  .where { color: rgba(255,255,255,.92); font-size: 1.15rem; margin: .3em 0 12px; }
  .back { color: rgba(255,255,255,.85); text-decoration: none; font-size: .9rem; display: inline-block; margin-bottom: 10px; }
  .chip { background: rgba(255,255,255,.18); color: #fff; backdrop-filter: blur(4px); }
  .hero .credit-line { position: absolute; right: 16px; bottom: 10px; margin: 0; font-size: .68rem; color: rgba(255,255,255,.65); max-width: 60ch; text-align: right; }
  .hero .credit-line a { color: inherit; }
  .discover { padding: clamp(40px, 7vw, 84px) 0; }
  .d-grid { display: grid; gap: 40px; grid-template-columns: 1.1fr 1fr; align-items: center; }
  @media (max-width: 860px) { .d-grid { grid-template-columns: 1fr; } }
  .intro { font: 400 clamp(1.3rem, 2.6vw, 1.8rem)/1.4 var(--display); letter-spacing: -.01em; max-width: 30ch; margin-bottom: 1.2em; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 18px 24px; margin: 0 0 1.5em; }
  .facts > div { border-top: 1px solid var(--line); padding-top: 10px; }
  .facts dt { font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
  .facts dd { margin: 4px 0 0; display: grid; } .facts dd strong { font: 500 1.35rem var(--display); } .facts dd span { font-size: .82rem; color: var(--muted); }
  .src { font-size: .78rem; color: var(--muted); }
  .inset :global(img) { border-radius: var(--radius); aspect-ratio: 4/3; }
  .explore { border-top: 1px solid var(--line); }
  .tabs { position: sticky; top: var(--hd, 60px); z-index: 5; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .tabs-in { display: flex; gap: 4px; overflow-x: auto; padding-top: 8px; padding-bottom: 8px; scrollbar-width: none; }
  .tabs-in a { white-space: nowrap; color: var(--muted); text-decoration: none; font-size: .9rem; padding: 7px 14px; border-radius: 999px; }
  .tabs-in a[aria-current] { background: var(--ink); color: var(--paper); }
  .panels { padding-top: clamp(32px, 5vw, 56px); padding-bottom: clamp(40px, 7vw, 90px); min-height: 60vh; }
  .panel { scroll-margin-top: 130px; margin-bottom: 64px; }
  :global(.js-tabs) .panel { margin-bottom: 0; }
  .panel[hidden] { display: none; }
  .panel .lede { max-width: 52ch; margin-bottom: 1.6em; }
  .dive-body :global(.chip) { background: var(--cork-soft); color: var(--muted); backdrop-filter: none; }
  summary .chip { background: var(--cork-soft); color: var(--muted); }
  .go { margin-top: 28px; }
  .narrow { max-width: 760px; }
  .h2s { margin-top: 1.4em; font-size: 1.4rem; }
  .prose :global(h2) { font-size: 1.4rem; margin-top: 1.4em; }
  .more .pn { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .more .pn a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .block :global(.chip.wait) { background: var(--cork-soft); color: var(--muted); margin: 0 6px 6px 0; }
</style>
<style is:global>
  @media (max-width: 640px) { :root { --hd: 98px; } }
</style>
