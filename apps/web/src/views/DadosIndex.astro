---
import Base from "../layouts/Base.astro";
import { summary, fmtDate } from "../lib/data";
import { href, tr, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const s = summary();
const base = import.meta.env.BASE_URL;
---
<Base lang={lang} title={T("Dados", "Data")} description={T("Todos os conjuntos de dados do Atlas do Bovino Português, com fonte, período e download.", "Every dataset in the Portuguese Beef Atlas, with source, period and download.")}>
  <section class="block" style="border-top:0"><div class="wrap">
    <span class="eyebrow">{T("Nível 3 · Investigar", "Level 3 · Investigate")}</span>
    <h1>{T("Os dados, todos", "All the data")}</h1>
    <p class="lede">{T("Cada conjunto vem de uma fonte oficial, é verificado automaticamente todos os dias e pode ser descarregado. As revisões feitas pelas fontes ficam registadas no ", "Each dataset comes from an official source, is checked automatically every day and can be downloaded. Revisions made by the sources are recorded in the ")}<a href="https://github.com/Ruirodsantos/bovino-pt/tree/main/data/history">{T("histórico", "history")}</a>.</p>
    <div class="tbl" role="table">
      {s.catalog.map((c) => (
        <div class="card ds" id={c.id}>
          <div><h2>{lang === "en" ? (c.title_en ?? c.title_pt) : c.title_pt}</h2><code>{c.id}</code></div>
          {c.state === "ok" ? (
            <dl>
              <div><dt>{T("Fonte", "Source")}</dt><dd>Eurostat <span class="mono">{c.source_code}</span></dd></div>
              <div><dt>{T("Período", "Period")}</dt><dd>{c.first_period} → {c.last_period}</dd></div>
              <div><dt>{T("Valores", "Values")}</dt><dd>{c.rows}</dd></div>
              <div><dt>{T("Publicado pela fonte", "Published by the source")}</dt><dd>{fmtDate(c.publication_date, lang)}</dd></div>
              <div><dt>{T("Verificado", "Verified")}</dt><dd>{fmtDate(c.retrieved_at?.slice(0, 10), lang)}</dd></div>
              <div><dt>{T("Descarregar", "Download")}</dt><dd><a href={`${base}data/${c.id}.json`}>JSON</a> · <a href={`https://github.com/Ruirodsantos/bovino-pt/blob/main/data/validated/${c.id}.csv`}>CSV</a></dd></div>
            </dl>
          ) : <p class="chip wait">{T("Em preparação: a fonte ainda não respondeu com dados válidos", "In preparation: the source has not yet responded with valid data")}</p>}
        </div>
      ))}
    </div>
  </div></section>
</Base>
<style>
  .tbl { display: grid; gap: 12px; margin-top: 24px; }
  .ds h2 { font-size: 1.3rem; margin: 0 0 4px; } .ds code { color: var(--muted); font-size: .8rem; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 16px 0 0; }
  dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); } dd { margin: 2px 0 0; font-weight: 600; }
</style>
