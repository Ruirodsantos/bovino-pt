---
import credits from "../data/images.json";
interface Props { id: string; sizes?: string; class?: string; caption?: boolean; eager?: boolean; }
const { id, sizes = "100vw", class: cls, caption = true, eager = false } = Astro.props;
const c = (credits as Record<string, any>)[id];
const base = import.meta.env.BASE_URL;
const src = (s: string) => `${base}img/${id}-${s}.webp`;
---
{c && (
  <figure class:list={["photo", cls]}>
    <img src={src("md")} srcset={`${src("sm")} 480w, ${src("md")} 900w, ${src("lg")} 1800w`} sizes={sizes}
      alt={c.alt} width={c.width} height={c.height} loading={eager ? "eager" : "lazy"} decoding="async" />
    {caption && <figcaption>{c.caption && <span>{c.caption}</span>} <span class="credit">Foto: <a href={c.source_page} rel="noopener">{c.author}</a> · {c.license}</span></figcaption>}
  </figure>
)}
<style>
  .photo { margin: 0; position: relative; overflow: hidden; }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { font-size: .74rem; color: var(--muted); padding: 6px 2px 0; }
  .credit a { color: inherit; }
</style>
