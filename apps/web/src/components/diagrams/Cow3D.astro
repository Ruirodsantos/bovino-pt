---
import Cuts from "./Cuts.astro";
import { tr, type Lang } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "pt" } = Astro.props;
const T = tr(lang);
// Dados dos cortes: os mesmos da tabela «Os cortes» deste artigo (revistos como texto original; nomes variam por região).
const cuts = [
  { id: "acem", c: "#8C5A3C", n: T("Acém e cachaço", "Neck and chuck"), w: T("Pescoço e ombro", "Neck and shoulder"), k: T("Muito sabor, muito colagénio.", "Plenty of flavour, plenty of collagen."), m: T("Estufados e cozidos lentos.", "Stews and slow-cooked dishes.") },
  { id: "pa", c: "#B4753F", n: T("Pá", "Shoulder"), w: T("Ombro", "Shoulder"), k: T("Fibra grossa e sabor intenso.", "Coarse fibre and intense flavour."), m: T("Estufar, desfiar.", "Braise, shred.") },
  { id: "peito", c: "#9C4A3C", n: T("Peito", "Brisket"), w: T("Parte inferior do peito", "Lower part of the breast"), k: T("Gordo e colagénico.", "Fatty and collagen-rich."), m: T("Cozedura longa, fumados.", "Long cooking, smoking.") },
  { id: "lombo-alto", c: "#C0392B", n: T("Lombo alto", "Rib / ribeye (lombo alto)"), w: T("Costas, parte dianteira", "Back, front part"), k: T("Marmoreado e saboroso; é o «bife da costela» sem osso ou a costeleta.", "Marbled and flavourful; the boneless “rib steak” or the bone-in costeleta."), m: T("Brasa, frigideira, forno depois de selar.", "Embers, frying pan, oven after searing.") },
  { id: "lombo-baixo", c: "#D4584A", n: T("Lombo baixo", "Loin / sirloin (lombo baixo)"), w: T("Costas, parte traseira", "Back, rear part"), k: T("Fibra firme, gordura de cobertura.", "Firm fibre, cover fat."), m: T("Grelha; cortar sempre contra a fibra.", "Grill; always slice against the grain.") },
  { id: "alcatra", c: "#A23B3B", n: T("Alcatra", "Rump"), w: T("Garupa", "Rump"), k: T("Macia, magra, versátil.", "Tender, lean, versatile."), m: T("Grelha, assados, posta.", "Grill, roasts, posta.") },
  { id: "aba", c: "#7E3B2E", n: T("Aba (flanco)", "Flank (aba)"), w: T("Flanco (parede abdominal)", "Flank (abdominal wall)"), k: T("Fibra comprida e muito sabor.", "Long fibre and plenty of flavour."), m: T("Grelha rápida ou estufar; fatiar contra a fibra.", "Quick grill or braise; slice against the grain.") },
  { id: "chambao", c: "#6B4A33", n: T("Chambão", "Shank (chambão)"), w: T("Perna (canela)", "Leg (shin)"), k: T("Osso com tutano e músculo cheio de colagénio; em fatias cruzadas dá o ossobuco.", "Bone with marrow and a collagen-rich muscle; cut in cross-section it gives ossobuco."), m: T("Estufar.", "Braise.") },
  { id: "rabo", c: "#5E4A3C", n: T("Rabo", "Tail"), w: T("Cauda", "Tail"), k: T("Gelatinoso.", "Gelatinous."), m: T("Estufar horas.", "Braise for hours.") },
  { id: "lombinho", c: "#E0705F", n: T("Lombinho", "Tenderloin (lombinho)"), w: T("Dentro do lombo, junto à coluna. Só se vê ao separar as peças.", "Inside the loin, next to the spine. Only visible when the pieces are separated."), k: T("O mais macio e de sabor mais suave.", "The most tender, with the mildest flavour."), m: T("Grelha ou frigideira, rápido, mal passado a ao ponto.", "Grill or frying pan, quickly, rare to medium-rare.") },
];
const ui = { drag: T("Arraste para rodar · use dois dedos ou a roda para aproximar", "Drag to rotate · pinch or scroll to zoom"), explode: T("Separar as peças", "Separate the pieces"), join: T("Juntar as peças", "Put the pieces together"), pick: T("Toque numa peça", "Tap a piece"), where: T("Onde fica", "Where it sits"), char: T("Carácter", "Character"), how: T("Método ideal", "Ideal method"), reset: T("Recomeçar", "Reset view") };
---
<figure class="c3d" data-cuts={JSON.stringify(cuts)} data-ui={JSON.stringify(ui)}>
  <div class="c3d-fallback"><Cuts lang={lang} /></div>
  <div class="c3d-live" hidden>
    <div class="c3d-stage"><canvas role="img" aria-label={T("Vaca em três dimensões, dividida nos cortes. Arraste para rodar e toque numa peça para ver o nome e a utilização.", "Cow in three dimensions, divided into cuts. Drag to rotate and tap a piece to see its name and use.")}></canvas>
      <p class="c3d-hint">{ui.drag}</p>
      <div class="c3d-tools"><button type="button" data-explode aria-pressed="false">{ui.explode}</button><button type="button" data-reset>{ui.reset}</button></div>
    </div>
    <div class="c3d-side">
      <div class="c3d-info" aria-live="polite"><p class="c3d-pick">{ui.pick}</p></div>
      <ul class="c3d-list">{cuts.map((c) => <li><button type="button" data-cut={c.id}><i style={`background:${c.c}`}></i>{c.n}</button></li>)}</ul>
    </div>
  </div>
  <figcaption>{T("Modelo ilustrativo e simplificado: as formas e posições são aproximadas e os nomes variam entre regiões e talhos. A «vazia» está por validar com um profissional de desmancha e por isso não é marcada.", "Illustrative, simplified model: shapes and positions are approximate and names vary by region and butcher. «Vazia» is still to be validated with a professional butcher and is therefore not marked.")}</figcaption>
</figure>
<script>
  const root = document.querySelector<HTMLElement>(".c3d");
  if (root) {
    const start = async () => {
      try {
        const cuts = JSON.parse(root.dataset.cuts!) as any[];
        const ui = JSON.parse(root.dataset.ui!);
        const THREE = await import("three");
        const { OrbitControls } = await import("three/examples/jsm/controls/OrbitControls.js");
        const { RoundedBoxGeometry } = await import("three/examples/jsm/geometries/RoundedBoxGeometry.js");
        const canvas = root.querySelector("canvas")!;
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
        camera.position.set(-2.6, 3.2, 8.8);
        scene.add(new THREE.HemisphereLight(0xffffff, 0xb9a98a, 1.05));
        const sun = new THREE.DirectionalLight(0xffffff, 1.5); sun.position.set(4, 8, 6); scene.add(sun);
        const rim = new THREE.DirectionalLight(0xffe2b8, .6); rim.position.set(-5, 3, -6); scene.add(rim);
        const cow = new THREE.Group(); scene.add(cow);
        const col = (id: string) => new THREE.Color(cuts.find((c) => c.id === id).c);
        const pieces: { id: string; g: any; base: any; dir: any; mats: any[] }[] = [];
        const addPiece = (id: string, parts: { geo: any; pos: number[]; rot?: number[] }[]) => {
          const g = new THREE.Group(); const mats: any[] = [];
          parts.forEach((p) => { const m = new THREE.MeshStandardMaterial({ color: col(id), roughness: .55, metalness: 0, emissive: 0x000000 }); mats.push(m);
            const mesh = new THREE.Mesh(p.geo, m); mesh.position.set(p.pos[0], p.pos[1], p.pos[2]); if (p.rot) mesh.rotation.set(p.rot[0], p.rot[1], p.rot[2]); mesh.userData.id = id; g.add(mesh); });
          const box = new THREE.Box3().setFromObject(g); const centre = box.getCenter(new THREE.Vector3());
          const dir = centre.clone().sub(new THREE.Vector3(0, 1.9, 0)); if (dir.length() < .01) dir.set(0, 1, 0); dir.normalize();
          cow.add(g); pieces.push({ id, g, base: new THREE.Vector3(), dir, mats });
        };
        const rb = (w: number, h: number, d: number, r = .09) => new RoundedBoxGeometry(w, h, d, 4, r);
        const W = 1.34, gap = .035;
        const blk = (x0: number, x1: number, y0: number, y1: number) => ({ geo: rb(x1 - x0 - gap, y1 - y0 - gap, W), pos: [(x0 + x1) / 2, (y0 + y1) / 2, 0] });
        addPiece("alcatra", [blk(-2.1, -1.2, 1.15, 2.65)]);
        addPiece("lombo-baixo", [blk(-1.2, -0.4, 1.85, 2.65)]);
        addPiece("lombo-alto", [blk(-0.4, 0.4, 1.85, 2.65)]);
        addPiece("aba", [blk(-1.2, 0.4, 1.15, 1.85)]);
        addPiece("pa", [blk(0.4, 1.2, 1.6, 2.65)]);
        addPiece("peito", [blk(0.4, 1.9, 1.15, 1.6)]);
        addPiece("acem", [blk(1.2, 1.9, 1.6, 2.7)]);
        const leg = (x: number, z: number, h = 1.1) => ({ geo: new THREE.CylinderGeometry(.2, .15, h, 20), pos: [x, h / 2 + .05, z] });
        addPiece("chambao", [leg(-1.65, .42), leg(-1.65, -.42), leg(1.4, .38, 1.05), leg(1.4, -.38, 1.05)]);
        addPiece("rabo", [{ geo: new THREE.CylinderGeometry(.06, .035, 1.5, 12), pos: [-2.28, 1.75, 0], rot: [0, 0, -.12] }]);
        // lombinho: dentro do lombo, só visível ao separar
        addPiece("lombinho", [{ geo: new THREE.CylinderGeometry(.2, .15, 1.15, 20), pos: [-0.4, 2.0, 0], rot: [0, 0, Math.PI / 2] }]);
        // cabeça, cascos (neutros, não são cortes)
        const neutral = new THREE.MeshStandardMaterial({ color: 0xcdbfa6, roughness: .7 });
        const dark = new THREE.MeshStandardMaterial({ color: 0x3b3a35, roughness: .8 });
        const head = new THREE.Mesh(rb(.95, .75, .7, .2), neutral); head.position.set(2.45, 2.25, 0); head.rotation.z = -.35; cow.add(head);
        const snout = new THREE.Mesh(rb(.35, .5, .6, .15), neutral); snout.position.set(2.8, 1.95, 0); snout.rotation.z = -.35; cow.add(snout);
        [-1, 1].forEach((s) => { const h = new THREE.Mesh(new THREE.ConeGeometry(.07, .5, 12), new THREE.MeshStandardMaterial({ color: 0xe9e2d0 })); h.position.set(2.35, 2.78, s * .42); h.rotation.set(s * .9, 0, .15); cow.add(h);
          const e = new THREE.Mesh(rb(.3, .12, .3, .05), neutral); e.position.set(2.2, 2.55, s * .5); cow.add(e); });
        [[-1.65, .42], [-1.65, -.42], [1.4, .38], [1.4, -.38]].forEach(([x, z]) => { const hoof = new THREE.Mesh(new THREE.CylinderGeometry(.19, .21, .12, 20), dark); hoof.position.set(x, .06, z); cow.add(hoof); });
        const shadow = new THREE.Mesh(new THREE.CircleGeometry(3.4, 48), new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: .08 })); shadow.rotation.x = -Math.PI / 2; shadow.position.set(0, .01, 0); shadow.scale.set(1, .5, 1); scene.add(shadow);
        cow.position.set(-.2, -.9, 0); cow.scale.setScalar(1);

        const controls = new OrbitControls(camera, canvas);
        controls.target.set(0, .9, 0); controls.enableDamping = true; controls.enablePan = false;
        controls.minDistance = 6; controls.maxDistance = 16; controls.minPolarAngle = .3; controls.maxPolarAngle = Math.PI / 2 + .1;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        controls.autoRotate = !reduce; controls.autoRotateSpeed = 1.1;
        controls.addEventListener("start", () => { controls.autoRotate = false; });

        const info = root.querySelector<HTMLElement>(".c3d-info")!;
        const btns = [...root.querySelectorAll<HTMLButtonElement>("[data-cut]")];
        let sel: string | null = null, explode = false, k = 0;
        const render = (id: string | null) => {
          sel = id; btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.cut === id)));
          if (!id) { info.innerHTML = `<p class="c3d-pick">${ui.pick}</p>`; return; }
          const c = cuts.find((x) => x.id === id);
          info.innerHTML = `<h4><i style="background:${c.c}"></i>${c.n}</h4><dl><dt>${ui.where}</dt><dd>${c.w}</dd><dt>${ui.char}</dt><dd>${c.k}</dd><dt>${ui.how}</dt><dd>${c.m}</dd></dl>`;
          if (id === "lombinho" && !explode) toggle(true);
        };
        const toggle = (on: boolean) => { explode = on; const b = root.querySelector<HTMLButtonElement>("[data-explode]")!; b.setAttribute("aria-pressed", String(on)); b.textContent = on ? ui.join : ui.explode; };
        root.querySelector("[data-explode]")!.addEventListener("click", () => toggle(!explode));
        root.querySelector("[data-reset]")!.addEventListener("click", () => { toggle(false); render(null); camera.position.set(-2.6, 3.2, 8.8); controls.target.set(0, .9, 0); });
        btns.forEach((b) => b.addEventListener("click", () => render(b.dataset.cut === sel ? null : b.dataset.cut!)));

        const ray = new THREE.Raycaster(), mouse = new THREE.Vector2(); let down = [0, 0], hover: string | null = null;
        const pick = (e: PointerEvent) => { const r = canvas.getBoundingClientRect(); mouse.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1); ray.setFromCamera(mouse, camera);
          const hit = ray.intersectObjects(cow.children, true).find((h) => h.object.userData.id); return hit ? (hit.object.userData.id as string) : null; };
        canvas.addEventListener("pointerdown", (e) => { down = [e.clientX, e.clientY]; });
        canvas.addEventListener("pointerup", (e) => { if (Math.hypot(e.clientX - down[0], e.clientY - down[1]) < 6) { const id = pick(e); render(id && id === sel ? null : id); } });
        canvas.addEventListener("pointermove", (e) => { if (e.pointerType === "mouse" && e.buttons === 0) { hover = pick(e); canvas.style.cursor = hover ? "pointer" : "grab"; } });
        canvas.addEventListener("pointerleave", () => { hover = null; });

        const size = () => { const w = canvas.clientWidth, h = canvas.clientHeight; if (canvas.width !== w * renderer.getPixelRatio() || canvas.height !== h * renderer.getPixelRatio()) { renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix(); } };
        let visible = true; new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(root);
        const tick = () => { requestAnimationFrame(tick); if (!visible) return; size();
          k += ((explode ? 1 : 0) - k) * .12;
          pieces.forEach((p) => { const on = p.id === sel, hv = p.id === hover; const lift = k * (p.id === "lombinho" ? 0 : .38) + (on ? .22 : 0);
            p.g.position.copy(p.dir).multiplyScalar(lift);
            p.mats.forEach((m) => { m.emissive.setHex(on ? 0x553311 : hv ? 0x2a1a0a : 0x000000); m.opacity = 1; });
            if (p.id === "lombinho") p.g.visible = k > .3; });
          controls.update(); renderer.render(scene, camera); };
        root.querySelector<HTMLElement>(".c3d-fallback")!.hidden = true; root.querySelector<HTMLElement>(".c3d-live")!.hidden = false; size(); tick();
      } catch (e) { console.warn("3D indisponível, a usar o esquema 2D", e); }
    };
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { o.disconnect(); start(); } }, { rootMargin: "200px" }).observe(root);
  }
</script>
<style is:global>
  .c3d { margin: 1.5rem 0; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 14px; }
  .c3d figcaption { font-size: .82rem; color: var(--muted); margin-top: .8em; }
  .c3d-live { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(240px, 1fr); gap: 16px; }
  .c3d-live[hidden], .c3d-fallback[hidden] { display: none; }
  .c3d-stage { position: relative; min-height: 420px; background: radial-gradient(ellipse at 50% 40%, #f8f3e8, #efe7d8); border-radius: 16px; overflow: hidden; }
  .c3d-stage canvas { width: 100%; height: 100%; min-height: 420px; display: block; cursor: grab; touch-action: pan-y; }
  .c3d-stage canvas:active { cursor: grabbing; }
  .c3d-hint { position: absolute; left: 14px; bottom: 12px; margin: 0; font-size: .78rem; color: var(--muted); pointer-events: none; }
  .c3d-tools { position: absolute; right: 12px; top: 12px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .c3d-tools button { font: 500 .82rem var(--sans); padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--green-deep); cursor: pointer; }
  .c3d-tools button[aria-pressed="true"] { background: var(--green-deep); color: #fff; }
  .c3d-side { display: flex; flex-direction: column; gap: 12px; }
  .c3d-info { min-height: 190px; padding: 14px 16px; border-radius: 14px; background: var(--ivory-2); }
  .c3d-info h4 { margin: 0 0 .5em; font-size: 1.15rem; display: flex; gap: 8px; align-items: center; }
  .c3d-info i, .c3d-list i { width: 12px; height: 12px; border-radius: 50%; display: inline-block; flex: none; }
  .c3d-info dl { margin: 0; font-size: .92rem; } .c3d-info dt { font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: .7em; } .c3d-info dd { margin: 0; }
  .c3d-pick { margin: 0; color: var(--muted); }
  .c3d-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .c3d-list button { width: 100%; text-align: left; font: 500 .85rem var(--sans); padding: 8px 10px; border-radius: 10px; border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; display: flex; gap: 8px; align-items: center; }
  .c3d-list button[aria-pressed="true"] { border-color: var(--green-deep); background: var(--green-soft); }
  @media (max-width: 820px) { .c3d-live { grid-template-columns: 1fr; } .c3d-stage, .c3d-stage canvas { min-height: 340px; } }
</style>
