---
import Img from "../proto/Img.astro";
import { href, tr, type Lang } from "../../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const b = import.meta.env.BASE_URL;
const eur = (c: string) => `https://eur-lex.europa.eu/legal-content/${({ pt: "PT", en: "EN", es: "ES", fr: "FR" } as any)[lang]}/TXT/?uri=CELEX:${c}`;

// 2. Etiqueta ilustrativa: sem números reais. «oblig» = exigido por regulamento da UE; «hab» = habitual; «fac» = facultativo.
const labelItems = [
  { id: "origem", t: T("Origem", "Origin", "Origen", "Origine"), tag: "oblig", s: T("Indica onde o animal nasceu, foi criado e abatido.", "Says where the animal was born, reared and slaughtered.", "Indica dónde nació, se crió y se sacrificó el animal.", "Indique où l’animal est né, a été élevé et abattu."), m: T("A origem permite conhecer a proveniência, mas não determina, por si só, a qualidade gastronómica.", "Origin tells you where the meat comes from, but on its own it does not determine eating quality.", "El origen permite conocer la procedencia, pero por sí solo no determina la calidad gastronómica.", "L’origine permet de connaître la provenance, mais ne détermine pas, à elle seule, la qualité gustative.") },
  { id: "lote", t: T("Lote ou referência", "Lot or reference", "Lote o referencia", "Lot ou référence"), tag: "oblig", s: T("Permite relacionar a carne com o animal ou grupo de animais de origem.", "Links the meat to the animal or group of animals it came from.", "Permite relacionar la carne con el animal o el grupo de animales de origen.", "Permet de relier la viande à l’animal ou au groupe d’animaux dont elle provient."), m: T("É essencial para a rastreabilidade e para eventuais recolhas de produtos.", "It is essential for traceability and for any product recalls.", "Es esencial para la trazabilidad y para posibles retiradas de productos.", "Il est essentiel pour la traçabilité et pour d’éventuels rappels de produits.") },
  { id: "abate", t: T("Estabelecimento de abate", "Slaughterhouse", "Establecimiento de sacrificio", "Établissement d’abattage"), tag: "oblig", s: T("Identifica o matadouro autorizado onde o animal foi abatido.", "Identifies the approved slaughterhouse where the animal was slaughtered.", "Identifica el matadero autorizado donde se sacrificó el animal.", "Identifie l’abattoir agréé où l’animal a été abattu."), m: T("Aparece como «Abatido em», com o país e o número de aprovação do estabelecimento.", "Shown as “Slaughtered in”, with the country and the approval number of the establishment.", "Aparece como «Sacrificado en», con el país y el número de autorización del establecimiento.", "Indiqué par la mention « Abattu en », avec le pays et le numéro d’agrément de l’établissement.") },
  { id: "desmancha", t: T("Estabelecimento de desmancha", "Cutting plant", "Sala de despiece", "Atelier de découpe"), tag: "oblig", s: T("Identifica o estabelecimento autorizado onde a carcaça foi cortada em peças.", "Identifies the approved establishment where the carcass was cut into pieces.", "Identifica el establecimiento autorizado donde la canal se despiezó.", "Identifie l’établissement agréé où la carcasse a été découpée en morceaux."), m: T("Aparece como «Desmancha em», com o país e o número de aprovação.", "Shown as “Cut in”, with the country and the approval number.", "Aparece como «Despiezado en», con el país y el número de autorización.", "Indiqué par la mention « Découpé en », avec le pays et le numéro d’agrément.") },
  { id: "corte", t: T("Denominação do corte", "Name of the cut", "Denominación del corte", "Nom du morceau"), tag: "hab", s: T("Permite identificar a peça de carne adquirida.", "Lets you identify the piece of meat you are buying.", "Permite identificar la pieza de carne que se compra.", "Permet d’identifier le morceau de viande acheté."), m: T("Exemplos: vazia, alcatra, lombo, acém. Os nomes variam entre regiões e talhos.", "Examples: vazia, alcatra, lombo, acém. Names vary between regions and butchers.", "Ejemplos: vazia, alcatra, lombo, acém. Los nombres varían según las regiones y las carnicerías.", "Exemples : vazia, alcatra, lombo, acém. Les noms varient selon les régions et les boucheries.") },
  { id: "validade", t: T("Data de validade", "Date mark", "Fecha de caducidad", "Date limite"), tag: "oblig", s: T("A indicação «Consumir até» é fundamental para a segurança alimentar.", "The “Use by” date is essential for food safety.", "La indicación «Consumir antes de» es fundamental para la seguridad alimentaria.", "La mention « À consommer jusqu’au » est essentielle pour la sécurité alimentaire."), m: T("O consumidor deve respeitar a data e as condições de conservação.", "Consumers should respect the date and the storage conditions.", "El consumidor debe respetar la fecha y las condiciones de conservación.", "Le consommateur doit respecter la date et les conditions de conservation.") },
];
const tagTxt: Record<string, string> = { oblig: T("Obrigatório na UE", "Required in the EU", "Obligatorio en la UE", "Obligatoire dans l’UE"), hab: T("Habitual", "Usual", "Habitual", "Courant"), fac: T("Facultativo", "Optional", "Facultativo", "Facultatif") };

// 4. Cartões visuais
// 5. SEUROP
const conf = [
  ["S", T("Superior", "Superior", "Superior", "Supérieure"), T("desenvolvimento muscular excecional, com perfis muito arredondados", "exceptional muscle development, with very rounded profiles", "desarrollo muscular excepcional, con perfiles muy redondeados", "développement musculaire exceptionnel, avec des profils très arrondis")],
  ["E", T("Excelente", "Excellent", "Excelente", "Excellente"), T("musculatura excelente, com perfis muito arredondados", "excellent muscling, with very rounded profiles", "musculatura excelente, con perfiles muy redondeados", "musculature excellente, avec des profils très arrondis")],
  ["U", T("Muito boa", "Very good", "Muy buena", "Très bonne"), T("musculatura muito boa, com perfis arredondados", "very good muscling, with rounded profiles", "musculatura muy buena, con perfiles redondeados", "très bonne musculature, avec des profils arrondis")],
  ["R", T("Boa", "Good", "Buena", "Bonne"), T("boa musculatura, com perfis tendencialmente retilíneos", "good muscling, with generally straight profiles", "buena musculatura, con perfiles tendentes a rectilíneos", "bonne musculature, avec des profils plutôt rectilignes")],
  ["O", T("Razoável", "Fair", "Aceptable", "Moyenne"), T("musculatura razoável, com perfis retilíneos a côncavos", "fair muscling, with straight to concave profiles", "musculatura aceptable, con perfiles de rectilíneos a cóncavos", "musculature moyenne, avec des profils de rectilignes à concaves")],
  ["P", T("Fraca", "Poor", "Escasa", "Faible"), T("musculatura fraca, com perfis côncavos", "poor muscling, with concave profiles", "musculatura escasa, con perfiles cóncavos", "musculature faible, avec des profils concaves")],
];
const fat = [
  ["1", T("Muito fraca", "Very low", "Muy baja", "Très faible"), T("cobertura de gordura muito fraca ou inexistente", "very low or no fat cover", "cobertura de grasa muy baja o inexistente", "couverture de gras très faible ou inexistante")],
  ["2", T("Fraca", "Slight", "Baja", "Faible"), T("cobertura de gordura fraca", "slight fat cover", "cobertura de grasa baja", "couverture de gras faible")],
  ["3", T("Média", "Average", "Media", "Moyenne"), T("cobertura de gordura média", "average fat cover", "cobertura de grasa media", "couverture de gras moyenne")],
  ["4", T("Forte", "High", "Alta", "Forte"), T("cobertura de gordura forte", "high fat cover", "cobertura de grasa alta", "couverture de gras forte")],
  ["5", T("Muito forte", "Very high", "Muy alta", "Très forte"), T("cobertura de gordura muito forte", "very high fat cover", "cobertura de grasa muy alta", "couverture de gras très forte")],
];
const cutsHref = href(lang, "viagem/cortes/");
const factors = [
  { t: T("Raça e genética", "Breed and genetics", "Raza y genética", "Race et génétique"), s: T("Podem influenciar o desenvolvimento muscular, a composição da carcaça e determinadas características da carne.", "They can influence muscle development, carcass composition and certain meat traits.", "Pueden influir en el desarrollo muscular, la composición de la canal y determinadas características de la carne.", "Elles peuvent influencer le développement musculaire, la composition de la carcasse et certaines caractéristiques de la viande."), m: T("Raças e cruzamentos diferentes podem dar carcaças e carnes diferentes. Cada raça autóctone portuguesa tem a sua página no Atlas.", "Different breeds and crosses can give different carcasses and meat. Each native Portuguese breed has its own page in the Atlas.", "Razas y cruces diferentes pueden dar canales y carnes diferentes. Cada raza autóctona portuguesa tiene su página en el Atlas.", "Des races et des croisements différents peuvent donner des carcasses et des viandes différentes. Chaque race autochtone portugaise a sa page dans l’Atlas."), l: [T("Ver as raças", "See the breeds", "Ver las razas", "Voir les races"), href(lang, "racas/")] },
  { t: T("Idade do animal", "Age of the animal", "Edad del animal", "Âge de l’animal"), s: T("Pode influenciar a cor, a estrutura do tecido conjuntivo e outras características da carne.", "It can influence colour, the structure of connective tissue and other meat traits.", "Puede influir en el color, la estructura del tejido conjuntivo y otras características de la carne.", "Il peut influencer la couleur, la structure du tissu conjonctif et d’autres caractéristiques de la viande."), m: T("A idade não é, em geral, indicada na embalagem; a categoria da carcaça (por exemplo, vitelo ou boi) é registada no abate.", "Age is not usually shown on the pack; the carcass category (for example veal or ox) is recorded at slaughter.", "La edad no suele indicarse en el envase; la categoría de la canal (por ejemplo, ternera o buey) se registra en el sacrificio.", "L’âge n’est en général pas indiqué sur l’emballage ; la catégorie de la carcasse (par exemple veau ou bœuf) est enregistrée à l’abattage.") },
  { t: T("Alimentação", "Feed", "Alimentación", "Alimentation"), s: T("Pode influenciar a composição da gordura e determinadas características sensoriais.", "It can influence fat composition and certain sensory traits.", "Puede influir en la composición de la grasa y en determinadas características sensoriales.", "Elle peut influencer la composition du gras et certaines caractéristiques sensorielles."), m: T("Os efeitos dependem do sistema de produção. Certificações como a DOP e a IGP podem fixar regras de alimentação no caderno de especificações.", "Effects depend on the production system. Designations such as PDO and PGI can set feeding rules in their specification document.", "Los efectos dependen del sistema de producción. Certificaciones como la DOP y la IGP pueden fijar reglas de alimentación en el pliego de condiciones.", "Les effets dépendent du système de production. Des certifications comme l’AOP et l’IGP peuvent fixer des règles d’alimentation dans leur cahier des charges.") },
  { t: T("Maturação", "Ageing", "Maduración", "Maturation"), s: T("Em condições controladas, pode melhorar a tenrura e desenvolver características de sabor.", "Under controlled conditions it can improve tenderness and develop flavour.", "En condiciones controladas, puede mejorar la terneza y desarrollar características de sabor.", "Dans des conditions contrôlées, elle peut améliorer la tendreté et développer des caractéristiques de saveur."), m: T("Não é, em geral, indicada na embalagem.", "It is not usually shown on the pack.", "No suele indicarse en el envase.", "Elle n’est en général pas indiquée sur l’emballage."), l: [T("A maturação no Atlas", "Ageing in the Atlas", "La maduración en el Atlas", "La maturation dans l’Atlas"), href(lang, "viagem/maturacao/")] },
  { t: T("Corte", "Cut", "Corte", "Morceau"), s: T("Diferentes músculos possuem características distintas de fibras e tecido conjuntivo.", "Different muscles have different fibres and connective tissue.", "Los distintos músculos tienen características diferentes de fibras y tejido conjuntivo.", "Les différents muscles ont des fibres et un tissu conjonctif aux caractéristiques distinctes."), m: T("Um corte mais económico pode dar um excelente resultado quando preparado corretamente.", "A cheaper cut can give an excellent result when prepared properly.", "Un corte más económico puede dar un excelente resultado si se prepara correctamente.", "Un morceau plus économique peut donner un excellent résultat s’il est bien préparé."), l: [T("Guia de cortes", "Cuts guide", "Guía de cortes", "Guide des morceaux"), cutsHref] },
  { t: T("Preparação", "Preparation", "Preparación", "Préparation"), s: T("A temperatura, o tempo e o método de confeção têm uma influência decisiva no resultado final.", "Temperature, time and cooking method have a decisive influence on the final result.", "La temperatura, el tiempo y el método de cocción tienen una influencia decisiva en el resultado final.", "La température, le temps et le mode de cuisson ont une influence décisive sur le résultat final."), m: T("Também a forma de cortar conta.", "How you slice it matters too.", "También importa cómo se corta.", "La façon de trancher compte aussi."), l: [T("Como cortar contra a fibra", "How to cut against the grain", "Cómo cortar contra la fibra", "Comment trancher à contre-fil"), href(lang, "viagem/contra-a-fibra/")] },
];
const tips = [
  [T("Escolhe primeiro o corte.", "Choose the cut first.", "Elige primero el corte.", "Choisissez d’abord le morceau."), T("Pensa na receita antes de escolher a carne.", "Think about the recipe before choosing the meat.", "Piensa en la receta antes de elegir la carne.", "Pensez à la recette avant de choisir la viande.")],
  [T("Verifica a origem.", "Check the origin.", "Comprueba el origen.", "Vérifiez l’origine."), T("Confirma onde o animal nasceu, foi criado e abatido.", "Check where the animal was born, reared and slaughtered.", "Confirma dónde nació, se crió y se sacrificó el animal.", "Vérifiez où l’animal est né, a été élevé et abattu.")],
  [T("Observa a gordura.", "Look at the fat.", "Observa la grasa.", "Observez le gras."), T("O marmoreado pode contribuir para a suculência e o sabor, dependendo do corte.", "Marbling can add juiciness and flavour, depending on the cut.", "El marmoleado puede contribuir a la jugosidad y al sabor, según el corte.", "Le persillé peut contribuer à la jutosité et à la saveur, selon le morceau.")],
  [T("Confirma a conservação.", "Check storage.", "Comprueba la conservación.", "Vérifiez la conservation."), T("Verifica a validade, a integridade da embalagem e as condições de refrigeração.", "Check the date, that the pack is intact and the refrigeration.", "Comprueba la fecha, la integridad del envase y las condiciones de refrigeración.", "Vérifiez la date, l’intégrité de l’emballage et les conditions de réfrigération.")],
  [T("Não confundas preço com qualidade.", "Do not confuse price with quality.", "No confundas precio con calidad.", "Ne confondez pas prix et qualité."), T("Uma carne mais cara não é necessariamente mais adequada à tua receita ou às tuas preferências.", "A more expensive meat is not necessarily better suited to your recipe or your taste.", "Una carne más cara no es necesariamente más adecuada para tu receta o tus preferencias.", "Une viande plus chère n’est pas forcément mieux adaptée à votre recette ou à vos goûts.")],
];
const concepts = [
  [T("Classificação da carcaça", "Carcass grading", "Clasificación de la canal", "Classement de la carcasse"), T("Descreve a conformação muscular e a cobertura de gordura.", "Describes muscle conformation and fat cover.", "Describe la conformación muscular y la cobertura de grasa.", "Décrit la conformation musculaire et la couverture de gras.")],
  [T("Rastreabilidade", "Traceability", "Trazabilidad", "Traçabilité"), T("Permite identificar a proveniência da carne e acompanhar o produto ao longo da cadeia de produção.", "Makes it possible to identify where the meat comes from and follow the product along the production chain.", "Permite identificar la procedencia de la carne y seguir el producto a lo largo de la cadena de producción.", "Permet d’identifier la provenance de la viande et de suivre le produit tout au long de la chaîne de production.")],
  [T("Certificação de origem", "Origin certification", "Certificación de origen", "Certification d’origine"), T("Identifica produtos que cumprem determinados requisitos de produção, origem e controlo.", "Identifies products that meet certain production, origin and control requirements.", "Identifica productos que cumplen determinados requisitos de producción, origen y control.", "Identifie les produits qui répondent à certaines exigences de production, d’origine et de contrôle.")],
  [T("Qualidade gastronómica", "Eating quality", "Calidad gastronómica", "Qualité gustative"), T("Relaciona-se com características como tenrura, sabor, suculência e textura.", "Relates to traits such as tenderness, flavour, juiciness and texture.", "Se relaciona con características como la terneza, el sabor, la jugosidad y la textura.", "Elle est liée à des caractéristiques comme la tendreté, la saveur, la jutosité et la texture.")],
];
const D = { // textos usados pelo script
  noInfo: T("Não tenho informação suficiente", "I don’t have enough information", "No tengo información suficiente", "Je n’ai pas assez d’informations"),
  cons: T("O que significa para o consumidor?", "What does it mean for the consumer?", "¿Qué significa para el consumidor?", "Que cela signifie-t-il pour le consommateur ?"),
  consTxt: T("Esta classificação descreve características da carcaça, mas não permite determinar diretamente a tenrura, o sabor ou a qualidade gastronómica de um bife.", "This grade describes characteristics of the carcass, but it does not directly tell you the tenderness, flavour or eating quality of a steak.", "Esta clasificación describe características de la canal, pero no permite determinar directamente la terneza, el sabor ni la calidad gastronómica de un filete.", "Ce classement décrit des caractéristiques de la carcasse, mais ne permet pas de déterminer directement la tendreté, la saveur ou la qualité gustative d’un steak."),
  confL: T("Conformação", "Conformation", "Conformación", "Conformation"), fatL: T("Gordura", "Fat", "Grasa", "Gras"),
};
const vaziaL = T("Bifes da vazia", "Vazia steaks", "Filetes de vazia", "Steaks de vazia");
const origL = T("Origem: Portugal", "Origin: Portugal", "Origen: Portugal", "Origine : Portugal");
---
<div class="cl" data-lang={lang}>
  <!-- 1. Introdução -->
  <section class="cl-s cl-intro reveal">
    <h3>{T("Toda a carne de bovino é igual?", "Is all beef the same?", "¿Toda la carne de vacuno es igual?", "Tout le bœuf se vaut-il ?")}</h3>
    <p class="sub">{T("Duas embalagens podem parecer iguais, ter a mesma origem e apresentar preços muito diferentes. Mas será que a mais cara é necessariamente melhor?", "Two packs can look the same, have the same origin and very different prices. But is the dearer one necessarily better?", "Dos envases pueden parecer iguales, tener el mismo origen y precios muy diferentes. Pero ¿es necesariamente mejor el más caro?", "Deux barquettes peuvent sembler identiques, avoir la même origine et des prix très différents. Mais la plus chère est-elle forcément meilleure ?")}</p>
    <p>{T("Antes de chegar ao supermercado, a carne de bovino passa por diferentes processos de avaliação e classificação. Alguns ajudam a identificar as características físicas da carcaça. Outros permitem conhecer a origem e garantir a rastreabilidade.", "Before it reaches the supermarket, beef goes through different assessment and grading processes. Some help identify the physical characteristics of the carcass. Others make it possible to know the origin and guarantee traceability.", "Antes de llegar al supermercado, la carne de vacuno pasa por diferentes procesos de evaluación y clasificación. Algunos ayudan a identificar las características físicas de la canal. Otros permiten conocer el origen y garantizar la trazabilidad.", "Avant d’arriver au supermarché, le bœuf passe par différents processus d’évaluation et de classement. Certains aident à identifier les caractéristiques physiques de la carcasse. D’autres permettent de connaître l’origine et de garantir la traçabilité.")}</p>
    <p>{T("Mas há um detalhe importante: nem todas estas informações chegam ao consumidor.", "But there is an important detail: not all of this information reaches the consumer.", "Pero hay un detalle importante: no toda esta información llega al consumidor.", "Mais il y a un détail important : toutes ces informations n’arrivent pas jusqu’au consommateur.")}</p>
    <a class="cl-btn" href="#cl-embalagem" data-scroll>{T("Descobrir como escolher melhor", "Find out how to choose better", "Descubrir cómo elegir mejor", "Découvrir comment mieux choisir")} ↓</a>
  </section>

  <!-- 2. Embalagem -->
  <section class="cl-s reveal" id="cl-embalagem">
    <span class="eyebrow">{T("No supermercado", "In the supermarket", "En el supermercado", "Au supermarché")}</span>
    <h3>{T("O que nos diz realmente uma embalagem de carne?", "What does a pack of meat really tell us?", "¿Qué nos dice realmente un envase de carne?", "Que nous dit vraiment une barquette de viande ?")}</h3>
    <p>{T("Num supermercado português encontramos normalmente a origem, o corte, o peso, o preço e a validade. Raramente encontramos a raça, a maturação ou a classificação da carcaça.", "In a Portuguese supermarket we normally find the origin, the cut, the weight, the price and the date. We rarely find the breed, the ageing or the carcass grade.", "En un supermercado portugués solemos encontrar el origen, el corte, el peso, el precio y la fecha de caducidad. Rara vez encontramos la raza, la maduración o la clasificación de la canal.", "Dans un supermarché portugais, on trouve normalement l’origine, le morceau, le poids, le prix et la date limite. On trouve rarement la race, la maturation ou le classement de la carcasse.")}</p>
    <div class="pk">
      <div class="label" role="group" aria-label={T("Etiqueta ilustrativa de uma embalagem de carne de bovino", "Illustrative label of a beef pack", "Etiqueta ilustrativa de un envase de carne de vacuno", "Étiquette illustrative d’une barquette de bœuf")}>
        <span class="lt">{T("Esquema ilustrativo", "Illustration", "Esquema ilustrativo", "Schéma illustratif")}</span>
        <button class="pt" data-pt="corte"><b>{vaziaL}</b></button>
        <button class="pt" data-pt="origem">{origL}</button>
        <button class="pt" data-pt="lote">{T("Lote / referência: ·····", "Lot / reference: ·····", "Lote / referencia: ·····", "Lot / référence : ·····")}</button>
        <button class="pt" data-pt="abate">{T("Abatido em: Portugal (n.º ·····)", "Slaughtered in: Portugal (no. ·····)", "Sacrificado en: Portugal (n.º ·····)", "Abattu en : Portugal (n° ·····)")}</button>
        <button class="pt" data-pt="desmancha">{T("Desmancha em: Portugal (n.º ·····)", "Cut in: Portugal (no. ·····)", "Despiezado en: Portugal (n.º ·····)", "Découpé en : Portugal (n° ·····)")}</button>
        <button class="pt" data-pt="validade">{T("Consumir até: ··/··/····", "Use by: ··/··/····", "Consumir antes de: ··/··/····", "À consommer jusqu’au : ··/··/····")}</button>
        <small>{T("Os números e as datas estão propositadamente em branco.", "Numbers and dates are deliberately left blank.", "Los números y las fechas están en blanco a propósito.", "Les numéros et les dates sont volontairement laissés en blanc.")}</small>
      </div>
      <div class="pk-out" aria-live="polite" id="pk-out"><p class="muted">{T("Toca numa linha da etiqueta para ver o que significa.", "Tap a line on the label to see what it means.", "Toca una línea de la etiqueta para ver qué significa.", "Touchez une ligne de l’étiquette pour voir ce qu’elle signifie.")}</p></div>
    </div>
    <script type="application/json" id="pk-data" set:html={JSON.stringify(Object.fromEntries(labelItems.map((i) => [i.id, { t: i.t, s: i.s, m: i.m, tag: tagTxt[i.tag], k: i.tag }])))} />
    <details class="cl-card"><summary>{T("O que a etiqueta normalmente não revela", "What the label does not normally tell you", "Lo que la etiqueta normalmente no revela", "Ce que l’étiquette ne révèle normalement pas")}</summary>
      <p>{T("Raça do animal, idade exata, classificação SEUROP, tempo de maturação, nível de gordura intramuscular e tenrura.", "Breed of the animal, exact age, SEUROP grade, ageing time, level of intramuscular fat and tenderness.", "Raza del animal, edad exacta, clasificación SEUROP, tiempo de maduración, nivel de grasa intramuscular y terneza.", "Race de l’animal, âge exact, classement SEUROP, durée de maturation, niveau de gras intramusculaire et tendreté.")}</p>
      <p>{T("Estes elementos podem influenciar as características da carne, mas não são, em geral, informações obrigatórias na embalagem.", "These can influence the meat, but they are not, in general, mandatory information on the pack.", "Estos elementos pueden influir en las características de la carne, pero en general no son información obligatoria en el envase.", "Ces éléments peuvent influencer les caractéristiques de la viande, mais ne sont pas, en général, des informations obligatoires sur l’emballage.")}</p>
      <p class="fine">{T("Fontes: Regulamento (CE) n.º 1760/2000, artigo 13.º (rotulagem da carne de bovino) e Regulamento (UE) n.º 1169/2011 (informação alimentar). Os produtos não pré-embalados seguem regras próprias de informação no ponto de venda.", "Sources: Regulation (EC) No 1760/2000, Article 13 (beef labelling) and Regulation (EU) No 1169/2011 (food information). Non-prepacked products follow their own rules for information at the point of sale.", "Fuentes: Reglamento (CE) n.º 1760/2000, artículo 13 (etiquetado de la carne de vacuno) y Reglamento (UE) n.º 1169/2011 (información alimentaria). Los productos no preenvasados siguen normas propias de información en el punto de venta.", "Sources : règlement (CE) n° 1760/2000, article 13 (étiquetage de la viande bovine) et règlement (UE) n° 1169/2011 (information alimentaire). Les produits non préemballés suivent leurs propres règles d’information au point de vente.")} <a href={eur("32000R1760")} rel="noopener">1760/2000 ↗</a> · <a href={eur("32011R1169")} rel="noopener">1169/2011 ↗</a></p>
    </details>
  </section>

