    <span class="eyebrow">{T("Experimenta", "Try it", "Pruébalo", "Essayez")}</span>
    <h3>{T("Consegues identificar a melhor carne?", "Can you spot the better meat?", "¿Sabrías identificar la mejor carne?", "Sauriez-vous repérer la meilleure viande ?")}</h3>
    <div class="qz">
      <div class="qp"><b>A</b><span>{vaziaL}</span><span>{origL}</span><span>400 g</span><span>6,00 €</span><strong>15,00 €/kg</strong></div>
      <div class="qp"><b>B</b><span>{vaziaL}</span><span>{origL}</span><span>400 g</span><span>10,00 €</span><strong>25,00 €/kg</strong></div>
