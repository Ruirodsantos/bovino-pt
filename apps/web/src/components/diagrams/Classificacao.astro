    <div class="qa" id="qa" hidden aria-live="polite">
      <p><strong>{T("Com estas informações, não é possível determinar qual tem melhor qualidade gastronómica.", "With this information, it is not possible to tell which has better eating quality.", "Con esta información, no es posible determinar cuál tiene mejor calidad gastronómica.", "Avec ces informations, il est impossible de déterminer laquelle a la meilleure qualité gustative.")}</strong></p>
      <p>{T("Sabemos que ambas são vazia de bovino com origem portuguesa. Mas não sabemos:", "We know both are beef vazia from Portugal. But we do not know:", "Sabemos que ambas son vazia de vacuno de origen portugués. Pero no sabemos:", "Nous savons que les deux sont de la vazia de bœuf d’origine portugaise. Mais nous ne savons pas :")}</p>
      <ul>{[T("a raça ou o cruzamento", "the breed or cross", "la raza o el cruce", "la race ou le croisement"), T("a idade do animal", "the age of the animal", "la edad del animal", "l’âge de l’animal"), T("o processo de maturação", "the ageing process", "el proceso de maduración", "le processus de maturation"), T("a tenrura", "the tenderness", "la terneza", "la tendreté"), T("a quantidade de gordura intramuscular", "the amount of intramuscular fat", "la cantidad de grasa intramuscular", "la quantité de gras intramusculaire"), T("as condições específicas de produção", "the specific production conditions", "las condiciones específicas de producción", "les conditions de production spécifiques")].map((x) => <li>{x}</li>)}</ul>
      <p>{T("A carne mais cara não é necessariamente a melhor. E a carne mais barata não é necessariamente inferior.", "The dearer meat is not necessarily the better. And the cheaper meat is not necessarily worse.", "La carne más cara no es necesariamente la mejor. Y la más barata no es necesariamente inferior.", "La viande la plus chère n’est pas forcément la meilleure. Et la viande la moins chère n’est pas forcément inférieure.")}</p>
      <p class="fine">{T("Os preços apresentados são meramente ilustrativos.", "The prices shown are purely illustrative.", "Los precios mostrados son meramente ilustrativos.", "Les prix indiqués sont purement illustratifs.")}</p>
    </div>
  </section>

  <!-- 4. Avaliar a olho -->
  <section class="cl-s reveal">
    <span class="eyebrow">{T("Antes de comprar", "Before you buy", "Antes de comprar", "Avant d’acheter")}</span>
    <h3>{T("O que podemos observar antes de comprar?", "What can we look at before buying?", "¿Qué podemos observar antes de comprar?", "Que pouvons-nous observer avant d’acheter ?")}</h3>
    <div class="cards4">
      <article class="vc">
        <h4>{T("Gordura intramuscular", "Intramuscular fat", "Grasa intramuscular", "Gras intramusculaire")}</h4><p>{T("Os pequenos veios de gordura distribuídos pelo músculo podem contribuir para a suculência, o sabor e a sensação de tenrura.", "The small veins of fat spread through the muscle can contribute to juiciness, flavour and a sense of tenderness.", "Las pequeñas vetas de grasa repartidas por el músculo pueden contribuir a la jugosidad, el sabor y la sensación de terneza.", "Les fines veines de gras réparties dans le muscle peuvent contribuer à la jutosité, à la saveur et à la sensation de tendreté.")}</p>
        <details><summary>{T("Saber mais", "Learn more", "Saber más", "En savoir plus")}</summary><p>{T("O marmoreado não é o mesmo que a gordura exterior da peça. A quantidade ideal depende do corte, do método de preparação e das preferências pessoais.", "Marbling is not the same as the outer fat of the piece. The ideal amount depends on the cut, the method of preparation and personal taste.", "El marmoleado no es lo mismo que la grasa exterior de la pieza. La cantidad ideal depende del corte, del método de preparación y de las preferencias personales.", "Le persillé n’est pas la même chose que le gras extérieur de la pièce. La quantité idéale dépend du morceau, du mode de préparation et des préférences personnelles.")}</p></details></article>
      <article class="vc"><figure class="fr two"><img src={`${b}img/classif/t-bone.jpg`} alt={T("Peça de T-bone crua, vermelho vivo", "Raw T-bone, bright red", "Pieza de T-bone cruda, rojo vivo", "Morceau de T-bone cru, rouge vif")} loading="lazy" /><img src={`${b}img/classif/vazia.jpg`} alt={T("Peça de flank steak crua, vermelho mais escuro", "Raw flank steak, darker red", "Pieza de flank steak cruda, rojo más oscuro", "Morceau de flank steak cru, rouge plus foncé")} loading="lazy" /></figure>
        <span class="cr">{T("Fotos: MCB (CC BY-SA 2.5) e Bortz60 (CC BY-SA 3.0), Wikimedia Commons. Cortes e luz diferentes: servem só para mostrar que o vermelho varia.", "Photos: MCB (CC BY-SA 2.5) and Bortz60 (CC BY-SA 3.0), Wikimedia Commons. Different cuts and lighting: they only show that red varies.", "Fotos: MCB (CC BY-SA 2.5) y Bortz60 (CC BY-SA 3.0), Wikimedia Commons. Cortes y luz diferentes: solo sirven para mostrar que el rojo varía.", "Photos : MCB (CC BY-SA 2.5) et Bortz60 (CC BY-SA 3.0), Wikimedia Commons. Morceaux et éclairages différents : ils servent seulement à montrer que le rouge varie.")}</span>
        <h4>{T("Cor da carne", "Colour of the meat", "Color de la carne", "Couleur de la viande")}</h4><p>{T("A carne de bovino pode apresentar diferentes tonalidades de vermelho. Uma cor mais escura não significa necessariamente carne estragada, e uma cor mais viva não garante maior frescura.", "Beef can show different shades of red. A darker colour does not necessarily mean spoiled meat, and a brighter colour does not guarantee freshness.", "La carne de vacuno puede presentar diferentes tonalidades de rojo. Un color más oscuro no significa necesariamente carne en mal estado, y un color más vivo no garantiza mayor frescura.", "Le bœuf peut présenter différentes nuances de rouge. Une couleur plus foncée ne signifie pas forcément que la viande est avariée, et une couleur plus vive ne garantit pas une plus grande fraîcheur.")}</p>
        <details><summary>{T("Saber mais", "Learn more", "Saber más", "En savoir plus")}</summary><p>{T("A cor depende de vários fatores, incluindo a idade do animal, a concentração de mioglobina, a exposição ao oxigénio e o tipo de embalagem.", "Colour depends on several factors, including the age of the animal, the concentration of myoglobin, exposure to oxygen and the type of packaging.", "El color depende de varios factores, entre ellos la edad del animal, la concentración de mioglobina, la exposición al oxígeno y el tipo de envase.", "La couleur dépend de plusieurs facteurs, notamment l’âge de l’animal, la concentration de myoglobine, l’exposition à l’oxygène et le type d’emballage.")}</p></details></article>
      <article class="vc">
        <h4>{T("Líquido na embalagem", "Liquid in the pack", "Líquido en el envase", "Liquide dans la barquette")}</h4><p>{T("É normal que a carne liberte alguma água durante a conservação. Uma quantidade elevada pode estar associada a maior perda de líquidos, mas não permite, isoladamente, determinar a qualidade ou a segurança do produto.", "It is normal for meat to release some water during storage. A large amount can be associated with greater fluid loss, but on its own it does not tell you the quality or safety of the product.", "Es normal que la carne libere algo de agua durante la conservación. Una cantidad elevada puede estar asociada a una mayor pérdida de líquidos, pero por sí sola no permite determinar la calidad ni la seguridad del producto.", "Il est normal que la viande libère un peu d’eau pendant la conservation. Une grande quantité peut être associée à une plus grande perte de liquides, mais elle ne permet pas, à elle seule, de juger la qualité ou la sécurité du produit.")}</p></article>
      <article class="vc">
        <h4>{T("O corte certo", "The right cut", "El corte adecuado", "Le bon morceau")}</h4><p>{T("Nem todos os cortes são adequados às mesmas receitas. Um corte mais económico pode produzir um excelente resultado quando preparado corretamente.", "Not all cuts suit the same recipes. A cheaper cut can give an excellent result when prepared properly.", "No todos los cortes sirven para las mismas recetas. Un corte más económico puede dar un excelente resultado si se prepara correctamente.", "Tous les morceaux ne conviennent pas aux mêmes recettes. Un morceau plus économique peut donner un excellent résultat s’il est bien préparé.")}</p>
        <details><summary>{T("Saber mais", "Learn more", "Saber más", "En savoir plus")}</summary><p>{T("Os músculos que mais trabalham têm mais tecido conjuntivo e colagénio: pedem cozedura lenta e húmida, que transforma o colagénio em gelatina e torna a carne tenra.", "Muscles that work most have more connective tissue and collagen: they need slow, moist cooking, which turns collagen into gelatine and makes the meat tender.", "Los músculos que más trabajan tienen más tejido conjuntivo y colágeno: piden una cocción lenta y húmeda, que transforma el colágeno en gelatina y hace tierna la carne.", "Les muscles qui travaillent le plus ont plus de tissu conjonctif et de collagène : ils demandent une cuisson lente et humide, qui transforme le collagène en gélatine et rend la viande tendre.")} <a href={cutsHref}>{T("Ver o guia de cortes →", "See the cuts guide →", "Ver la guía de cortes →", "Voir le guide des morceaux →")}</a></p></details></article>
    </div>
  </section>

  <!-- 5. SEUROP -->
  <section class="cl-s reveal" id="cl-seurop">
    <span class="eyebrow">{T("Nível técnico", "Technical level", "Nivel técnico", "Niveau technique")}</span>
    <h3>{T("Então o que é a classificação SEUROP?", "So what is SEUROP grading?", "Entonces, ¿qué es la clasificación SEUROP?", "Alors, qu’est-ce que le classement SEUROP ?")}</h3>
    <p>{T("Depois do abate, as carcaças de bovinos abrangidas pelo sistema europeu de classificação são avaliadas segundo duas características: a conformação muscular e a cobertura de gordura. Esta avaliação ajuda a caracterizar e comercializar as carcaças. Não é uma classificação direta do sabor ou da tenrura da carne.", "After slaughter, the carcasses of bovines covered by the European grading system are assessed on two characteristics: muscle conformation and fat cover. This helps describe and trade carcasses. It is not a direct grade of the flavour or tenderness of the meat.", "Tras el sacrificio, las canales de bovinos incluidas en el sistema europeo de clasificación se evalúan según dos características: la conformación muscular y la cobertura de grasa. Esta evaluación ayuda a caracterizar y comercializar las canales. No es una clasificación directa del sabor ni de la terneza de la carne.", "Après l’abattage, les carcasses de bovins couvertes par le système européen de classement sont évaluées selon deux caractéristiques : la conformation musculaire et la couverture de gras. Cette évaluation aide à caractériser et à commercialiser les carcasses. Ce n’est pas un classement direct de la saveur ou de la tendreté de la viande.")}</p>
    <div class="sg2">
      <div><h4>{T("A · Conformação", "A · Conformation", "A · Conformación", "A · Conformation")}</h4><ul class="scale">{conf.map(([c, n, d]) => <li><b>{c}</b> {n}</li>)}</ul></div>
      <div><h4>{T("B · Gordura", "B · Fat", "B · Grasa", "B · Gras")}</h4><ul class="scale">{fat.map(([c, n, d]) => <li><b>{c}</b> {n}</li>)}</ul><p class="fine">{T("Avalia a cobertura de gordura da carcaça, não o marmoreado dos bifes.", "It assesses the fat cover of the carcass, not the marbling of the steaks.", "Evalúa la cobertura de grasa de la canal, no el marmoleado de los filetes.", "Elle évalue la couverture de gras de la carcasse, pas le persillé des steaks.")}</p></div>
    </div>
    <p class="fine">{T("Ilustrações ou fotografias oficiais de carcaças para cada classe: em recolha.", "Official illustrations or photographs of carcasses for each class: being sourced.", "Ilustraciones o fotografías oficiales de canales para cada clase: en recopilación.", "Illustrations ou photographies officielles de carcasses pour chaque classe : en cours de collecte.")}</p>
    <h4>{T("C · Tabela SEUROP: escolhe uma combinação", "C · SEUROP table: pick a combination", "C · Tabla SEUROP: elige una combinación", "C · Tableau SEUROP : choisissez une combinaison")}</h4>
    <div class="grid" role="grid" aria-label={T("Tabela SEUROP", "SEUROP table", "Tabla SEUROP", "Tableau SEUROP")}>
      <div class="gh corner">{T("conformação ↓ · gordura →", "conformation ↓ · fat →", "conformación ↓ · grasa →", "conformation ↓ · gras →")}</div>
      {fat.map(([f]) => <div class="gh">{f}</div>)}
      {conf.map(([c]) => <><div class="gh">{c}</div>{fat.map(([f]) => <button class="gc" data-s={`${c}${f}`}>{c}{f}</button>)}</>)}
    </div>
    <div class="sg-out" id="sg-out" aria-live="polite"><p class="muted">{T("Escolhe uma célula da tabela, por exemplo R3.", "Pick a cell in the table, for example R3.", "Elige una celda de la tabla, por ejemplo R3.", "Choisissez une case du tableau, par exemple R3.")}</p></div>
    <p class="warn">{T("As classes de conformação e gordura não constituem, por si só, uma escala de qualidade gastronómica.", "The conformation and fat classes are not, on their own, a scale of eating quality.", "Las clases de conformación y de grasa no constituyen, por sí solas, una escala de calidad gastronómica.", "Les classes de conformation et de gras ne constituent pas, à elles seules, une échelle de qualité gustative.")}</p>
    <script type="application/json" id="sg-data" set:html={JSON.stringify({ conf: Object.fromEntries(conf.map(([c, n, d]) => [c, [n, d]])), fat: Object.fromEntries(fat.map(([c, n, d]) => [c, [n, d]])), D })} />
    <p class="fine">{T("Fontes: Regulamento (UE) n.º 1308/2013 e Regulamento Delegado (UE) 2017/1182. A classificação não é obrigatória em matadouros pequenos (menos de 150 bovinos adultos por semana, em média anual), nos termos do regulamento.", "Sources: Regulation (EU) No 1308/2013 and Delegated Regulation (EU) 2017/1182. Grading is not compulsory in small slaughterhouses (fewer than 150 adult bovines a week, annual average), under the regulation.", "Fuentes: Reglamento (UE) n.º 1308/2013 y Reglamento Delegado (UE) 2017/1182. La clasificación no es obligatoria en mataderos pequeños (menos de 150 bovinos adultos por semana, de media anual), según el reglamento.", "Sources : règlement (UE) n° 1308/2013 et règlement délégué (UE) 2017/1182. Le classement n’est pas obligatoire dans les petits abattoirs (moins de 150 bovins adultes par semaine, en moyenne annuelle), aux termes du règlement.")} <a href={eur("32013R1308")} rel="noopener">1308/2013 ↗</a> · <a href={eur("32017R1182")} rel="noopener">2017/1182 ↗</a></p>
  </section>

  <!-- 6. SEUROP na embalagem -->
  <section class="cl-s reveal">
    <h3>{T("Porque não encontro S2, R3 ou U3 no supermercado?", "Why can’t I find S2, R3 or U3 in the supermarket?", "¿Por qué no encuentro S2, R3 o U3 en el supermercado?", "Pourquoi je ne trouve pas S2, R3 ou U3 au supermarché ?")}</h3>
    <p>{T("Porque a classificação SEUROP é utilizada principalmente na avaliação e comercialização de carcaças. Não existe uma obrigação geral de a apresentar nas embalagens de carne de bovino vendidas ao consumidor. Por isso, é normal que uma embalagem de bifes não indique qualquer código SEUROP.", "Because SEUROP grading is used mainly to assess and trade carcasses. There is no general obligation to show it on beef packs sold to consumers. So it is normal for a pack of steaks to carry no SEUROP code.", "Porque la clasificación SEUROP se utiliza principalmente en la evaluación y comercialización de canales. No existe una obligación general de mostrarla en los envases de carne de vacuno vendidos al consumidor. Por eso es normal que un envase de filetes no indique ningún código SEUROP.", "Parce que le classement SEUROP est utilisé principalement pour l’évaluation et la commercialisation des carcasses. Il n’existe pas d’obligation générale de l’afficher sur les emballages de bœuf vendus au consommateur. Il est donc normal qu’une barquette de steaks n’indique aucun code SEUROP.")}</p>
    <details class="cl-card"><summary>{T("Saber mais: quatro conceitos que não se devem confundir", "Learn more: four concepts not to be confused", "Saber más: cuatro conceptos que no se deben confundir", "En savoir plus : quatre notions à ne pas confondre")}</summary>
      <dl>{concepts.map(([a, d]) => <><dt>{a}</dt><dd>{d}</dd></>)}</dl>
      <p class="fine">{T("Exemplo de fora de Portugal: embalagens de um supermercado australiano, com o selo do sistema australiano de classificação de qualidade (MSA). Em Portugal, a etiqueta não traz, em geral, um selo deste tipo.", "An example from outside Portugal: packs in an Australian supermarket, with the seal of the Australian eating-quality grading scheme (MSA). In Portugal the label does not generally carry a seal of this kind.", "Ejemplo de fuera de Portugal: envases de un supermercado australiano, con el sello del sistema australiano de clasificación de calidad (MSA). En Portugal, la etiqueta no suele llevar un sello de este tipo.", "Exemple hors du Portugal : des barquettes d’un supermarché australien, avec le sceau du système australien de classement de la qualité (MSA). Au Portugal, l’étiquette ne porte généralement pas de sceau de ce type.")}</p>
    </details>
  </section>

  <!-- 7. DOP / IGP -->
  <section class="cl-s reveal">
    <h3>{T("Uma carne certificada é necessariamente melhor?", "Is certified meat necessarily better?", "¿Una carne certificada es necesariamente mejor?", "Une viande certifiée est-elle forcément meilleure ?")}</h3>
    <p>{T("Portugal possui carnes de bovino com Denominação de Origem Protegida (DOP) e Indicação Geográfica Protegida (IGP). Estas certificações identificam produtos que cumprem regras específicas relacionadas com a origem e a produção.", "Portugal has beef with Protected Designation of Origin (PDO) and Protected Geographical Indication (PGI). These certifications identify products that meet specific rules on origin and production.", "Portugal cuenta con carnes de vacuno con Denominación de Origen Protegida (DOP) e Indicación Geográfica Protegida (IGP). Estas certificaciones identifican productos que cumplen normas específicas relacionadas con el origen y la producción.", "Le Portugal compte des viandes bovines sous Appellation d’origine protégée (AOP) et Indication géographique protégée (IGP). Ces certifications identifient des produits qui respectent des règles spécifiques liées à l’origine et à la production.")}</p>
    <div class="two">
      <div class="vc2"><h4>{T("DOP", "DOP", "DOP", "AOP")}</h4><p>{T("Produtos cuja qualidade ou características estão essencial ou exclusivamente ligadas a um meio geográfico específico, incluindo fatores naturais e humanos, e cujas fases de produção relevantes decorrem na área definida.", "Products whose quality or characteristics are essentially or exclusively due to a particular geographical environment, including natural and human factors, and whose relevant production steps take place in the defined area.", "Productos cuya calidad o características se deben esencial o exclusivamente a un medio geográfico específico, incluidos los factores naturales y humanos, y cuyas fases de producción pertinentes tienen lugar en la zona definida.", "Produits dont la qualité ou les caractéristiques sont dues essentiellement ou exclusivement à un milieu géographique particulier, avec ses facteurs naturels et humains, et dont les étapes de production concernées ont lieu dans l’aire définie.")}</p></div>
      <div class="vc2"><h4>IGP</h4><p>{T("Produtos cuja qualidade, reputação ou outra característica está associada à origem geográfica, exigindo que pelo menos uma das fases de produção ocorra na área delimitada.", "Products whose quality, reputation or other characteristic is linked to their geographical origin, requiring at least one of the production steps to take place in the defined area.", "Productos cuya calidad, reputación u otra característica está vinculada a su origen geográfico, y para los que al menos una de las fases de producción debe tener lugar en la zona delimitada.", "Produits dont la qualité, la réputation ou une autre caractéristique est liée à l’origine géographique, et dont au moins une des étapes de production doit avoir lieu dans l’aire délimitée.")}</p></div>
    </div>
    <p>{T("Uma certificação DOP ou IGP não significa automaticamente que todos os consumidores irão considerar essa carne mais saborosa ou tenra. Significa que o produto respeita um conjunto de regras verificáveis.", "A PDO or PGI does not automatically mean every consumer will find that meat tastier or more tender. It means the product follows a set of verifiable rules.", "Una certificación DOP o IGP no significa automáticamente que todos los consumidores vayan a considerar esa carne más sabrosa o tierna. Significa que el producto respeta un conjunto de normas verificables.", "Une certification AOP ou IGP ne signifie pas automatiquement que tous les consommateurs trouveront cette viande plus savoureuse ou plus tendre. Elle signifie que le produit respecte un ensemble de règles vérifiables.")}</p>
    <p><a href={href(lang, "racas/")}>{T("Ver as raças e as carnes certificadas →", "See the breeds and certified meats →", "Ver las razas y las carnes certificadas →", "Voir les races et les viandes certifiées →")}</a></p>
    <p class="fine">{T("Definições segundo o regime europeu de indicações geográficas (Regulamento (UE) n.º 1151/2012, hoje substituído pelo Regulamento (UE) 2024/1143). Texto em revisão face ao novo regulamento.", "Definitions under the European geographical-indications scheme (Regulation (EU) No 1151/2012, now replaced by Regulation (EU) 2024/1143). Wording under review against the new regulation.", "Definiciones según el régimen europeo de indicaciones geográficas (Reglamento (UE) n.º 1151/2012, hoy sustituido por el Reglamento (UE) 2024/1143). Texto en revisión respecto al nuevo reglamento.", "Définitions selon le régime européen des indications géographiques (règlement (UE) n° 1151/2012, aujourd’hui remplacé par le règlement (UE) 2024/1143). Texte en cours de révision au regard du nouveau règlement.")} <a href={eur("32024R1143")} rel="noopener">2024/1143 ↗</a></p>
  </section>

  <!-- 8. Fatores -->
  <section class="cl-s reveal">
    <h3>{T("Porque é que dois bifes podem ser tão diferentes?", "Why can two steaks be so different?", "¿Por qué dos filetes pueden ser tan diferentes?", "Pourquoi deux steaks peuvent-ils être si différents ?")}</h3>
    <div class="fx">{factors.map((f) => (
      <details class="fxi"><summary><b>{f.t}</b><span>{f.s}</span></summary><p>{f.m}{f.l && <> <a href={f.l[1]}>{f.l[0]} →</a></>}</p></details>
    ))}</div>
  </section>

  <!-- 9. Guia prático -->
  <section class="cl-s reveal cl-end">
    <h3>{T("Na próxima vez que comprares carne, lembra-te disto.", "Next time you buy meat, remember this.", "La próxima vez que compres carne, recuerda esto.", "La prochaine fois que vous achèterez de la viande, souvenez-vous de ceci.")}</h3>
    <ol class="tips">{tips.map(([a, d]) => <li><strong>{a}</strong><span>{d}</span></li>)}</ol>
    <p class="final">{T("Comprar melhor não significa necessariamente comprar mais caro. Significa compreender aquilo que estamos a comprar.", "Buying better does not necessarily mean paying more. It means understanding what we are buying.", "Comprar mejor no significa necesariamente comprar más caro. Significa entender lo que estamos comprando.", "Mieux acheter ne signifie pas forcément acheter plus cher. Cela signifie comprendre ce que nous achetons.")}</p>
    <p class="fine"><span class="chip wait">{T("Texto original · em revisão", "Original text · under review", "Texto original · en revisión", "Texte original · en cours de révision")}</span></p>
  </section>
</div>

<style is:global>
  .cl { grid-column: 1 / -1; }
  .cl-s { padding: 2.2rem 0; border-top: 1px solid var(--line); max-width: 52rem; }
  .cl-s:first-child { border-top: 0; }
  .stg-body .cl h3, .cl h3 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: .2em 0 .5em; line-height: 1.2; color: var(--char); font-weight: 500; }
  .cl h4 { font-size: 1.05rem; margin: 1.2em 0 .4em; }
  .cl .sub { font-size: 1.1rem; color: var(--green-deep); }
  .cl .fine { font-size: .8rem; color: var(--muted); }
  .cl-btn { display: inline-block; margin-top: .6rem; padding: 12px 20px; border-radius: 999px; background: var(--green-deep); color: var(--ivory) !important; text-decoration: none; font-weight: 500; }
  .cl-card { margin-top: 1.2rem; border: 1px solid var(--line); border-radius: 14px; padding: 4px 16px; background: #fff; }
  .cl details > summary { cursor: pointer; padding: 12px 0; font-weight: 500; list-style: none; display: flex; justify-content: space-between; gap: 12px; min-height: 44px; align-items: center; }
  .cl details > summary::-webkit-details-marker { display: none; } .cl details > summary::after { content: "+"; font-size: 1.3rem; color: var(--green); transition: transform .3s var(--ease); flex: none; }
  .cl details[open] > summary::after { transform: rotate(45deg); }
  .cl summary:focus-visible, .cl button:focus-visible, .cl a:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; border-radius: 6px; }
  .pk { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: start; margin-top: 1rem; }
  .label { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 34px 14px 12px; display: grid; gap: 6px; box-shadow: 0 10px 30px -22px #183c3299; }
  .label .lt { position: absolute; top: 10px; left: 14px; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .pt { font: inherit; font-size: .92rem; text-align: left; background: var(--ivory-2); border: 1px solid transparent; border-radius: 8px; padding: 9px 12px; cursor: pointer; color: var(--char); min-height: 44px; }
  .pt:hover, .pt.on { border-color: var(--green); background: var(--green-soft); }
  .pk-out { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; min-height: 9rem; }
  .pk-out h4 { margin: 0 0 .3em; } .tg { display: inline-block; font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; padding: 2px 8px; border-radius: 99px; background: var(--green-soft); color: var(--green-deep); margin-bottom: 6px; } .tg.hab { background: #f3ead2; color: #6b5517; }
  .qz { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 1rem 0; }
  .qp { border: 1px solid var(--line); background: #fff; border-radius: 14px; padding: 14px 16px; display: grid; gap: 2px; font-size: .95rem; } .qp b { font-size: 1.5rem; color: var(--green); } .qp strong { font-size: 1.1rem; margin-top: 6px; }
  .q { font-weight: 500; margin: .8rem 0 .4rem; }
  .qb { display: flex; flex-wrap: wrap; gap: 8px; } .qb button { font: inherit; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--green-deep); background: transparent; color: var(--green-deep); cursor: pointer; min-height: 44px; }
  .qb button:hover, .qb button.on { background: var(--green-deep); color: var(--ivory); }
  .qa { margin-top: 1rem; padding: 16px 18px; border-left: 3px solid var(--gold); background: var(--ivory-2); border-radius: 0 12px 12px 0; } .qa[hidden] { display: none; }
  .cards4 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin-top: 1rem; } .cl-s:has(.cards4) { max-width: none; }
  .vc h4 { margin-top: .8em; } .vc p { font-size: .94rem; margin: .3em 0; } .vc .cr, .aus .cr { display: block; font-size: .7rem; color: var(--muted); margin-top: 4px; }
  .fr { margin: 0; aspect-ratio: 4/3; border-radius: 12px; overflow: hidden; background: var(--ivory-2); } .fr img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fr.two { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; } .fr.fph2 { display: grid; place-content: center; text-align: center; color: var(--muted); border: 1px dashed var(--line); font-size: .9rem; } .fr.fph2 small { display: block; font-size: .72rem; }
  .vc .cr { margin-bottom: 6px; }
  .scale { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; font-size: .95rem; } .scale b { display: inline-block; width: 1.6em; color: var(--green); }
  .sg2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .grid { display: grid; grid-template-columns: 1.3fr repeat(5, 1fr); gap: 4px; text-align: center; margin: .6rem 0; max-width: 34rem; }
  .gh { font-weight: 600; color: var(--green); font-size: .85rem; align-self: center; } .gh.corner { font-size: .62rem; font-weight: 400; color: var(--muted); text-align: left; }
  .gc { font: inherit; font-size: .85rem; padding: 10px 0; border-radius: 8px; border: 0; background: #f0eee6; color: var(--char); cursor: pointer; min-height: 40px; } .gc:hover { background: var(--green-soft); } .gc.on { background: var(--green-deep); color: var(--ivory); }
  .sg-out { border: 1px solid var(--line); background: #fff; border-radius: 12px; padding: 14px 18px; max-width: 34rem; } .sg-out p { margin: .3em 0; }
  .warn { font-size: .88rem; padding: 10px 14px; border-radius: 10px; background: #f7efdc; border: 1px solid var(--gold); max-width: 34rem; }
  .cl dl { margin: 0; } .cl dt { font-weight: 600; margin-top: .8em; } .cl dd { margin: .15em 0 0; }
  .aus { margin: 1.2rem 0 .6rem; } .aus img { width: 100%; max-width: 30rem; border-radius: 12px; display: block; } .aus figcaption { font-size: .85rem; color: var(--muted); margin-top: 6px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 1rem 0; } .vc2 { border-top: 2px solid var(--green); padding-top: 8px; } .vc2 h4 { margin-top: 0; }
  .fxi { border-top: 1px solid var(--line); } .fxi:last-child { border-bottom: 1px solid var(--line); } .fxi summary { display: grid !important; grid-template-columns: 1fr auto; gap: 2px 12px; } .fxi summary span { grid-column: 1; font-weight: 400; font-size: .92rem; color: var(--muted); } .fxi summary::after { grid-column: 2; grid-row: 1 / span 2; }
  .tips { list-style: none; counter-reset: t; padding: 0; display: grid; gap: 10px; } .tips li { counter-increment: t; display: grid; grid-template-columns: 2.2rem 1fr; gap: 0 8px; } .tips li::before { content: counter(t); grid-row: 1 / span 2; font-size: 1.6rem; color: var(--gold); line-height: 1; } .tips span { color: var(--muted); font-size: .95rem; }
  .final { font-size: 1.2rem; color: var(--green-deep); margin-top: 1.4rem; max-width: 36rem; }
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .8s var(--ease), transform .8s var(--ease); } .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
  @media (max-width: 700px) { .pk, .qz, .cards4, .sg2, .two { grid-template-columns: 1fr; } .grid { grid-template-columns: 1.1fr repeat(5, 1fr); } }
</style>
<script>
  const root = document.querySelector<HTMLElement>(".cl");
  if (root) {
    const J = (id: string) => JSON.parse(document.getElementById(id)!.textContent || "{}");
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));
    const pk = J("pk-data"), out = document.getElementById("pk-out")!;
    root.querySelectorAll<HTMLButtonElement>(".pt").forEach((b) => b.addEventListener("click", () => {
      root.querySelectorAll(".pt").forEach((x) => x.classList.toggle("on", x === b));
      const d = pk[b.dataset.pt!]; out.innerHTML = `<span class="tg ${d.k}">${esc(d.tag)}</span><h4>${esc(d.t)}</h4><p>${esc(d.s)}</p><p>${esc(d.m)}</p>`;
    }));
    const qa = document.getElementById("qa")!;
    root.querySelectorAll<HTMLButtonElement>("[data-q]").forEach((b) => b.addEventListener("click", () => { root.querySelectorAll("[data-q]").forEach((x) => x.classList.toggle("on", x === b)); qa.hidden = false; }));
    const sg = J("sg-data"), so = document.getElementById("sg-out")!;
    root.querySelectorAll<HTMLButtonElement>(".gc").forEach((b) => b.addEventListener("click", () => {
      root.querySelectorAll(".gc").forEach((x) => x.classList.toggle("on", x === b));
      const k = b.dataset.s!, c = sg.conf[k[0]], f = sg.fat[k[1]];
      so.innerHTML = `<h4 style="margin-top:0">${k}</h4><p><b>${esc(sg.D.confL)} ${k[0]}</b> (${esc(c[0])}): ${esc(c[1])}.</p><p><b>${esc(sg.D.fatL)} ${k[1]}</b> (${esc(f[0])}): ${esc(f[1])}.</p><p><b>${esc(sg.D.cons)}</b><br>${esc(sg.D.consTxt)}</p>`;
    }));
    root.querySelectorAll<HTMLAnchorElement>("[data-scroll]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); const t = document.querySelector(a.getAttribute("href")!); t?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); }));
    const els = root.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) els.forEach((e) => e.classList.add("in"));
    else { const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.08 }); els.forEach((e) => io.observe(e)); }
  }
</script>
