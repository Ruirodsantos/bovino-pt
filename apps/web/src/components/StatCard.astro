---
import { fmt, fmtDate, type Stat } from "../lib/data";
interface Props { stat: Stat; big?: boolean }
const { stat, big = false } = Astro.props;
const display = fmt(stat.value, stat.unit);
const unitShown = stat.unit === "€" || display.includes("milhões") ? (stat.unit === "€" ? "" : stat.unit) : stat.unit;
const ch = stat.change;
const base = import.meta.env.BASE_URL;
---
<article class:list={["stat card reveal", { big }]}>
  <div class="value" data-count={stat.value} data-unit={stat.unit}>{display}<span class="unit"> {unitShown}</span></div>
  <div class="label">{stat.label}</div>
  <div class="context">{stat.context}
    {typeof ch === "number" && <span class:list={["delta", ch >= 0 ? "up" : "down"]}>{ch >= 0 ? "▲" : "▼"} {Math.abs(ch * 100).toLocaleString("pt-PT", { maximumFractionDigits: 1 })}% vs {stat.change_ref}</span>}
  </div>
  <footer>
    <span class="chip ok">Verificado</span>
    <span>Fonte: {stat.footnote.source} (<a href={`${base}dados/#${stat.footnote.dataset}`} class="mono">{stat.footnote.source_code}</a>) · Ref.: {stat.footnote.period} · Publicado: {fmtDate(stat.footnote.published)} · Verificado: {fmtDate(stat.footnote.verified)}</span>
  </footer>
</article>
<style>
  .stat { display: flex; flex-direction: column; gap: 6px; }
  .value { font: 600 clamp(2.2rem, 5vw, 3.2rem)/1 var(--display); font-variation-settings: "opsz" 144; letter-spacing: -0.02em; font-feature-settings: "tnum"; }
  .big .value { font-size: clamp(3rem, 9vw, 5.6rem); }
  .unit { font: 400 1rem var(--sans); color: var(--muted); letter-spacing: 0; }
  .label { font-weight: 600; font-size: 1.05rem; }
  .context { color: var(--muted); font-size: .92rem; }
  .delta { margin-left: 8px; font-weight: 600; }
  .delta.up { color: var(--pasture); } .delta.down { color: var(--accent); }
  footer { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); font-size: .74rem; color: var(--muted); display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
</style>
