---
import { fmt, fmtDate, num, type Stat } from "../lib/data";
import { href, tr, type Lang } from "../i18n";
interface Props { stat: Stat; big?: boolean; lang?: Lang }
const { stat, big = false, lang = "pt" } = Astro.props;
const T = tr(lang);
const display = fmt(stat.value, stat.unit, lang);
const UNITS: Record<string, string> = { "cabeças": "head", "toneladas": "tonnes" };
const unit = lang === "en" ? (UNITS[stat.unit] ?? stat.unit) : stat.unit;
const unitShown = stat.unit === "€" ? "" : unit;
const label = lang === "en" ? (stat.label_en ?? stat.label) : stat.label;
const context = lang === "en" ? (stat.context_en ?? stat.context) : stat.context;
const changeRef = lang === "en" ? (stat.change_ref_en ?? stat.change_ref) : stat.change_ref;
const period = lang === "en" ? (stat.footnote.period_en ?? stat.footnote.period) : stat.footnote.period;
const ch = stat.change;
---
<article class:list={["stat card reveal", { big }]}>
  <div class="value" data-count={stat.value} data-unit={stat.unit}>{display}<span class="unit"> {unitShown}</span></div>
  <div class="label">{label}</div>
  <div class="context">{context}
    {typeof ch === "number" && <span class:list={["delta", ch >= 0 ? "up" : "down"]}>{ch >= 0 ? "▲" : "▼"} {num(Math.abs(ch * 100), lang, 1)}% {T("vs", "vs")} {changeRef}</span>}
  </div>
  <footer>
    <span class="chip ok">{T("Verificado", "Verified")}</span>
    <span>{T("Fonte", "Source")}: {stat.footnote.source} (<a href={href(lang, `dados/#${stat.footnote.dataset}`)} class="mono">{stat.footnote.source_code}</a>) · {T("Ref.", "Ref.")}: {period} · {T("Publicado", "Published")}: {fmtDate(stat.footnote.published, lang)} · {T("Verificado", "Verified")}: {fmtDate(stat.footnote.verified, lang)}</span>
  </footer>
</article>
<style>
  .stat { display: flex; flex-direction: column; gap: 6px; }
  .value { font: 600 clamp(2.2rem, 5vw, 3.2rem)/1 var(--display); letter-spacing: -0.02em; font-feature-settings: "tnum"; }
  .big .value { font-size: clamp(3rem, 9vw, 5.6rem); }
  .unit { font: 400 1rem var(--sans); color: var(--muted); letter-spacing: 0; }
  .label { font-weight: 600; font-size: 1.05rem; }
  .context { color: var(--muted); font-size: .92rem; }
  .delta { margin-left: 8px; font-weight: 600; }
  .delta.up { color: var(--pasture); } .delta.down { color: var(--accent); }
  footer { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); font-size: .74rem; color: var(--muted); display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
</style>
