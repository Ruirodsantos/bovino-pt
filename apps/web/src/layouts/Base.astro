---
import "../styles/global.css";
import "../styles/proto.css";
import { BASE, href, htmlLang, switchTo, tr, type Lang } from "../i18n";
interface Props { title: string; description?: string; lang?: Lang; home?: boolean; overlay?: boolean; image?: string; noindex?: boolean }
const { title, lang = "pt", home = false, overlay = false, image, noindex = false } = Astro.props;
const T = tr(lang);
const description = Astro.props.description ?? T("Dados oficiais, raças autóctones e o comércio de bovinos entre Portugal e Espanha — atualizado todos os dias.", "Official data, native breeds and the cattle trade between Portugal and Spain — updated every day.");
const base = BASE;
const path = Astro.url.pathname;
const pre = href(lang);
const brand = T("Bovino Português", "Portuguese Cattle");
const nav: [string, string, string[]][] = [
  ["", T("Início", "Home"), []],
  ["racas/", T("As raças", "The breeds"), ["racas/"]],
  ["carne/", T("A carne", "The meat"), ["carne/"]],
  ["da-pastagem-ao-prato/", T("Da Terra à Mesa", "From Land to Table"), ["da-pastagem-ao-prato/"]],
  ["aprender/", T("Aprender", "Learn"), ["aprender/", "descobertas/", "metodologia/"]],
  ["observatorio/", T("Observatório", "Observatory"), ["observatorio/", "dados/"]],
];
const active = (p: string, g: string[]) => (p === "" ? path === pre : g.some((x) => path.startsWith(`${pre}${x}`)));
const fullTitle = home ? brand : `${title} · ${brand}`;
const other: Lang = lang === "en" ? "pt" : "en";
const alt = { pt: switchTo(Astro.url, lang, "pt"), en: switchTo(Astro.url, lang, "en") };
---
<!doctype html>
<html lang={htmlLang(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="alternate" hreflang="pt-PT" href={new URL(alt.pt, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(alt.pt, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <meta property="og:locale" content={lang === "en" ? "en_GB" : "pt_PT"} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body class="p" data-lang={lang}>
  <a class="sr-only" href="#main">{T("Saltar para o conteúdo", "Skip to content")}</a>
  <header class:list={["ph", !overlay && "solid"]} id="ph" data-hero={overlay}>
    <div class="wrap bar">
      <a class="brand" href={pre}>{brand}</a>
      <button class="burger" aria-expanded="false" aria-controls="nav">{T("MENU", "MENU")}</button>
      <nav id="nav" aria-label={T("Principal", "Main")}>
        {nav.map(([p, label, g]) => <a href={`${pre}${p}`} aria-current={active(p, g) ? "page" : undefined}>{label}</a>)}
        <a class="lang" href={alt[other]} hreflang={other === "en" ? "en" : "pt-PT"} lang={other === "en" ? "en" : "pt-PT"} aria-label={T("Read this page in English", "Ler esta página em português")}>{other === "en" ? "EN" : "PT"}</a>
      </nav>
    </div>
  </header>
  <main id="main" class:list={[!overlay && "pad"]}><slot /></main>
  <footer class="pf">
    <div class="wrap">
      <p><strong>{brand}</strong> — {T("projeto independente de dados abertos. Cada número indica a fonte, o período a que se refere e quando foi verificado. Nenhum valor é estimado ou inventado.", "an independent open-data project. Every number states its source, the period it refers to and when it was checked. No value is estimated or made up.")}</p>
      <p>{T("Dados", "Data")}: Eurostat, INE {T("e outras fontes oficiais (ver", "and other official sources (see")} <a href={`${pre}metodologia/`}>{T("método e fontes", "method and sources")}</a>). {T("Fronteiras", "Boundaries")}: © EuroGeographics. {T("Código e histórico de dados", "Code and data history")}: <a href="https://github.com/Ruirodsantos/bovino-pt">GitHub</a>.</p>
      <p>{T("Fotografias com autor, licença e origem indicados em cada imagem. Quando não há fotografia autorizada da raça, a imagem é identificada como paisagem e a lacuna é assinalada.", "Photographs credit author, licence and source. When no authorised photograph of the breed exists, the image is labelled as a landscape and the gap is flagged.")}</p>
    </div>
  </footer>
  <script>
    const ph = document.getElementById("ph")!;
    const isHero = ph.dataset.hero === "true";
    const upd = () => ph.classList.toggle("solid", !isHero || scrollY > window.innerHeight * 0.7);
    upd(); addEventListener("scroll", upd, { passive: true });
    const bt = ph.querySelector<HTMLButtonElement>(".burger")!;
    const label = bt.textContent;
    bt.addEventListener("click", () => { const o = ph.classList.toggle("menu-open"); bt.setAttribute("aria-expanded", String(o)); bt.textContent = o ? (document.documentElement.lang.startsWith("en") ? "CLOSE" : "FECHAR") : label; });
    ph.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => ph.classList.remove("menu-open")));
    addEventListener("keydown", (e) => { if (e.key === "Escape") ph.classList.remove("menu-open"); });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll(".reveal, .rv").forEach((el) => io.observe(el));
  </script>
</body>
</html>
