---
import "../styles/global.css";
import { BASE, href, htmlLang, switchTo, tr, type Lang } from "../i18n";
interface Props { title: string; description?: string; lang?: Lang; home?: boolean; overlay?: boolean; image?: string; }
const { title, lang = "pt", home = false, overlay = false, image } = Astro.props;
const T = tr(lang);
const description = Astro.props.description ?? T("Dados oficiais, raças autóctones e o comércio de bovinos entre Portugal e Espanha — atualizado todos os dias.", "Official data, native breeds and the cattle trade between Portugal and Spain — updated every day.");
const base = BASE;
const path = Astro.url.pathname;
const pre = href(lang);
const brand = T("Atlas do Bovino Português", "Portuguese Beef Atlas");
const nav: [string, string, string[]][] = [
  ["racas/", T("Raças", "Breeds"), ["racas/"]],
  ["carne/", T("Carne portuguesa", "Portuguese beef"), ["carne/"]],
  ["da-pastagem-ao-prato/", T("Da pastagem ao prato", "Pasture to plate"), ["da-pastagem-ao-prato/"]],
  ["aprender/", T("Aprender", "Learn"), ["aprender/", "dados/", "observatorio/", "descobertas/", "metodologia/"]],
];
const fullTitle = home ? brand : `${title} · ${brand}`;
const other: Lang = lang === "en" ? "pt" : "en";
const alt = { pt: switchTo(Astro.url, lang, "pt"), en: switchTo(Astro.url, lang, "en") };
---
<!doctype html>
<html lang={htmlLang(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="alternate" hreflang="pt-PT" href={new URL(alt.pt, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(alt.pt, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <meta property="og:locale" content={lang === "en" ? "en_GB" : "pt_PT"} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body data-lang={lang} class:list={[overlay && "ov"]}>
  <a class="sr-only" href="#main">{T("Saltar para o conteúdo", "Skip to content")}</a>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href={pre}>
        {lang === "en" ? <span>Portuguese <em>Beef</em> Atlas</span> : <span>Atlas do <em>Bovino</em> Português</span>}
      </a>
      <nav aria-label={T("Principal", "Main")}>
        {nav.map(([p, label, group]) => <a href={`${pre}${p}`} aria-current={group.some((g) => path.startsWith(`${pre}${g}`)) ? "page" : undefined}>{label}</a>)}
        <a class="lang" href={alt[other]} hreflang={other === "en" ? "en" : "pt-PT"} lang={other === "en" ? "en" : "pt-PT"} aria-label={T("Read this page in English", "Ler esta página em português")}>{other === "en" ? "EN" : "PT"}</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap">
      <p><strong>{brand}</strong> — {T("projeto independente de dados abertos. Cada número indica a fonte, o período a que se refere e quando foi verificado. Nenhum valor é estimado ou inventado.", "an independent open-data project. Every number states its source, the period it refers to and when it was checked. No value is estimated or made up.")}</p>
      <p class="muted">{T("Dados", "Data")}: Eurostat, INE {T("e outras fontes oficiais (ver", "and other official sources (see")} <a href={`${pre}metodologia/`}>{T("método e fontes", "method and sources")}</a>). {T("Fronteiras", "Boundaries")}: © EuroGeographics. {T("Código e histórico de dados", "Code and data history")}: <a href="https://github.com/Ruirodsantos/bovino-pt">GitHub</a>.</p>
    </div>
  </footer>
  <script>
    const hd = document.querySelector("header.site");
    const onScroll = () => hd?.classList.toggle("scrolled", window.scrollY > 40);
    onScroll(); addEventListener("scroll", onScroll, { passive: true });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -10% 0px" });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style>
  header.site { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font: 600 1.05rem var(--display); }
  .brand em { color: var(--accent); font-style: italic; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { color: var(--muted); text-decoration: none; font-size: .92rem; padding: 6px 10px; border-radius: 999px; }
  nav a:hover, nav a[aria-current] { color: var(--ink); background: var(--cork-soft); }
  body.ov header.site:not(.scrolled) { background: transparent; border-bottom-color: transparent; backdrop-filter: none; }
  body.ov header.site:not(.scrolled) .brand, body.ov header.site:not(.scrolled) nav a { color: #fff; text-shadow: 0 1px 12px rgba(0,0,0,.35); }
  body.ov header.site:not(.scrolled) .brand em { color: #f3c9a8; }
  body.ov header.site:not(.scrolled) nav a[aria-current], body.ov header.site:not(.scrolled) nav a:hover { background: rgba(255,255,255,.18); }
  header.site { transition: background .3s ease, border-color .3s ease; }
  nav a.lang { border: 1px solid var(--line); font-weight: 600; letter-spacing: .04em; margin-left: 6px; }
  footer.site { border-top: 1px solid var(--line); padding: 40px 0 60px; font-size: .9rem; }
  .muted { color: var(--muted); }
  @media (max-width: 640px) { nav { width: 100%; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 8px; } nav a { white-space: nowrap; } }
</style>
