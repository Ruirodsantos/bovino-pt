---
import "../styles/global.css";
interface Props { title: string; description?: string; }
const { title, description = "Dados oficiais, raças autóctones e o comércio de bovinos entre Portugal e Espanha — atualizado todos os dias." } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  ["racas/", "Raças"], ["observatorio/", "Portugal ↔ Espanha"], ["descobertas/", "Descobertas"], ["dados/", "Dados"], ["metodologia/", "Método"],
];
const fullTitle = title === "Início" ? "Atlas do Bovino Português" : `${title} · Atlas do Bovino Português`;
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <a class="sr-only" href="#main">Saltar para o conteúdo</a>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href={base}>
        <svg viewBox="0 0 40 24" width="34" height="20" aria-hidden="true"><path d="M2 6c6 0 9 2 12 6M38 6c-6 0-9 2-12 6M14 12c0-3 3-5 6-5s6 2 6 5v5c0 3-3 5-6 5s-6-2-6-5z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span>Atlas do <em>Bovino</em> Português</span>
      </a>
      <nav aria-label="Principal">
        {nav.map(([href, label]) => <a href={`${base}${href}`} aria-current={path.startsWith(`${base}${href}`) ? "page" : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap">
      <p><strong>Atlas do Bovino Português</strong> — projeto independente de dados abertos. Cada número indica a fonte, o período a que se refere e quando foi verificado. Nenhum valor é estimado ou inventado.</p>
      <p class="muted">Dados: Eurostat, INE e outras fontes oficiais (ver <a href={`${base}metodologia/`}>método e fontes</a>). Fronteiras: © EuroGeographics. Código e histórico de dados: <a href="https://github.com/Ruirodsantos/bovino-pt">GitHub</a>.</p>
    </div>
  </footer>
  <script>
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -10% 0px" });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style>
  header.site { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font: 600 1.05rem var(--display); }
  .brand em { color: var(--accent); font-style: italic; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { color: var(--muted); text-decoration: none; font-size: .92rem; padding: 6px 10px; border-radius: 999px; }
  nav a:hover, nav a[aria-current] { color: var(--ink); background: var(--cork-soft); }
  footer.site { border-top: 1px solid var(--line); padding: 40px 0 60px; font-size: .9rem; }
  .muted { color: var(--muted); }
  @media (max-width: 640px) { nav { width: 100%; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 8px; } nav a { white-space: nowrap; } }
</style>
