{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Observation — one published statistic",
  "type": "object",
  "required": ["dataset_id", "species", "geo", "flow", "period", "period_type", "value", "unit", "source_id", "source_url", "retrieved_at", "status"],
  "properties": {
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "species": {"enum": ["bovine"]},
    "geo": {"type": "string"},
    "partner_geo": {"type": ["string", "null"]},
    "flow": {"enum": ["export", "import", "production", "stock", "slaughter", "price", "index"]},
    "product_code": {"type": ["string", "null"]},
    "period": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}|-W[0-9]{2}|-Q[1-4])?$"},
    "period_type": {"enum": ["year", "quarter", "month", "week"]},
    "value": {"type": "number"},
    "unit": {"enum": ["head", "tonne", "kg", "eur", "eur_per_kg_carcass", "eur_per_kg_live", "eur_per_head", "index"]},
    "unit_multiplier": {"type": "integer", "default": 1},
    "source_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "source_url": {"type": "string", "format": "uri"},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["green", "yellow", "red"]},
    "status_reason": {"type": ["string", "null"]},
    "revision_of": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["yellow", "red"]}}},
     "then": {"required": ["status_reason"], "properties": {"status_reason": {"type": "string", "minLength": 3}}}}
  ],
  "additionalProperties": false
}
